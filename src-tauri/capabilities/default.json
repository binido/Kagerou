{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main Kagerou window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "autostart:default",
    "clipboard-manager:allow-read-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/binido/Kagerou" },
        { "url": "https://github.com/binido/Kagerou/*" }
      ]
    }
  ]
}
