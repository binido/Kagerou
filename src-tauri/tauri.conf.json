{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kagerou",
  "version": "0.7.0",
  "identifier": "com.binido.kagerou",
  "build": {
    "beforeDevCommand": "node scripts/fetch-singbox.mjs && pnpm --dir app dev",
    "beforeBuildCommand": "node scripts/fetch-singbox.mjs && pnpm --dir app build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kagerou",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "targets": [
      "dmg",
      "deb",
      "rpm",
      "appimage",
      "msi",
      "nsis"
    ],
    "externalBin": ["binaries/sing-box"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFNURBODlFNkFEQ0Q0QUYKUldTdjFOeHFucWhkL3NsMEZWWTZtcU9YaTdoSFhpWG5GOGZ5aVFZU3k1aFcvNFV5N0hLUnROdFQK",
      "endpoints": [
        "https://github.com/binido/Kagerou/releases/latest/download/latest.json"
      ]
    }
  }
}
