{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kagerou",
  "version": "0.0.0",
  "identifier": "com.binido.kagerou",
  "build": {
    "beforeDevCommand": "pnpm --dir app dev",
    "beforeBuildCommand": "pnpm --dir app build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kagerou",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
