      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .lunar-shell {\n    --canvas: #1A1B1E;\n    --sidebar: #17181B;\n    --surface: #222329;\n    --raised: #292A31;\n    --selected: #312E3B;\n    --lavender: #AA9BD7;\n    --lavender-hi: #C3B7E6;\n    --ink: #19171F;\n    --primary: #F2F0F6;\n    --body: #C8C5D0;\n    --meta: #918D99;\n    --good: #70B68E;\n    --moderate: #D1AA64;\n    --poor: #CF747B;\n  }\n\n  .font-inter { font-family: 'Inter', sans-serif; }\n  .font-tight { font-family: 'Inter Tight', sans-serif; }\n  .lunar-modal[hidden] { display: none; }\n</style>\n<div class=\"lunar-shell min-h-screen w-full overflow-x-clip bg-[var(--canvas)] font-inter text-[var(--primary)] antialiased\" data-kid=\"1\" data-name=\"page layout shell\">\n    <div class=\"flex min-h-screen w-full\" data-kid=\"1-1\" data-name=\"sidebar and content flex container\">\n        <aside aria-label=\"Primary navigation\" class=\"flex w-[216px] shrink-0 flex-col bg-[var(--sidebar)] px-3 py-5\" data-kid=\"1-1-1\" data-name=\"primary navigation sidebar\">\n            <div class=\"mb-8 flex items-center gap-3 px-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo container\">\n                <div aria-hidden=\"true\" class=\"relative h-8 w-8 shrink-0\" data-kid=\"1-1-1-1-1\" data-name=\"brand icon decoration container\">\n                    <span class=\"absolute left-0 top-0 h-8 w-8 rounded-full bg-[var(--lavender)]\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand logo circle left\">\n                    </span>\n                    <span class=\"absolute right-[-1px] top-0 h-8 w-8 rounded-full bg-[var(--sidebar)]\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand logo circle right\">\n                    </span>\n                </div>\n                <span class=\"font-tight text-[19px] font-semibold tracking-[-0.02em] text-[var(--primary)]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    Kagerou\n                </span>\n            </div>\n            <div class=\"px-3 pb-2 text-[10px] font-semibold uppercase tracking-[0.16em] text-[var(--meta)]\" data-kid=\"1-1-1-2\" data-name=\"workspace section label\">\n                Workspace\n            </div>\n            <nav aria-label=\"Workspace\" class=\"space-y-1\" data-kid=\"1-1-1-3\" data-name=\"workspace navigation links list\">\n                <a class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-sm text-[var(--body)] hover:bg-[#232429] focus-visible:outline-2 focus-visible:outline-[var(--lavender)] focus-visible:outline-offset-2\" data-kid=\"1-1-1-3-1\" data-name=\"dashboard navigation link\" href=\"#\">\n                    <span class=\"flex w-5 justify-center text-[18px] leading-none\" data-kid=\"1-1-1-3-1-1\" data-name=\"dashboard icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard\" data-kid=\"1-1-1-3-1-1-1\" data-name=\"dashboard icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-1-1-3-1-2\" data-name=\"dashboard link text\">\n                        Dashboard\n                    </span>\n                </a>\n                <a class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-sm text-[var(--body)] hover:bg-[#232429] focus-visible:outline-2 focus-visible:outline-[var(--lavender)] focus-visible:outline-offset-2\" data-kid=\"1-1-1-3-2\" data-name=\"profiles navigation link\" href=\"#\">\n                    <span class=\"flex w-5 justify-center text-[18px] leading-none\" data-kid=\"1-1-1-3-2-1\" data-name=\"profiles icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-server\" data-kid=\"1-1-1-3-2-1-1\" data-name=\"profiles icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-1-1-3-2-2\" data-name=\"profiles link text\">\n                        Profiles\n                    </span>\n                </a>\n                <a aria-current=\"page\" class=\"flex h-10 items-center gap-3 rounded-lg bg-[var(--selected)] px-3 text-sm font-medium text-[var(--primary)] hover:bg-[#373342] focus-visible:outline-2 focus-visible:outline-[var(--lavender)] focus-visible:outline-offset-2\" data-kid=\"1-1-1-3-3\" data-name=\"subscriptions navigation link\" href=\"#\">\n                    <span class=\"flex w-5 justify-center text-[18px] leading-none text-[var(--lavender-hi)]\" data-kid=\"1-1-1-3-3-1\" data-name=\"subscriptions icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-rss\" data-kid=\"1-1-1-3-3-1-1\" data-name=\"subscriptions icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-1-1-3-3-2\" data-name=\"subscriptions link text\">\n                        Subscriptions\n                    </span>\n                </a>\n                <a class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-sm text-[var(--body)] hover:bg-[#232429] focus-visible:outline-2 focus-visible:outline-[var(--lavender)] focus-visible:outline-offset-2\" data-kid=\"1-1-1-3-4\" data-name=\"routing rules navigation link\" href=\"#\">\n                    <span class=\"flex w-5 justify-center text-[18px] leading-none\" data-kid=\"1-1-1-3-4-1\" data-name=\"routing rules icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-route\" data-kid=\"1-1-1-3-4-1-1\" data-name=\"routing rules icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-1-1-3-4-2\" data-name=\"routing rules link text\">\n                        Routing rules\n                    </span>\n                </a>\n                <a class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-sm text-[var(--body)] hover:bg-[#232429] focus-visible:outline-2 focus-visible:outline-[var(--lavender)] focus-visible:outline-offset-2\" data-kid=\"1-1-1-3-5\" data-name=\"logs navigation link\" href=\"#\">\n                    <span class=\"flex w-5 justify-center text-[18px] leading-none\" data-kid=\"1-1-1-3-5-1\" data-name=\"logs icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-scroll-text\" data-kid=\"1-1-1-3-5-1-1\" data-name=\"logs icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-1-1-3-5-2\" data-name=\"logs link text\">\n                        Logs\n                    </span>\n                </a>\n                <a class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-sm text-[var(--body)] hover:bg-[#232429] focus-visible:outline-2 focus-visible:outline-[var(--lavender)] focus-visible:outline-offset-2\" data-kid=\"1-1-1-3-6\" data-name=\"settings navigation link\" href=\"#\">\n                    <span class=\"flex w-5 justify-center text-[18px] leading-none\" data-kid=\"1-1-1-3-6-1\" data-name=\"settings icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-settings\" data-kid=\"1-1-1-3-6-1-1\" data-name=\"settings icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-1-1-3-6-2\" data-name=\"settings link text\">\n                        Settings\n                    </span>\n                </a>\n            </nav>\n            <div class=\"mt-auto border-t border-white/[0.05] pt-4\" data-kid=\"1-1-1-4\" data-name=\"sidebar footer action container\">\n                <button class=\"flex h-10 w-full items-center gap-3 rounded-lg px-3 text-sm text-[var(--meta)] hover:bg-[#232429] hover:text-[var(--body)] focus-visible:outline-2 focus-visible:outline-[var(--lavender)] focus-visible:outline-offset-2\" data-kid=\"1-1-1-4-1\" data-name=\"sidebar collapse button\" type=\"button\">\n                    <span class=\"flex w-5 justify-center text-[18px] leading-none\" data-kid=\"1-1-1-4-1-1\" data-name=\"collapse icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-layout-sidebar-left-collapse\" data-kid=\"1-1-1-4-1-1-1\" data-name=\"collapse icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-1-1-4-1-2\" data-name=\"collapse button text\">\n                        Collapse\n                    </span>\n                </button>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1 bg-[var(--canvas)]\" data-kid=\"1-1-2\" data-name=\"main content area\">\n            <div class=\"mx-auto max-w-[960px] px-12 pb-14 pt-10\" data-kid=\"1-1-2-1\" data-name=\"page content wrapper\">\n                <header class=\"flex items-start justify-between gap-8\" data-kid=\"1-1-2-1-1\" data-name=\"page header container\">\n                    <div data-kid=\"1-1-2-1-1-1\" data-name=\"header text container\">\n                        <h1 class=\"font-tight text-[32px] font-semibold leading-none tracking-[-0.035em] text-[var(--primary)]\" data-kid=\"1-1-2-1-1-1-1\" data-name=\"page title heading\">\n                            Subscriptions\n                        </h1>\n                        <p class=\"mt-3 text-sm text-[var(--meta)]\" data-kid=\"1-1-2-1-1-1-2\" data-name=\"page description text\">\n                            Manage profile sources and the servers they provide.\n                        </p>\n                    </div>\n                    <button class=\"mt-1 inline-flex h-10 shrink-0 items-center gap-2 rounded-lg bg-[var(--lavender)] px-4 text-sm font-semibold text-[var(--ink)] shadow-[0_8px_20px_rgba(0,0,0,.12)] hover:bg-[var(--lavender-hi)] focus-visible:outline-2 focus-visible:outline-[var(--lavender-hi)] focus-visible:outline-offset-2\" data-kid=\"1-1-2-1-1-2\" data-name=\"add subscription trigger button\" data-open-modal=\"\" type=\"button\">\n                        <span class=\"text-[17px] leading-none\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"add button icon container\">\n                            <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-1-2-1-1-2-1-1\" data-name=\"plus icon\">\n                            </i>\n                        </span>\n                        <span data-kid=\"1-1-2-1-1-2-2\" data-name=\"add button label text\">\n                            Add subscription\n                        </span>\n                    </button>\n                </header>\n                <div class=\"mt-9 space-y-3\" data-kid=\"1-1-2-1-2\" data-name=\"subscription groups list container\">\n                    <section aria-labelledby=\"personal-group-title\" class=\"overflow-hidden rounded-[10px] bg-[var(--surface)]\" data-kid=\"1-1-2-1-2-1\" data-name=\"personal subscription group section\">\n                        <div class=\"flex min-h-[72px] items-center justify-between gap-4 px-5\" data-kid=\"1-1-2-1-2-1-1\" data-name=\"group header and action bar\">\n                            <button aria-controls=\"personal-profiles\" aria-expanded=\"true\" class=\"flex min-w-0 flex-1 items-center gap-3 rounded-lg py-2 text-left hover:text-[var(--lavender-hi)] focus-visible:outline-2 focus-visible:outline-[var(--lavender)] focus-visible:outline-offset-2\" data-disclosure=\"personal-profiles\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-1-1-1\" data-name=\"group toggle button\" data-reason=\"aria-expanded attribute updated by script\" type=\"button\">\n                                <span class=\"flex w-5 shrink-0 justify-center text-[19px] leading-none text-[var(--body)]\" data-kid=\"1-1-2-1-2-1-1-1-1\" data-name=\"group toggle chevron container\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-chevron-down\" data-chevron=\"\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-1-1-1-1-1\" data-name=\"chevron icon\" data-reason=\"icon class toggled by script\">\n                                    </i>\n                                </span>\n                                <span class=\"min-w-0\" data-kid=\"1-1-2-1-2-1-1-1-2\" data-name=\"group information wrapper\">\n                                    <span class=\"block truncate font-tight text-[17px] font-semibold tracking-[-0.015em] text-[var(--primary)]\" data-kid=\"1-1-2-1-2-1-1-1-2-1\" data-name=\"group title\" id=\"personal-group-title\">\n                                        Personal / North America\n                                    </span>\n                                    <span class=\"mt-1 block text-xs text-[var(--meta)]\" data-kid=\"1-1-2-1-2-1-1-1-2-2\" data-name=\"group profile count text\">\n                                        4 profiles\n                                    </span>\n                                </span>\n                            </button>\n                            <button class=\"inline-flex h-9 shrink-0 items-center gap-1.5 rounded-lg px-3 text-xs font-medium text-[var(--body)] hover:bg-[var(--raised)] hover:text-[var(--primary)] focus-visible:outline-2 focus-visible:outline-[var(--lavender)] focus-visible:outline-offset-2\" data-kid=\"1-1-2-1-2-1-1-2\" data-name=\"test all button\" data-test-all=\"\" type=\"button\">\n                                <span data-kid=\"1-1-2-1-2-1-1-2-1\" data-name=\"test all button text\">\n                                    Test all\n                                </span>\n                                <span class=\"text-[14px] leading-none\" data-kid=\"1-1-2-1-2-1-1-2-2\" data-name=\"test all icon container\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-player-play\" data-kid=\"1-1-2-1-2-1-1-2-2-1\" data-name=\"play icon\">\n                                    </i>\n                                </span>\n                            </button>\n                        </div>\n                        <div aria-labelledby=\"personal-group-title\" class=\"border-t border-white/[0.06]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-1-2\" data-name=\"personal profiles list\" data-reason=\"hidden attribute toggled by script\" id=\"personal-profiles\" role=\"region\">\n                            <div class=\"grid grid-cols-[minmax(0,1fr)_148px_112px_88px] items-center bg-[var(--surface)] px-5 py-2.5 text-[10px] font-semibold uppercase tracking-[0.15em] text-[var(--meta)]\" data-kid=\"1-1-2-1-2-1-2-1\" data-name=\"profile table header\">\n                                <span data-kid=\"1-1-2-1-2-1-2-1-1\" data-name=\"server column label\">\n                                    Server\n                                </span>\n                                <span data-kid=\"1-1-2-1-2-1-2-1-2\" data-name=\"protocol column label\">\n                                    Protocol\n                                </span>\n                                <span data-kid=\"1-1-2-1-2-1-2-1-3\" data-name=\"ping column label\">\n                                    Ping\n                                </span>\n                                <span class=\"text-right\" data-kid=\"1-1-2-1-2-1-2-1-4\" data-name=\"action column label\">\n                                    Action\n                                </span>\n                            </div>\n                            <div class=\"grid min-h-[62px] grid-cols-[minmax(0,1fr)_148px_112px_88px] items-center border-t border-white/[0.05] bg-[var(--selected)] px-5 hover:bg-[#373342]\" data-kid=\"1-1-2-1-2-1-2-2\" data-name=\"first profile row\" data-profile-row=\"\">\n                                <div class=\"min-w-0\" data-kid=\"1-1-2-1-2-1-2-2-1\" data-name=\"profile name and region info\">\n                                    <p class=\"truncate text-sm font-medium text-[var(--primary)]\" data-kid=\"1-1-2-1-2-1-2-2-1-1\" data-name=\"profile name text\">\n                                        New York · 01\n                                    </p>\n                                    <p class=\"mt-1 truncate text-xs text-[var(--meta)]\" data-kid=\"1-1-2-1-2-1-2-2-1-2\" data-name=\"profile region text\">\n                                        us-east-1\n                                    </p>\n                                </div>\n                                <span class=\"w-fit rounded-[6px] bg-[var(--raised)] px-2 py-1 text-[11px] font-medium text-[var(--body)]\" data-kid=\"1-1-2-1-2-1-2-2-2\" data-name=\"protocol badge\">\n                                    VLESS\n                                </span>\n                                <span class=\"flex items-center gap-2 text-xs tabular-nums text-[var(--body)]\" data-kid=\"1-1-2-1-2-1-2-2-3\" data-name=\"ping indicator container\">\n                                    <span class=\"h-2 w-2 rounded-full bg-[var(--good)]\" data-kid=\"1-1-2-1-2-1-2-2-3-1\" data-name=\"ping status dot\">\n                                    </span>\n                                    42 ms\n                                </span>\n                                <button aria-pressed=\"true\" class=\"justify-self-end rounded-lg px-2.5 py-1.5 text-xs font-medium text-[var(--lavender-hi)] hover:bg-white/[0.06] focus-visible:outline-2 focus-visible:outline-[var(--lavender)] focus-visible:outline-offset-2\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-1-2-2-4\" data-name=\"profile select toggle button\" data-reason=\"aria-pressed, button state, icon rendering and classes updated by script\" data-select=\"\" type=\"button\">\n                                    <span data-action-label=\"\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-1-2-2-4-1\" data-name=\"action label text\" data-reason=\"text content updated by script\">\n                                        Selected\n                                    </span>\n                                    <span class=\"ml-1 text-[14px] leading-none\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-1-2-2-4-2\" data-name=\"checkmark icon container\" data-reason=\"injected/removed by script\">\n                                        <i aria-hidden=\"true\" class=\"ti ti-check\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-1-2-2-4-2-1\" data-name=\"checkmark icon\" data-reason=\"injected/removed by script\">\n                                        </i>\n                                    </span>\n                                </button>\n                            </div>\n                            <div class=\"grid min-h-[62px] grid-cols-[minmax(0,1fr)_148px_112px_88px] items-center border-t border-white/[0.05] bg-[var(--surface)] px-5 hover:bg-[var(--raised)]\" data-kid=\"1-1-2-1-2-1-2-3\" data-name=\"second profile row\" data-profile-row=\"\">\n                                <div class=\"min-w-0\" data-kid=\"1-1-2-1-2-1-2-3-1\" data-name=\"profile name and region info\">\n                                    <p class=\"truncate text-sm font-medium text-[var(--primary)]\" data-kid=\"1-1-2-1-2-1-2-3-1-1\" data-name=\"profile name text\">\n                                        Toronto · 02\n                                    </p>\n                                    <p class=\"mt-1 truncate text-xs text-[var(--meta)]\" data-kid=\"1-1-2-1-2-1-2-3-1-2\" data-name=\"profile region text\">\n                                        ca-central-1\n                                    </p>\n                                </div>\n                                <span class=\"w-fit rounded-[6px] bg-[var(--raised)] px-2 py-1 text-[11px] font-medium text-[var(--body)]\" data-kid=\"1-1-2-1-2-1-2-3-2\" data-name=\"protocol badge\">\n                                    Trojan\n                                </span>\n                                <span class=\"flex items-center gap-2 text-xs tabular-nums text-[var(--body)]\" data-kid=\"1-1-2-1-2-1-2-3-3\" data-name=\"ping indicator container\">\n                                    <span class=\"h-2 w-2 rounded-full bg-[var(--moderate)]\" data-kid=\"1-1-2-1-2-1-2-3-3-1\" data-name=\"ping status dot\">\n                                    </span>\n                                    86 ms\n                                </span>\n                                <button aria-pressed=\"false\" class=\"justify-self-end rounded-lg px-2.5 py-1.5 text-xs font-medium text-[var(--body)] hover:bg-white/[0.06] hover:text-[var(--primary)] focus-visible:outline-2 focus-visible:outline-[var(--lavender)] focus-visible:outline-offset-2\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-1-2-3-4\" data-name=\"profile select toggle button\" data-reason=\"aria-pressed, button state, icon rendering and classes updated by script\" data-select=\"\" type=\"button\">\n                                    <span data-action-label=\"\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-1-2-3-4-1\" data-name=\"action label text\" data-reason=\"text content updated by script\">\n                                        Select\n                                    </span>\n                                </button>\n                            </div>\n                            <div class=\"grid min-h-[62px] grid-cols-[minmax(0,1fr)_148px_112px_88px] items-center border-t border-white/[0.05] bg-[var(--surface)] px-5 hover:bg-[var(--raised)]\" data-kid=\"1-1-2-1-2-1-2-4\" data-name=\"third profile row\" data-profile-row=\"\">\n                                <div class=\"min-w-0\" data-kid=\"1-1-2-1-2-1-2-4-1\" data-name=\"profile name and region info\">\n                                    <p class=\"truncate text-sm font-medium text-[var(--primary)]\" data-kid=\"1-1-2-1-2-1-2-4-1-1\" data-name=\"profile name text\">\n                                        Chicago · 03\n                                    </p>\n                                    <p class=\"mt-1 truncate text-xs text-[var(--meta)]\" data-kid=\"1-1-2-1-2-1-2-4-1-2\" data-name=\"profile region text\">\n                                        us-central-1\n                                    </p>\n                                </div>\n                                <span cl