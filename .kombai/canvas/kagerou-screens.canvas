ems-start justify-between gap-6\" data-kid=\"1-4-1-1\">\n                <div data-kid=\"1-4-1-1-1\">\n                    <p class=\"text-[10px] font-medium uppercase tracking-[0.16em] text-[var(--muted)]\" data-kid=\"1-4-1-1-1-1\">\n                        Profile source\n                    </p>\n                    <h2 class=\"font-display mt-2 text-[24px] font-semibold leading-tight tracking-[-0.025em] text-[var(--primary)]\" data-kid=\"1-4-1-1-1-2\" id=\"source-modal-title\">\n                        Add source\n                    </h2>\n                </div>\n                <button aria-label=\"Close source dialog\" class=\"modal-close flex h-11 w-11 shrink-0 items-center justify-center rounded-[8px] text-[20px] text-[var(--muted)] hover:bg-[var(--row-hover)] hover:text-[var(--primary)]\" data-close-source-modal=\"\" data-kid=\"1-4-1-1-2\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-x\" data-kid=\"1-4-1-1-2-1\">\n                    </i>\n                </button>\n            </div>\n            <div aria-label=\"Source type\" class=\"mt-6 grid grid-cols-2 gap-2 rounded-[9px] bg-[var(--canvas)] p-1\" data-kid=\"1-4-1-2\" role=\"group\">\n                <button aria-pressed=\"true\" class=\"type-option type-option-url modal-control flex h-10 items-center justify-center gap-2 rounded-[7px] px-3 text-[12px] font-medium text-[var(--body-copy)] is-selected\" data-kid=\"1-4-1-2-1\" data-modal-kind=\"url\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-rss text-[15px]\" data-kid=\"1-4-1-2-1-1\">\n                    </i>\n                    Subscription URL\n                </button>\n                <button aria-pressed=\"false\" class=\"type-option type-option-key modal-control flex h-10 items-center justify-center gap-2 rounded-[7px] px-3 text-[12px] font-medium text-[var(--body-copy)]\" data-kid=\"1-4-1-2-2\" data-modal-kind=\"key\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-key text-[15px]\" data-kid=\"1-4-1-2-2-1\">\n                    </i>\n                    Single key\n                </button>\n            </div>\n            <form class=\"mt-6\" data-kid=\"1-4-1-3\" id=\"source-form\">\n                <div data-field-panel=\"url\" data-kid=\"1-4-1-3-1\">\n                    <label class=\"mb-2 block text-[13px] font-medium text-[var(--primary)]\" data-kid=\"1-4-1-3-1-1\" for=\"source-url\">\n                        Source URL\n                    </label>\n                    <input aria-describedby=\"source-helper\" autocomplete=\"url\" class=\"source-field h-11 w-full rounded-[8px] border border-white/[0.10] bg-[var(--surface)] px-3.5 text-[13px] text-[var(--body-copy)] outline-hidden placeholder:text-[var(--muted)] focus:border-[var(--lavender-hi)] focus:ring-2 focus:ring-[var(--lavender)]/30\" data-kid=\"1-4-1-3-1-2\" id=\"source-url\" placeholder=\"https://example.com/profiles\" type=\"url\"/>\n                    <p class=\"mt-2 flex items-center gap-1.5 text-[11px] leading-4 text-[var(--muted)]\" data-kid=\"1-4-1-3-1-3\" id=\"source-helper\">\n                        <i aria-hidden=\"true\" class=\"ti ti-info-circle text-[14px]\" data-kid=\"1-4-1-3-1-3-1\">\n                        </i>\n                        Imports profiles into a group and can be refreshed later.\n                    </p>\n                </div>\n                <div data-field-panel=\"key\" data-kid=\"1-4-1-3-2\" hidden=\"\">\n                    <label class=\"mb-2 block text-[13px] font-medium text-[var(--primary)]\" data-kid=\"1-4-1-3-2-1\" for=\"profile-key\">\n                        Profile key\n                    </label>\n                    <input aria-describedby=\"key-helper\" autocomplete=\"off\" class=\"source-field h-11 w-full rounded-[8px] border border-white/[0.10] bg-[var(--surface)] px-3.5 font-data text-[12px] text-[var(--body-copy)] outline-hidden placeholder:font-['Inter'] placeholder:text-[var(--muted)] focus:border-[var(--lavender-hi)] focus:ring-2 focus:ring-[var(--lavender)]/30\" data-kid=\"1-4-1-3-2-2\" id=\"profile-key\" placeholder=\"vless://your-key\" type=\"text\"/>\n                    <p class=\"mt-2 flex items-center gap-1.5 text-[11px] leading-4 text-[var(--muted)]\" data-kid=\"1-4-1-3-2-3\" id=\"key-helper\">\n                        <i aria-hidden=\"true\" class=\"ti ti-info-circle text-[14px]\" data-kid=\"1-4-1-3-2-3-1\">\n                        </i>\n                        Creates one profile. The key stays managed locally.\n                    </p>\n                </div>\n                <p aria-live=\"polite\" class=\"mt-2 min-h-[16px] text-[11px] text-[var(--bad)]\" data-dynamic=\"true\" data-kid=\"1-4-1-3-3\" data-name=\"source input error message\" data-reason=\"text updated by script validation\" id=\"source-error\">\n                </p>\n                <div class=\"mt-6 flex items-center justify-end gap-2\" data-kid=\"1-4-1-3-4\">\n                    <button class=\"dialog-action rounded-[8px] px-4 py-2.5 text-[13px] font-medium text-[var(--body-copy)] hover:bg-[var(--row-hover)] hover:text-[var(--primary)]\" data-close-source-modal=\"\" data-kid=\"1-4-1-3-4-1\" type=\"button\">\n                        Cancel\n                    </button>\n                    <button class=\"primary-action dialog-action rounded-[8px] bg-[var(--lavender)] px-4 py-2.5 text-[13px] font-semibold text-[var(--ink)]\" data-kid=\"1-4-1-3-4-2\" id=\"source-submit\" type=\"submit\">\n                        Add source\n                    </button>\n                </div>\n            </form>\n        </div>\n    </div>\n    <div aria-hidden=\"true\" aria-labelledby=\"remove-modal-title\" class=\"modal-layer fixed inset-0 flex items-center justify-center px-4 py-8\" data-dynamic=\"true\" data-kid=\"1-5\" data-name=\"remove source modal overlay\" data-reason=\"visibility toggled by script\" hidden=\"\" id=\"remove-modal\" role=\"dialog\">\n        <div class=\"modal-card w-[440px] max-w-full rounded-[12px] border border-[var(--hairline)] bg-[var(--raised)] p-6\" data-kid=\"1-5-1\" role=\"document\">\n            <div class=\"flex items-start justify-between gap-6\" data-kid=\"1-5-1-1\">\n                <div data-kid=\"1-5-1-1-1\">\n                    <p class=\"text-[10px] font-medium uppercase tracking-[0.16em] text-[var(--bad)]\" data-kid=\"1-5-1-1-1-1\">\n                        Remove source\n                    </p>\n                    <h2 class=\"font-display mt-2 text-[23px] font-semibold leading-tight tracking-[-0.025em] text-[var(--primary)]\" data-kid=\"1-5-1-1-1-2\" id=\"remove-modal-title\">\n                        Remove this source?\n                    </h2>\n                </div>\n                <button aria-label=\"Close remove source dialog\" class=\"modal-close flex h-11 w-11 shrink-0 items-center justify-center rounded-[8px] text-[20px] text-[var(--muted)] hover:bg-[var(--row-hover)] hover:text-[var(--primary)]\" data-close-remove-modal=\"\" data-kid=\"1-5-1-1-2\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-x\" data-kid=\"1-5-1-1-2-1\">\n                    </i>\n                </button>\n            </div>\n            <p class=\"mt-4 text-[13px] leading-5 text-[var(--body-copy)]\" data-kid=\"1-5-1-2\">\n                The source will stop refreshing. Existing derived profiles stay available on\n                <span class=\"font-medium text-[var(--primary)]\" data-kid=\"1-5-1-2-1\">\n                    Profiles\n                </span>\n                , but they will no longer receive updates from this source.\n            </p>\n            <p class=\"mt-3 rounded-[8px] bg-[var(--canvas)] px-3 py-2.5 font-data text-[11px] text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"1-5-1-3\" data-name=\"source name to remove text\" data-reason=\"text updated based on selected source card by script\" id=\"remove-source-name\">\n                Personal / North America\n            </p>\n            <div class=\"mt-6 flex items-center justify-end gap-2\" data-kid=\"1-5-1-4\">\n                <button class=\"dialog-action rounded-[8px] px-4 py-2.5 text-[13px] font-medium text-[var(--body-copy)] hover:bg-[var(--row-hover)] hover:text-[var(--primary)]\" data-close-remove-modal=\"\" data-kid=\"1-5-1-4-1\" type=\"button\">\n                    Keep source\n                </button>\n                <button class=\"dialog-action rounded-[8px] bg-[var(--bad)] px-4 py-2.5 text-[13px] font-semibold text-[#21171A] hover:brightness-110\" data-kid=\"1-5-1-4-2\" id=\"confirm-remove-source\" type=\"button\">\n                    Remove source\n                </button>\n            </div>\n        </div>\n    </div>\n</div>\n<script>\n    (() => {\n    const app = document.getElementById('sources-app');\n    const addTrigger = document.getElementById('add-source-trigger');\n    const addMenu = document.getElementById('add-source-menu');\n    const addChevron = addTrigger.querySelector('.add-menu-chevron');\n    const sourceModal = document.getElementById('source-modal');\n    const removeModal = document.getElementById('remove-modal');\n    const sourceForm = document.getElementById('source-form');\n    const sourceError = document.getElementById('source-error');\n    const modalTitle = document.getElementById('source-modal-title');\n    const sourceSubmit = document.getElementById('source-submit');\n    const sourceUrl = document.getElementById('source-url');\n    const profileKey = document.getElementById('profile-key');\n    const toast = document.getElementById('source-toast');\n    const toastMessage = toast.querySelector('[data-toast-message]');\n    const toastIcon = toast.querySelector('.toast-icon i');\n    const sourceCount = document.getElementById('source-count');\n    const profileCount = document.getElementById('profile-count');\n    let modalKind = 'url';\n    let editingCard = null;\n    let removingCard = null;\n    let toastTimer = null;\n\n    const setAddMenu = (open) => {\n      addMenu.hidden = !open;\n      addTrigger.setAttribute('aria-expanded', String(open));\n      addChevron.classList.toggle('ti-chevron-up', open);\n      addChevron.classList.toggle('ti-chevron-down', !open);\n    };\n\n    const setModalType = (kind) => {\n      modalKind = kind;\n      document.querySelectorAll('[data-modal-kind]').forEach((option) => {\n        const selected = option.dataset.modalKind === kind;\n        option.classList.toggle('is-selected', selected);\n        option.setAttribute('aria-pressed', String(selected));\n      });\n      document.querySelectorAll('[data-field-panel]').forEach((panel) => { panel.hidden = panel.dataset.fieldPanel !== kind; });\n      sourceError.textContent = '';\n      if (kind === 'url') window.requestAnimationFrame(() => sourceUrl.focus());\n      else window.requestAnimationFrame(() => profileKey.focus());\n    };\n\n    const setModal = (open, kind = 'url', card = null) => {\n      editingCard = card;\n      sourceModal.hidden = !open;\n      sourceModal.setAttribute('aria-hidden', String(!open));\n      if (!open) { editingCard = null; return; }\n      modalTitle.textContent = card ? 'Edit source' : 'Add source';\n      sourceSubmit.textContent = card ? 'Save changes' : 'Add source';\n      if (card) {\n        const value = card.querySelector('.source-value').textContent.trim();\n        if (kind === 'url') sourceUrl.value = value;\n        else profileKey.value = value.replace('••••••••••••••••', '');\n      } else { sourceUrl.value = ''; profileKey.value = ''; }\n      setModalType(kind);\n    };\n\n    const setRemoveModal = (open, card = null) => {\n      removingCard = card;\n      removeModal.hidden = !open;\n      removeModal.setAttribute('aria-hidden', String(!open));\n      if (open && card) {\n        document.getElementById('remove-source-name').textContent = card.querySelector('h2').textContent.trim();\n        window.requestAnimationFrame(() => document.getElementById('confirm-remove-source').focus());\n      }\n    };\n\n    const showToast = (message, state = 'loading') => {\n      clearTimeout(toastTimer);\n      toastMessage.textContent = message;\n      toastIcon.className = state === 'success' ? 'ti ti-check' : state === 'error' ? 'ti ti-alert-circle' : 'ti ti-loader-2';\n      toastIcon.parentElement.classList.toggle('text-[var(--good)]', state === 'success');\n      toastIcon.parentElement.classList.toggle('text-[var(--bad)]', state === 'error');\n      toastIcon.parentElement.classList.toggle('text-[var(--lavender-hi)]', state === 'loading');\n      toast.hidden = false;\n      if (state !== 'loading') toastTimer = window.setTimeout(() => { toast.hidden = true; }, 2800);\n    };\n\n    const refreshCard = (card) => {\n      if (!card) return;\n      const status = card.querySelector('[data-status]');\n      const lastRefresh = card.querySelector('[data-last-refresh]');\n      card.classList.add('is-updating');\n      status.textContent = 'Updating…';\n      status.className = 'source-status rounded-full px-2 py-1 text-[10px] font-medium';\n      showToast('Refreshing ' + card.querySelector('h2').textContent.trim() + '…');\n      window.setTimeout(() => {\n        card.classList.remove('is-updating');\n        status.textContent = card.dataset.sourceType === 'key' ? 'Ready' : 'Up to date';\n        status.className = 'source-status rounded-full px-2 py-1 text-[10px] font-medium ' + (card.dataset.sourceType === 'key' ? 'status-neutral' : 'status-good');\n        lastRefresh.textContent = card.dataset.sourceType === 'key' ? 'Checked just now' : 'Updated just now';\n        showToast('Source refreshed · profiles are ready', 'success');\n      }, 850);\n    };\n\n    const closeMenus = (except = null) => {\n      document.querySelectorAll('[data-overflow-menu]').forEach((menu) => {\n        if (menu !== except) { menu.hidden = true; const trigger = menu.parentElement.querySelector('[data-overflow-trigger]'); if (trigger) trigger.setAttribute('aria-expanded', 'false'); }\n      });\n    };\n\n    addTrigger.addEventListener('click', () => setAddMenu(addMenu.hidden));\n    document.querySelectorAll('[data-source-kind]').forEach((button) => button.addEventListener('click', () => { setAddMenu(false); setModal(true, button.dataset.sourceKind); }));\n    document.querySelectorAll('[data-modal-kind]').forEach((button) => button.addEventListener('click', () => setModalType(button.dataset.modalKind)));\n    document.querySelectorAll('[data-close-source-modal]').forEach((button) => button.addEventListener('click', () => setModal(false)));\n    document.querySelectorAll('[data-close-remove-modal]').forEach((button) => button.addEventListener('click', () => setRemoveModal(false)));\n    document.querySelectorAll('[data-overflow-trigger]').forEach((button) => button.addEventListener('click', (event) => {\n      event.stopPropagation();\n      const menu = button.parentElement.querySelector('[data-overflow-menu]');\n      const open = menu.hidden;\n      closeMenus(open ? menu : null);\n      menu.hidden = !open;\n      button.setAttribute('aria-expanded', String(open));\n    }));\n    document.querySelectorAll('[data-refresh-source]').forEach((button) => button.addEventListener('click', () => { closeMenus(); refreshCard(button.closest('.source-card')); }));\n    document.querySelectorAll('[data-edit-source]').forEach((button) => button.addEventListener('click', () => { const card = button.closest('.source-card'); closeMenus(); setModal(true, card.dataset.sourceType, card); }));\n    document.querySelectorAll('[data-remove-source]').forEach((button) => button.addEventListener('click', () => { const card = button.closest('.source-card'); closeMenus(); setRemoveModal(true, card); }));\n\n    sourceForm.addEventListener('submit', (event) => {\n      event.preventDefault();\n      const value = (modalKind === 'url' ? sourceUrl.value : profileKey.value).trim();\n      const valid = modalKind === 'url' ? /^https?:\\/\\/[^\\s]+$/i.test(value) : /^(vless|vmess|trojan|ss|hysteria2):\\/\\/[^\\s]+$/i.test(value);\n      if (!valid) {\n        sourceError.textContent = modalKind === 'url' ? 'Enter a valid http(s) source URL.' : 'Enter a valid profile key such as vless://…';\n        (modalKind === 'url' ? sourceUrl : profileKey).focus();\n        return;\n      }\n      if (editingCard) {\n        editingCard.querySelector('.source-value').textContent = modalKind === 'key' ? 'vless://••••••••••••••••' : value;\n        setModal(false);\n        showToast('Source changes saved', 'success');\n        return;\n      }\n      setModal(false);\n      showToast(modalKind === 'url' ? 'Importing source…' : 'Adding single-key profile…');\n      window.setTimeout(() => showToast(modalKind === 'url' ? 'Source added · profiles imported' : 'Source added · 1 profile ready', 'success'), 900);\n    });\n\n    document.getElementById('confirm-remove-source').addEventListener('click', () => {\n      if (!removingCard) return;\n      const name = removingCard.querySelector('h2').textContent.trim();\n      removingCard.remove();\n      const remaining = document.querySelectorAll('.source-card').length;\n      sourceCount.textContent = String(remaining);\n      profileCount.textContent = remaining === 2 ? '4' : remaining === 1 ? '1' : '8';\n      setRemoveModal(false);\n      showToast(name + ' removed · profiles remain available', 'success');\n    });\n\n    document.getElementById('collapse-sidebar').addEventListener('click', () => {\n      const collapsed = app.classList.toggle('is-collapsed');\n      const button = document.getElementById('collapse-sidebar');\n      button.setAttribute('aria-expanded', String(!collapsed));\n      button.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');\n    });\n\n    document.addEventListener('click', (event) => {\n      if (!event.target.closest('#add-source-trigger') && !event.target.closest('#add-source-menu')) setAddMenu(false);\n      if (!event.target.closest('[data-overflow-trigger]') && !event.target.closest('[data-overflow-menu]')) closeMenus();\n      if (event.target === sourceModal) setModal(false);\n      if (event.target === removeModal) setRemoveModal(false);\n    });\n    document.addEventListener('keydown', (event) => {\n      if (event.key !== 'Escape') return;\n      if (!sourceModal.hidden) { setModal(false); return; }\n      if (!removeModal.hidden) { setRemoveModal(false); return; }\n      setAddMenu(false); closeMenus();\n    });\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-09-03T06:18:30.000080+00:00",
      "modified": "2026-09-03T06:19:57.170273+00:00",
      "id": "var_ce7fa3c94443",
      "viewportScrollY": 0
    },
    "var_3ecbf34427b1": {
      "type": "variant",
      "label": "Kagerou — Profiles · Managed",
      "parentId": "var_cad39bcd3eea",
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Inter+Tight:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    margin: 0;\n    background: #1A1B1E;\n  }\n\n  .kagerou-managed {\n    --canvas: #1A1B1E;\n    --sidebar: #17181B;\n    --surface: #222329;\n    --raised: #292A31;\n    --selected: #312E3B;\n    --row-hover: #282930;\n    --hairline: #2A2B31;\n    --lavender: #AA9BD7;\n    --lavender-hi: #C3B7E6;\n    --ink: #211F27;\n    --primary: #F2F0F6;\n    --body-copy: #C8C5D0;\n    --muted: #918D99;\n    --quiet: #77747F;\n    --good: #70B68E;\n    --warn: #D1AA64;\n    --bad: #CF747B;\n    color-scheme: dark;\n  }\n\n  .kagerou-managed .icon {\n    display: inline-flex;\n    width: 18px;\n    height: 18px;\n    align-items: center;\n    justify-content: center;\n    flex: 0 0 18px;\n    color: currentColor;\n    line-height: 1;\n  }\n\n  .kagerou-managed .sidebar {\n    transition: width 180ms ease, padding 180ms ease;\n  }\n\n  .kagerou-managed.is-collapsed .sidebar {\n    width: 68px;\n    padding-left: 12px;\n    padding-right: 12px;\n  }\n\n  .kagerou-managed.is-collapsed .sidebar-copy,\n  .kagerou-managed.is-collapsed .sidebar-label {\n    display: none;\n  }\n\n  .kagerou-managed.is-collapsed .brand-row,\n  .kagerou-managed.is-collapsed .nav-link,\n  .kagerou-managed.is-collapsed .sidebar-button {\n    justify-content: center;\n    padding-left: 0;\n    padding-right: 0;\n  }\n\n  .kagerou-managed .nav-link,\n  .kagerou-managed .sidebar-button,\n  .kagerou-managed .action-button,\n  .kagerou-managed .selection-control,\n  .kagerou-managed .row-more,\n  .kagerou-managed .menu-item,\n  .kagerou-managed .disclosure-trigger,\n  .kagerou-managed .drag-handle,\n  .kagerou-managed .inline-action {\n    transition: color 150ms ease, background-color 150ms ease, border-color 150ms ease, opacity 150ms ease;\n  }\n\n  .kagerou-managed .nav-link:hover,\n  .kagerou-managed .nav-link:focus-visible,\n  .kagerou-managed .sidebar-button:hover,\n  .kagerou-managed .sidebar-button:focus-visible {\n    background: var(--row-hover);\n    color: var(--primary);\n  }\n\n  .kagerou-managed .nav-link[aria-current='page'] {\n    background: var(--selected);\n    color: var(--primary);\n  }\n\n  .kagerou-managed .nav-link[aria-current='page'] .nav-icon {\n    color: var(--lavender);\n  }\n\n  .kagerou-managed button:focus-visible,\n  .kagerou-managed input:focus-visible,\n  .kagerou-managed textarea:focus-visible {\n    outline: 2px solid var(--lavender);\n    outline-offset: 3px;\n  }\n\n  .kagerou-managed .action-button {\n    display: inline-flex;\n    min-height: 40px;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    border-radius: 8px;\n    padding: 0 14px;\n    font-size: 12px;\n    font-weight: 600;\n    line-height: 1;\n  }\n\n  .kagerou-managed .action-button.primary {\n    background: var(--lavender);\n    color: var(--ink);\n  }\n\n  .kagerou-managed .action-button.primary:hover,\n  .kagerou-managed .action-button.primary:focus-visible {\n    background: var(--lavender-hi);\n  }\n\n  .kagerou-managed .action-button.secondary {\n    border: 1px solid var(--hairline);\n    background: var(--surface);\n    color: var(--body-copy);\n  }\n\n  .kagerou-managed .action-button.secondary:hover,\n  .kagerou-managed .action-button.secondary:focus-visible {\n    background: var(--raised);\n    color: var(--primary);\n    border-color: #464650;\n  }\n\n  .kagerou-managed .group-card {\n    overflow: visible;\n    border: 1px solid var(--hairline);\n    border-radius: 10px;\n    background: var(--surface);\n  }\n\n  .kagerou-managed .group-card[data-open='false'] .disclosure-chevron {\n    transform: rotate(-90deg);\n  }\n\n  .kagerou-managed .disclosure-chevron {\n    transition: transform 160ms ease, color 160ms ease;\n  }\n\n  .kagerou-managed .disclosure-trigger:hover .disclosure-chevron {\n    color: var(--lavender-hi);\n  }\n\n  .kagerou-managed .group-header {\n    min-height: 74px;\n    border-bottom: 1px solid var(--hairline);\n  }\n\n  .kagerou-managed .group-card[data-open='false'] .group-header {\n    border-bottom-color: transparent;\n  }\n\n  .kagerou-managed .profile-grid {\n    grid-template-columns: 58px minmax(0, 1fr) 108px 122px 126px 100px 54px;\n  }\n\n  .kagerou-managed .table-head {\n    min-height: 39px;\n    border-bottom: 1px solid var(--hairline);\n    color: var(--muted);\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n  }\n\n  .kagerou-managed .profile-row {\n    min-height: 75px;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.055);\n    color: var(--body-copy);\n  }\n\n  .kagerou-managed .profile-row:last-child {\n    border-bottom-color: transparent;\n  }\n\n  .kagerou-managed .profile-row:hover,\n  .kagerou-managed .profile-row:focus-within {\n    background: var(--row-hover);\n  }\n\n  .kagerou-managed .profile-row[data-selected='true'],\n  .kagerou-managed .profile-row[data-selected='true']:hover {\n    background: var(--selected);\n  }\n\n  .kagerou-managed .profile-row.is-dragging {\n    opacity: 0.48;\n  }\n\n  .kagerou-managed .order-cell {\n    display: flex;\n    align-items: center;\n    gap: 7px;\n    padding-left: 20px;\n    color: var(--muted);\n    font-family: 'IBM Plex Mono', monospace;\n    font-size: 12px;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .kagerou-managed .drag-handle {\n    display: inline-flex;\n    width: 26px;\n    height: 38px;\n    align-items: center;\n    justify-content: center;\n    cursor: grab;\n    border-radius: 6px;\n    color: var(--quiet);\n  }\n\n  .kagerou-managed .drag-handle:hover,\n  .kagerou-managed .drag-handle:focus-visible {\n    background: var(--raised);\n    color: var(--lavender-hi);\n  }\n\n  .kagerou-managed .drag-handle:active {\n    cursor: grabbing;\n  }\n\n  .kagerou-managed .identity-cell {\n    min-width: 0;\n    padding-right: 14px;\n  }\n\n  .kagerou-managed .identity-line {\n    display: flex;\n    min-width: 0;\n    align-items: center;\n    gap: 8px;\n  }\n\n  .kagerou-managed .profile-name-display {\n    overflow: hidden;\n    color: var(--primary);\n    font-size: 14px;\n    font-weight: 500;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .kagerou-managed .origin-badge {\n    display: inline-flex;\n    flex: 0 0 auto;\n    align-items: center;\n    border-radius: 5px;\n    padding: 4px 7px;\n    font-size: 10px;\n    font-weight: 600;\n    line-height: 1;\n  }\n\n  .kagerou-managed .origin-badge.local {\n    background: rgba(170, 155, 215, 0.14);\n    color: var(--lavender-hi);\n  }\n\n  .kagerou-managed .origin-badge.imported {\n    background: rgba(112, 182, 142, 0.13);\n    color: var(--good);\n  }\n\n  .kagerou-managed .origin-meta {\n    display: block;\n    margin-top: 6px;\n    overflow: hidden;\n    color: var(--muted);\n    font-size: 11px;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .kagerou-managed .protocol-badge {\n    width: fit-content;\n    border-radius: 6px;\n    background: var(--raised);\n    padding: 6px 8px;\n    color: var(--body-copy);\n    font-family: 'IBM Plex Mono', monospace;\n    font-size: 10px;\n  }\n\n  .kagerou-managed .result {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    min-width: 0;\n    font-family: 'IBM Plex Mono', monospace;\n    font-size: 11px;\n    font-variant-numeric: tabular-nums;\n    white-space: nowrap;\n  }\n\n  .kagerou-managed .result::before {\n    width: 6px;\n    height: 6px;\n    flex: 0 0 6px;\n    border-radius: 999px;\n    background: var(--quiet);\n    content: '';\n  }\n\n  .kagerou-managed .result.good {\n    color: var(--body-copy);\n  }\n\n  .kagerou-managed .result.good::before {\n    background: var(--good);\n  }\n\n  .kagerou-managed .result.warn {\n    color: var(--warn);\n  }\n\n  .kagerou-managed .result.warn::before {\n    background: var(--warn);\n  }\n\n  .kagerou-managed .result.bad {\n    color: var(--bad);\n  }\n\n  .kagerou-managed .result.bad::before {\n    background: var(--bad);\n  }\n\n  .kagerou-managed .result.muted {\n    color: var(--muted);\n  }\n\n  .kagerou-managed .selection-control {\n    display: inline-flex;\n    min-height: 34px;\n    align-items: center;\n    justify-content: center;\n    gap: 6px;\n    border: 1px solid var(--hairline);\n    border-radius: 7px;\n    padding: 0 9px;\n    color: var(--body-copy);\n    font-size: 11px;\n    font-weight: 500;\n    white-space: nowrap;\n  }\n\n  .kagerou-managed .selection-control:hover,\n  .kagerou-managed .selection-control:focus-visible {\n    border-color: #464650;\n    background: var(--raised);\n    color: var(--primary);\n  }\n\n  .kagerou-managed .selection-control[aria-pressed='true'] {\n    border-color: transparent;\n    background: var(--lavender);\n    color: var(--ink);\n    font-weight: 700;\n  }\n\n  .kagerou-managed .selection-control[aria-pressed='true']:hover,\n  .kagerou-managed .selection-control[aria-pressed='true']:focus-visible {\n    background: var(--lavender-hi);\n  }\n\n  .kagerou-managed .more-cell {\n    position: relative;\n    display: flex;\n    justify-content: flex-end;\n    padding-right: 14px;\n  }\n\n  .kagerou-managed .row-more {\n    display: inline-flex;\n    width: 44px;\n    height: 44px;\n    align-items: center;\n    justify-content: center;\n    border-radius: 8px;\n    color: var(--muted);\n    opacity: 0.78;\n  }\n\n  .kagerou-managed .row-more:hover,\n  .kagerou-managed .row-more:focus-visible,\n  .kagerou-managed .row-more[aria-expanded='true'] {\n    background: var(--raised);\n    color: var(--primary);\n    opacity: 1;\n  }\n\n  .kagerou-managed .context-menu {\n    position: absolute;\n    z-index: 30;\n    width: 190px;\n    border: 1px solid #3B3A45;\n    border-radius: 9px;\n    background: #25262D;\n    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.32);\n    padding: 6px;\n  }\n\n  .kagerou-managed .context-menu[data-open='false'] {\n    display: none;\n  }\n\n  .kagerou-managed .row-menu {\n    top: 48px;\n    right: 12px;\n  }\n\n  .kagerou-managed .menu-item {\n    display: flex;\n    width: 100%;\n    min-height: 34px;\n    align-items: center;\n    gap: 9px;\n    border-radius: 6px;\n    padding: 0 9px;\n    color: var(--body-copy);\n    font-size: 11px;\n    text-align: left;\n  }\n\n  .kagerou-managed .menu-item:hover,\n  .kagerou-managed .menu-item:focus-visible {\n    background: var(--selected);\n    color: var(--primary);\n  }\n\n  .kagerou-managed .menu-item.danger {\n    color: var(--bad);\n  }\n\n  .kagerou-managed .menu-divider {\n    height: 1px;\n    margin: 5px 2px;\n    background: var(--hairline);\n  }\n\n  .kagerou-managed .menu-kicker {\n    padding: 5px 9px 6px;\n    color: var(--muted);\n    font-family: 'IBM Plex Mono', monospace;\n    font-size: 9px;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n  }\n\n  .kagerou-managed .submenu-anchor {\n    position: relative;\n  }\n\n  .kagerou-managed .test-submenu {\n    top: 112px;\n    right: 192px;\n    width: 174px;\n  }\n\n  .kagerou-managed .inline-editor {\n    display: none;\n    min-width: 0;\n    align-items: center;\n    gap: 6px;\n  }\n\n  .kagerou-managed .profile-row[data-editing='true'] .profile-name-display {\n    display: none;\n  }\n\n  .kagerou-managed .profile-row[data-editing='true'] .inline-editor {\n    display: flex;\n  }\n\n  .kagerou-managed .inline-editor input {\n    min-width: 0;\n    width: 164px;\n    height: 32px;\n    border: 1px solid var(--lavender);\n    border-radius: 6px;\n    background: var(--canvas);\n    padding: 0 8px;\n    color: var(--primary);\n    font-family: 'Inter', sans-serif;\n    font-size: 12px;\n    outline: none;\n  }\n\n  .kagerou-managed .inline-action {\n    display: inline-flex;\n    width: 28px;\n    height: 28px;\n    align-items: center;\n    justify-content: center;\n    border-radius: 6px;\n    color: var(--body-copy);\n  }\n\n  .kagerou-managed .inline-action:hover,\n  .kagerou-managed .inline-action:focus-visible {\n    background: var(--raised);\n    color: var(--primary);\n  }\n\n  .kagerou-managed .managed-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    border: 1px solid rgba(112, 182, 142, 0.22);\n    border-radius: 7px;\n    padding: 8px 10px;\n    color: var(--good);\n    font-family: 'IBM Plex Mono', monospace;\n    font-size: 10px;\n  }\n\n  .kagerou-managed .source-summary {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 20px;\n    border-top: 1px solid var(--hairline);\n    padding: 14px 20px;\n    color: var(--muted);\n    font-size: 11px;\n  }\n\n  .kagerou-managed .source-summary strong {\n    color: var(--body-copy);\n    font-weight: 500;\n  }\n\n  .kagerou-managed .dialog-backdrop {\n    position: fixed;\n    z-index: 60;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: rgba(13, 14, 16, 0.76);\n    padding: 32px;\n  }\n\n  .kagerou-managed .dialog-backdrop[hidden] {\n    display: none;\n  }\n\n  .kagerou-managed .dialog {\n    width: 480px;\n    max-width: 100%;\n    border: 1px solid #3B3A45;\n    border-radius: 12px;\n    background: var(--raised);\n    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.34);\n    padding: 24px;\n  }\n\n  .kagerou-managed .dialog h2 {\n    margin: 0;\n    color: var(--primary);\n    font-family: 'Inter Tight', sans-serif;\n    font-size: 24px;\n    font-weight: 600;\n    letter-spacing: -0.025em;\n  }\n\n  .kagerou-managed .dialog-label {\n    display: block;\n    margin-bottom: 7px;\n    color: var(--primary);\n    font-size: 12px;\n    font-weight: 600;\n  }\n\n  .kagerou-managed .dialog-input {\n    width: 100%;\n    height: 42px;\n    box-sizing: border-box;\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    border-radius: 7px;\n    background: var(--surface);\n    padding: 0 12px;\n    color: var(--body-copy);\n    font-family: 'Inter', sans-serif;\n    font-size: 13px;\n    outline: none;\n  }\n\n  .kagerou-managed .dialog-textarea {\n    display: block;\n    width: 100%;\n    min-height: 86px;\n    box-sizing: border-box;\n    resize: vertical;\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    border-radius: 7px;\n    background: var(--surface);\n    padding: 11px 12px;\n    color: var(--body-copy);\n    font-family: 'IBM Plex Mono', monospace;\n    font-size: 11px;\n    line-height: 1.5;\n    outline: none;\n  }\n\n  .kagerou-managed .dialog-input:focus,\n  .kagerou-managed .dialog-textarea:focus {\n    border-color: var(--lavender-hi);\n    box-shadow: 0 0 0 3px rgba(170, 155, 215, 0.18);\n  }\n\n  .kagerou-managed .dialog-helper {\n    margin-top: 7px;\n    color: var(--muted);\n    font-size: 11px;\n    line-height: 1.45;\n  }\n\n  .kagerou-managed .dialog-error {\n    min-height: 17px;\n    margin-top: 8px;\n    color: var(--bad);\n    font-size: 11px;\n  }\n\n  .kagerou-managed .dialog-close {\n    display: inline-flex;\n    width: 40px;\n    height: 40px;\n    align-items: center;\n    justify-content: center;\n    border-radius: 8px;\n    color: var(--muted);\n  }\n\n  .kagerou-managed .dialog-close:hover,\n  .kagerou-managed .dialog-close:focus-visible {\n    background: rgba(255, 255, 255, 0.06);\n    color: var(--primary);\n  }\n\n  .kagerou-managed .danger-copy {\n    margin-top: 16px;\n    border-left: 2px solid var(--bad);\n    background: rgba(207, 116, 123, 0.08);\n    padding: 11px 12px;\n    color: var(--body-copy);\n    font-size: 12px;\n    line-height: 1.5;\n  }\n\n  .kagerou-managed .sr-only {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    overflow: hidden;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n  }\n\n  @media (max-width: 960px) {\n    .kagerou-managed .sidebar {\n      width: 68px;\n      padding-left: 12px;\n      padding-right: 12px;\n    }\n\n    .kagerou-managed .sidebar-copy,\n    .kagerou-managed .sidebar-label {\n      display: none;\n    }\n\n    .kagerou-managed .brand-row,\n    .kagerou-managed .nav-link,\n    .kagerou-managed .sidebar-button {\n      justify-content: center;\n      padding-left: 0;\n      padding-right: 0;\n    }\n\n    .kagerou-managed main {\n      padding-left: 24px;\n      padding-right: 24px;\n    }\n\n    .kagerou-managed .profile-grid {\n      grid-template-columns: 48px minmax(0, 1fr) 92px 104px 112px 88px 48px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .kagerou-managed .sidebar,\n    .kagerou-managed .nav-link,\n    .kagerou-managed .sidebar-button,\n    .kagerou-managed .action-button,\n    .kagerou-managed .selection-control,\n    .kagerou-managed .row-more,\n    .kagerou-managed .menu-item,\n    .kagerou-managed .disclosure-chevron {\n      transition: none;\n    }\n  }\n</style>\n<div class=\"kagerou-managed flex min-h-screen min-w-[960px] w-full overflow-x-clip bg-[var(--canvas)] font-['Inter'] text-[var(--primary)] antialiased\" data-kid=\"1\" id=\"managed-profiles\">\n    <aside aria-label=\"Primary navigation\" class=\"sidebar flex w-[216px] shrink-0 flex-col border-r border-[var(--hairline)] bg-[var(--sidebar)] px-3 py-6\" data-kid=\"1-1\" id=\"managed-sidebar\">\n        <div class=\"brand-row mb-11 flex items-center gap-3 px-3\" data-kid=\"1-1-1\">\n            <span aria-hidden=\"true\" class=\"relative flex h-9 w-9 shrink-0 items-center justify-center\" data-kid=\"1-1-1-1\">\n                <span class=\"absolute left-0 top-0 h-8 w-8 rounded-full bg-[var(--lavender)]\" data-kid=\"1-1-1-1-1\">\n                </span>\n                <span class=\"absolute right-0 top-0.5 h-7 w-7 translate-x-1 rounded-full bg-[var(--sidebar)]\" data-kid=\"1-1-1-1-2\">\n                </span>\n            </span>\n            <span class=\"sidebar-copy min-w-0\" data-kid=\"1-1-1-2\">\n                <span class=\"block font-['Inter Tight'] text-[18px] font-semibold leading-none tracking-[-0.02em]\" data-kid=\"1-1-1-2-1\">\n                    Kagerou\n                </span>\n                <span class=\"mt-2 block text-[9px] uppercase tracking-[0.2em] text-[var(--muted)]\" data-kid=\"1-1-1-2-2\">\n                    Instrument panel\n                </span>\n            </span>\n        </div>\n        <nav aria-label=\"Primary navigation\" class=\"flex flex-col gap-1\" data-kid=\"1-1-2\">\n            <a class=\"nav-link flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body-copy)]\" data-kid=\"1-1-2-1\" href=\"#dashboard\">\n                <span class=\"nav-icon flex h-5 w-5 shrink-0 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-1-1\">\n                    <i aria-hidden=\"true\" class=\"icon ti ti-layout-dashboard\" data-kid=\"1-1-2-1-1-1\">\n                    </i>\n                </span>\n                <span class=\"sidebar-label whitespace-nowrap\" data-kid=\"1-1-2-1-2\">\n                    Dashboard\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"nav-link flex h-10 items-center gap-3 rounded-[8px] bg-[var(--selected)] px-3 text-[13px] font-medium text-[var(--primary)]\" data-kid=\"1-1-2-2\" href=\"#profiles\">\n                <span class=\"nav-icon flex h-5 w-5 shrink-0 items-center justify-center text-[18px] text-[var(--lavender)]\" data-kid=\"1-1-2-2-1\">\n                    <i aria-hidden=\"true\" class=\"icon ti ti-server\" data-kid=\"1-1-2-2-1-1\">\n                    </i>\n                </span>\n                <span class=\"sidebar-label whitespace-nowrap\" data-kid=\"1-1-2-2-2\">\n                    Profiles\n                </span>\n            </a>\n            <a class=\"nav-link flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body-copy)]\" data-kid=\"1-1-2-3\" href=\"#sources\">\n                <span class=\"nav-icon flex h-5 w-5 shrink-0 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-3-1\">\n                    <i aria-hidden=\"true\" class=\"icon ti ti-rss\" data-kid=\"1-1-2-3-1-1\">\n                    </i>\n                </span>\n                <span class=\"sidebar-label whitespace-nowrap\" data-kid=\"1-1-2-3-2\">\n                    Sources\n                </span>\n            </a>\n            <a class=\"nav-link flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body-copy)]\" data-kid=\"1-1-2-4\" href=\"#routing-rules\">\n                <span class=\"nav-icon flex h-5 w-5 shrink-0 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-4-1\">\n                    <i aria-hidden=\"true\" class=\"icon ti ti-route\" data-kid=\"1-1-2-4-1-1\">\n                    </i>\n                </span>\n                <span class=\"sidebar-label whitespace-nowrap\" data-kid=\"1-1-2-4-2\">\n                    Routing rules\n                </span>\n            </a>\n            <a class=\"nav-link flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body-copy)]\" data-kid=\"1-1-2-5\" href=\"#logs\">\n                <span class=\"nav-icon flex h-5 w-5 shrink-0 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-5-1\">\n                    <i aria-hidden=\"true\" class=\"icon ti ti-file-text\" data-kid=\"1-1-2-5-1-1\">\n                    </i>\n                </span>\n                <span class=\"sidebar-label whitespace-nowrap\" data-kid=\"1-1-2-5-2\">\n                    Logs\n                </span>\n            </a>\n            <a class=\"nav-link flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body-copy)]\" data-kid=\"1-1-2-6\" href=\"#settings\">\n                <span class=\"nav-icon flex h-5 w-5 shrink-0 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-6-1\">\n      