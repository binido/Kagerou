-5 border-b border-[var(--hairline)] px-5\" data-kid=\"1-2-1-2-4-1\" data-name=\"work group header\">\n                        <button aria-expanded=\"false\" class=\"group-trigger flex min-w-0 flex-1 items-center gap-3 rounded-[8px] py-2 text-left\" data-group-trigger=\"\" data-kid=\"1-2-1-2-4-1-1\" data-name=\"work group trigger\" type=\"button\">\n                            <span class=\"flex size-6 shrink-0 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-2-1-2-4-1-1-1\" data-name=\"work group chevron\">\n                                <i aria-hidden=\"true\" class=\"group-chevron ti ti-chevron-down\" data-kid=\"1-2-1-2-4-1-1-1-1\" data-name=\"work group chevron icon\">\n                                </i>\n                            </span>\n                            <span class=\"min-w-0\" data-kid=\"1-2-1-2-4-1-1-2\" data-name=\"work group header info\">\n                                <span class=\"block truncate font-['Inter_Tight'] text-[17px] font-semibold tracking-[-0.015em]\" data-kid=\"1-2-1-2-4-1-1-2-1\" data-name=\"work group title\">\n                                    Work / Europe\n                                </span>\n                                <span class=\"mt-1 block text-[12px] text-[var(--muted)]\" data-kid=\"1-2-1-2-4-1-1-2-2\" data-name=\"work group stats\">\n                                    3 profiles\n                                </span>\n                            </span>\n                        </button>\n                        <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-2-1-2-4-1-2\" data-name=\"work group actions\">\n                            <span class=\"inline-flex items-center gap-1.5 rounded-[7px] border border-[rgba(112,182,142,.22)] px-2.5 py-2 font-['IBM_Plex_Mono'] text-[10px] text-[var(--good)]\" data-kid=\"1-2-1-2-4-1-2-1\" data-name=\"work group badge\">\n                                <i aria-hidden=\"true\" class=\"ti ti-lock text-[13px]\" data-kid=\"1-2-1-2-4-1-2-1-1\" data-name=\"work group lock icon\">\n                                </i>\n                                Managed on Sources\n                            </span>\n                            <button aria-label=\"More actions for Work / Europe\" class=\"icon-button flex size-9 items-center justify-center rounded-[8px] text-[17px] text-[var(--muted)]\" data-kid=\"1-2-1-2-4-1-2-2\" data-name=\"work group more button\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-dots\" data-kid=\"1-2-1-2-4-1-2-2-1\" data-name=\"work group dots icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"group-panel\" data-kid=\"1-2-1-2-4-2\" data-name=\"work group panel\">\n                    </div>\n                </section>\n            </div>\n            <p aria-live=\"polite\" class=\"mt-4 min-h-[17px] text-[11px] text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"1-2-1-3\" data-name=\"feedback message container\" data-reason=\"feedback text injected by script\">\n            </p>\n        </div>\n    </main>\n</div>\n<div aria-hidden=\"true\" class=\"menu fixed z-20 hidden w-56 rounded-[9px] border border-[var(--hairline)] bg-[#25262d] p-1.5 text-[11px]\" data-dynamic=\"true\" data-kid=\"2\" data-name=\"profile context menu\" data-profile-menu-panel=\"\" data-reason=\"visibility controlled by script toggling hidden attribute\">\n    <button class=\"menu-item flex min-h-[34px] w-full items-center gap-2 rounded-[6px] px-2 text-left text-[var(--body)]\" data-kid=\"2-1\" data-name=\"rename profile action\" type=\"button\">\n        <i aria-hidden=\"true\" class=\"ti ti-pencil text-[14px]\" data-kid=\"2-1-1\" data-name=\"rename icon\">\n        </i>\n        Rename profile\n    </button>\n    <button class=\"menu-item flex min-h-[34px] w-full items-center gap-2 rounded-[6px] px-2 text-left text-[var(--body)]\" data-kid=\"2-2\" data-name=\"move up profile action\" type=\"button\">\n        <i aria-hidden=\"true\" class=\"ti ti-arrow-up text-[14px]\" data-kid=\"2-2-1\" data-name=\"move up icon\">\n        </i>\n        Move up\n    </button>\n    <button class=\"menu-item flex min-h-[34px] w-full items-center gap-2 rounded-[6px] px-2 text-left text-[var(--body)]\" data-kid=\"2-3\" data-name=\"move down profile action\" type=\"button\">\n        <i aria-hidden=\"true\" class=\"ti ti-arrow-down text-[14px]\" data-kid=\"2-3-1\" data-name=\"move down icon\">\n        </i>\n        Move down\n    </button>\n    <div class=\"my-1 h-px bg-[var(--hairline)]\" data-kid=\"2-4\" data-name=\"context menu divider one\">\n    </div>\n    <button class=\"menu-item flex min-h-[34px] w-full items-center gap-2 rounded-[6px] px-2 text-left text-[var(--body)]\" data-kid=\"2-5\" data-move-toggle=\"\" data-name=\"move to group action\" type=\"button\">\n        <i aria-hidden=\"true\" class=\"ti ti-arrow-right text-[14px]\" data-kid=\"2-5-1\" data-name=\"move to group icon\">\n        </i>\n        Move to group\n        <i aria-hidden=\"true\" class=\"ti ti-chevron-right ml-auto text-[13px]\" data-kid=\"2-5-2\" data-name=\"move to group chevron\">\n        </i>\n    </button>\n    <div class=\"my-1 h-px bg-[var(--hairline)]\" data-kid=\"2-6\" data-name=\"context menu divider two\">\n    </div>\n    <button class=\"menu-item flex min-h-[34px] w-full items-center gap-2 rounded-[6px] px-2 text-left text-[var(--bad)]\" data-kid=\"2-7\" data-name=\"delete profile action\" type=\"button\">\n        <i aria-hidden=\"true\" class=\"ti ti-trash text-[14px]\" data-kid=\"2-7-1\" data-name=\"delete icon\">\n        </i>\n        Delete profile\n    </button>\n    <div class=\"my-1 h-px bg-[var(--hairline)]\" data-kid=\"2-8\" data-name=\"context menu divider three\">\n    </div>\n    <button class=\"menu-item flex min-h-[34px] w-full items-center gap-2 rounded-[6px] px-2 text-left text-[var(--body)]\" data-kid=\"2-9\" data-name=\"test profile action\" type=\"button\">\n        <i aria-hidden=\"true\" class=\"ti ti-radar text-[14px]\" data-kid=\"2-9-1\" data-name=\"test icon\">\n        </i>\n        Test\n        <i aria-hidden=\"true\" class=\"ti ti-chevron-right ml-auto text-[13px]\" data-kid=\"2-9-2\" data-name=\"test chevron\">\n        </i>\n    </button>\n</div>\n<script>\n    (() => { const root=document.getElementById('profiles-design'); if(!root)return; root.querySelectorAll('[data-group-trigger]').forEach((trigger)=>trigger.addEventListener('click',()=>{const card=trigger.closest('[data-group-card]');const open=card.dataset.open!=='true';card.dataset.open=String(open);trigger.setAttribute('aria-expanded',String(open));})); const collapse=root.querySelector('[data-collapse-sidebar]'); collapse?.addEventListener('click',()=>{const collapsed=root.classList.toggle('is-collapsed');collapse.setAttribute('aria-expanded',String(!collapsed));collapse.setAttribute('aria-label',collapsed?'Expand sidebar':'Collapse sidebar');}); const panel=document.querySelector('[data-profile-menu-panel]'); root.querySelector('[data-profile-menu]')?.addEventListener('click',(event)=>{const button=event.currentTarget;const rect=button.getBoundingClientRect();panel.style.left=`${rect.left-224}px`;panel.style.top=`${rect.bottom+6}px`;panel.classList.toggle('hidden');panel.setAttribute('aria-hidden',String(panel.classList.contains('hidden')));}); panel?.querySelector('[data-move-toggle]')?.addEventListener('click',()=>{let move=panel.querySelector('[data-move-menu]');if(!move){move=document.createElement('div');move.dataset.moveMenu='';move.className='move-menu absolute right-[222px] top-[122px] w-44 rounded-[9px] border border-[var(--hairline)] bg-[#25262d] p-1.5';move.innerHTML='<div class=\"px-2 py-1.5 font-[\\'IBM_Plex_Mono\\'] text-[9px] uppercase tracking-[.08em] text-[var(--muted)]\">Local groups</div><button class=\"menu-item flex min-h-[34px] w-full items-center gap-2 rounded-[6px] px-2 text-left text-[var(--body)]\" type=\"button\">Default</button><button class=\"menu-item flex min-h-[34px] w-full items-center gap-2 rounded-[6px] px-2 text-left text-[var(--body)]\" type=\"button\">Travel keys</button>';panel.appendChild(move);}move.hidden=!move.hidden;}); document.addEventListener('click',(event)=>{if(panel&&!event.target.closest('[data-profile-menu]')&&!event.target.closest('[data-profile-menu-panel]')){panel.classList.add('hidden');panel.setAttribute('aria-hidden','true');}});})();\n</script>\n",
