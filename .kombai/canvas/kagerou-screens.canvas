      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Inter+Tight:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .kagerou-profiles-design { --canvas:#1a1b1e; --sidebar:#17181b; --surface:#222329; --raised:#292a31; --selected:#312e3b; --row-hover:#282930; --hairline:#2a2b31; --primary:#f2f0f6; --body:#c8c5d0; --muted:#918d99; --quiet:#77747f; --lavender:#aa9bd7; --lavender-hi:#c3b7e6; --ink:#211f27; --good:#70b68e; --bad:#cf747b; color-scheme:dark; font-family:'Inter',sans-serif; }\n  .kagerou-profiles-design [hidden] { display:none; }\n  .kagerou-profiles-design button:focus-visible, .kagerou-profiles-design a:focus-visible { outline:2px solid var(--lavender); outline-offset:3px; }\n  .kagerou-profiles-design .nav-item:hover, .kagerou-profiles-design .nav-item:focus-visible, .kagerou-profiles-design .icon-button:hover, .kagerou-profiles-design .icon-button:focus-visible { background:var(--row-hover); color:var(--primary); }\n  .kagerou-profiles-design .nav-item[aria-current='page'] { background:var(--selected); color:var(--primary); }\n  .kagerou-profiles-design .nav-item[aria-current='page'] .nav-icon { color:var(--lavender); }\n  .kagerou-profiles-design .group-trigger:hover .group-chevron { color:var(--lavender-hi); }\n  .kagerou-profiles-design .group-card[data-open='false'] .group-header { border-bottom-color:transparent; }\n  .kagerou-profiles-design .group-card[data-open='false'] .group-panel { display:none; }\n  .kagerou-profiles-design .group-card[data-open='false'] .group-chevron { transform:rotate(-90deg); }\n  .kagerou-profiles-design .group-chevron { transition:transform 160ms ease,color 160ms ease; }\n  .kagerou-profiles-design .profile-row:hover, .kagerou-profiles-design .profile-row:focus-within { background:var(--row-hover); }\n  .kagerou-profiles-design .profile-row[data-selected='true'], .kagerou-profiles-design .profile-row[data-selected='true']:hover { background:var(--selected); }\n  .kagerou-profiles-design .menu { box-shadow:0 16px 32px rgba(0,0,0,.32); }\n  .kagerou-profiles-design .menu-item:hover, .kagerou-profiles-design .menu-item:focus-visible { background:var(--selected); color:var(--primary); }\n  .kagerou-profiles-design .move-menu[hidden] { display:none; }\n  .kagerou-profiles-design .sidebar { transition:width 180ms ease,padding 180ms ease; }\n  .kagerou-profiles-design.is-collapsed .sidebar { width:68px; padding-left:12px; padding-right:12px; }\n  .kagerou-profiles-design.is-collapsed .wordmark, .kagerou-profiles-design.is-collapsed .nav-label, .kagerou-profiles-design.is-collapsed .collapse-label { display:none; }\n  .kagerou-profiles-design.is-collapsed .brand-row, .kagerou-profiles-design.is-collapsed .nav-item, .kagerou-profiles-design.is-collapsed .collapse-button { justify-content:center; padding-left:0; padding-right:0; }\n  @media (max-width:960px) { .kagerou-profiles-design .sidebar { width:68px; padding-left:12px; padding-right:12px; } .kagerou-profiles-design .wordmark,.kagerou-profiles-design .nav-label,.kagerou-profiles-design .collapse-label { display:none; } .kagerou-profiles-design .brand-row,.kagerou-profiles-design .nav-item,.kagerou-profiles-design .collapse-button { justify-content:center; padding-left:0; padding-right:0; } .kagerou-profiles-design main { padding-left:24px; padding-right:24px; } }\n</style>\n<div class=\"kagerou-profiles-design flex min-h-screen min-w-[960px] w-full overflow-x-clip bg-[var(--canvas)] text-[var(--primary)] antialiased\" data-kid=\"1\" data-name=\"page layout container\" id=\"profiles-design\">\n    <aside aria-label=\"Primary navigation\" class=\"sidebar flex w-[216px] shrink-0 flex-col border-r border-[var(--hairline)] bg-[var(--sidebar)] px-3 py-6\" data-kid=\"1-1\" data-name=\"sidebar navigation container\">\n        <div class=\"brand-row mb-11 flex items-center gap-3 px-3\" data-kid=\"1-1-1\" data-name=\"sidebar brand header\">\n            <span aria-hidden=\"true\" class=\"relative flex h-9 w-9 shrink-0 items-center justify-center\" data-kid=\"1-1-1-1\" data-name=\"brand logo icon\">\n                <span class=\"absolute left-0 top-0 h-8 w-8 rounded-full bg-[var(--lavender)]\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo primary circle\">\n                </span>\n                <span class=\"absolute right-0 top-0.5 h-7 w-7 translate-x-1 rounded-full bg-[var(--sidebar)]\" data-kid=\"1-1-1-1-2\" data-name=\"brand logo overlap circle\">\n                </span>\n            </span>\n            <span class=\"wordmark min-w-0\" data-kid=\"1-1-1-2\" data-name=\"sidebar brand wordmark\">\n                <span class=\"block font-['Inter_Tight'] text-[18px] font-semibold leading-none tracking-[-0.02em]\" data-kid=\"1-1-1-2-1\" data-name=\"brand title text\">\n                    Kagerou\n                </span>\n                <span class=\"mt-2 block text-[9px] uppercase tracking-[0.2em] text-[var(--muted)]\" data-kid=\"1-1-1-2-2\" data-name=\"brand subtitle text\">\n                    Instrument panel\n                </span>\n            </span>\n        </div>\n        <nav aria-label=\"Primary navigation\" class=\"flex flex-col gap-1\" data-kid=\"1-1-2\" data-name=\"main navigation list\">\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-1\" data-name=\"dashboard navigation link\" href=\"#dashboard\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-1-1\" data-name=\"dashboard icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard\" data-kid=\"1-1-2-1-1-1\" data-name=\"dashboard icon\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-1-2\" data-name=\"dashboard label\">\n                    Dashboard\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] font-medium text-[var(--primary)] transition-colors\" data-kid=\"1-1-2-2\" data-name=\"profiles navigation link\" href=\"#profiles\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px]\" data-kid=\"1-1-2-2-1\" data-name=\"profiles icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-server\" data-kid=\"1-1-2-2-1-1\" data-name=\"profiles icon\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-2-2\" data-name=\"profiles label\">\n                    Profiles\n                </span>\n            </a>\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-3\" data-name=\"sources navigation link\" href=\"#sources\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-3-1\" data-name=\"sources icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-rss\" data-kid=\"1-1-2-3-1-1\" data-name=\"sources icon\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-3-2\" data-name=\"sources label\">\n                    Sources\n                </span>\n            </a>\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-4\" data-name=\"routing rules navigation link\" href=\"#routing-rules\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-4-1\" data-name=\"routing rules icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-route\" data-kid=\"1-1-2-4-1-1\" data-name=\"routing rules icon\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-4-2\" data-name=\"routing rules label\">\n                    Routing rules\n                </span>\n            </a>\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-5\" data-name=\"logs navigation link\" href=\"#logs\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-5-1\" data-name=\"logs icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-file-text\" data-kid=\"1-1-2-5-1-1\" data-name=\"logs icon\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-5-2\" data-name=\"logs label\">\n                    Logs\n                </span>\n            </a>\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-6\" data-name=\"settings navigation link\" href=\"#settings\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-6-1\" data-name=\"settings icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-settings\" data-kid=\"1-1-2-6-1-1\" data-name=\"settings icon\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-6-2\" data-name=\"settings label\">\n                    Settings\n                </span>\n            </a>\n        </nav>\n        <button aria-expanded=\"true\" aria-label=\"Collapse sidebar\" class=\"collapse-button icon-button mt-auto flex h-10 w-full items-center gap-3 rounded-[8px] px-3 text-left text-[13px] text-[var(--muted)] transition-colors\" data-collapse-sidebar=\"\" data-kid=\"1-1-3\" data-name=\"sidebar collapse button\" type=\"button\">\n            <span class=\"flex size-5 items-center justify-center text-[18px]\" data-kid=\"1-1-3-1\" data-name=\"collapse icon container\">\n                <i aria-hidden=\"true\" class=\"ti ti-layout-sidebar-left-collapse\" data-kid=\"1-1-3-1-1\" data-name=\"collapse icon\">\n                </i>\n            </span>\n            <span class=\"collapse-label\" data-kid=\"1-1-3-2\" data-name=\"collapse label\">\n                Collapse sidebar\n            </span>\n        </button>\n    </aside>\n    <main class=\"min-w-0 flex-1 bg-[var(--canvas)] px-12 pb-10 pt-10\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mx-auto w-full max-w-[1040px]\" data-kid=\"1-2-1\" data-name=\"profiles view header\" id=\"profiles\">\n            <header class=\"mb-7 flex items-start justify-between gap-8\" data-kid=\"1-2-1-1\" data-name=\"header layout container\">\n                <div data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb and title group\">\n                    <div class=\"flex items-center gap-2 text-[10px] font-medium uppercase tracking-[0.18em] text-[var(--muted)]\" data-kid=\"1-2-1-1-1-1\" data-name=\"breadcrumb container\">\n                        <span data-kid=\"1-2-1-1-1-1-1\" data-name=\"kagerou brand crumb\">\n                            Kagerou\n                        </span>\n                        <span class=\"text-[#5e5b66]\" data-kid=\"1-2-1-1-1-1-2\" data-name=\"separator crumb\">\n                            /\n                        </span>\n                        <span data-kid=\"1-2-1-1-1-1-3\" data-name=\"page crumb\">\n                            Connection profiles\n                        </span>\n                    </div>\n                    <h1 class=\"mt-3 font-['Inter_Tight'] text-[34px] font-semibold leading-none tracking-[-0.04em]\" data-kid=\"1-2-1-1-1-2\" data-name=\"page title\">\n                        Profiles\n                    </h1>\n                    <p class=\"mt-3 max-w-[610px] text-[13px] leading-5 text-[var(--muted)]\" data-kid=\"1-2-1-1-1-3\" data-name=\"page description\">\n                        Organize single keys into local groups while subscriptions stay together.\n                    </p>\n                </div>\n                <div class=\"mt-1 flex shrink-0 flex-wrap justify-end gap-2\" data-kid=\"1-2-1-1-2\" data-name=\"header actions container\">\n                    <button class=\"inline-flex h-10 items-center gap-2 rounded-[8px] border border-[var(--hairline)] bg-[var(--surface)] px-3.5 text-[12px] text-[var(--body)] transition-colors hover:bg-[var(--raised)] hover:text-[var(--primary)]\" data-kid=\"1-2-1-1-2-1\" data-name=\"add group button\" data-open-group-dialog=\"\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-folder-plus text-[16px]\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"add group icon\">\n                        </i>\n                        Add group\n                    </button>\n                    <button class=\"inline-flex h-10 items-center gap-2 rounded-[8px] bg-[var(--lavender)] px-3.5 text-[12px] font-semibold text-[var(--ink)] transition-colors hover:bg-[var(--lavender-hi)]\" data-kid=\"1-2-1-1-2-2\" data-name=\"add single key button\" data-open-key-dialog=\"\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-plus text-[16px]\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"add single key icon\">\n                        </i>\n                        Add single key\n                    </button>\n                    <button class=\"inline-flex h-10 items-center gap-2 rounded-[8px] border border-[var(--hairline)] bg-[var(--surface)] px-3.5 text-[12px] text-[var(--body)] transition-colors hover:bg-[var(--raised)] hover:text-[var(--primary)]\" data-kid=\"1-2-1-1-2-3\" data-name=\"run test button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-radar text-[16px]\" data-kid=\"1-2-1-1-2-3-1\" data-name=\"run test icon\">\n                        </i>\n                        Run test\n                        <i aria-hidden=\"true\" class=\"ti ti-chevron-down text-[13px] text-[var(--muted)]\" data-kid=\"1-2-1-1-2-3-2\" data-name=\"run test chevron\">\n                        </i>\n                    </button>\n                </div>\n            </header>\n            <div class=\"flex flex-col gap-4\" data-kid=\"1-2-1-2\" data-name=\"profile groups container\">\n                <section class=\"group-card overflow-visible rounded-[10px] border border-[var(--hairline)] bg-[var(--surface)]\" data-group-card=\"\" data-kid=\"1-2-1-2-1\" data-name=\"default profile group card\" data-open=\"true\">\n                    <div class=\"group-header flex min-h-[74px] items-center justify-between gap-5 border-b border-[var(--hairline)] px-5\" data-kid=\"1-2-1-2-1-1\" data-name=\"default group header\">\n                        <button aria-expanded=\"true\" class=\"group-trigger flex min-w-0 flex-1 items-center gap-3 rounded-[8px] py-2 text-left\" data-group-trigger=\"\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"default group trigger\" type=\"button\">\n                            <span class=\"flex size-6 shrink-0 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-2-1-2-1-1-1-1\" data-name=\"default group chevron\">\n                                <i aria-hidden=\"true\" class=\"group-chevron ti ti-chevron-down\" data-kid=\"1-2-1-2-1-1-1-1-1\" data-name=\"default group chevron icon\">\n                                </i>\n                            </span>\n                            <span class=\"min-w-0\" data-kid=\"1-2-1-2-1-1-1-2\" data-name=\"default group header info\">\n                                <span class=\"block truncate font-['Inter_Tight'] text-[17px] font-semibold tracking-[-0.015em]\" data-kid=\"1-2-1-2-1-1-1-2-1\" data-name=\"default group title\">\n                                    Default\n                                </span>\n                                <span class=\"mt-1 block text-[12px] text-[var(--muted)]\" data-kid=\"1-2-1-2-1-1-1-2-2\" data-name=\"default group stats\">\n                                    2 profiles · single keys start here\n                                </span>\n                            </span>\n                        </button>\n                        <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"default group actions\">\n                            <span class=\"flex items-center gap-2 font-['IBM_Plex_Mono'] text-[10px] uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-2-1-1-2-1\" data-name=\"default group meta\">\n                                <i aria-hidden=\"true\" class=\"ti ti-device-desktop-cog text-[14px]\" data-kid=\"1-2-1-2-1-1-2-1-1\" data-name=\"default group meta icon\">\n                                </i>\n                                Default group\n                            </span>\n                            <button aria-label=\"More actions for Default\" class=\"icon-button flex size-9 items-center justify-center rounded-[8px] text-[17px] text-[var(--muted)] transition-colors\" data-kid=\"1-2-1-2-1-1-2-2\" data-name=\"default group more button\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-dots\" data-kid=\"1-2-1-2-1-1-2-2-1\" data-name=\"default group more icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"group-panel\" data-kid=\"1-2-1-2-1-2\" data-name=\"default group panel\">\n                        <div class=\"grid grid-cols-[58px_minmax(0,1fr)_108px_122px_126px_100px_54px] items-center border-b border-[var(--hairline)] px-5 py-3 text-[10px] font-medium uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"default group table header\">\n                            <span data-kid=\"1-2-1-2-1-2-1-1\">\n                                Order\n                            </span>\n                            <span data-kid=\"1-2-1-2-1-2-1-2\">\n                                Profile\n                            </span>\n                            <span data-kid=\"1-2-1-2-1-2-1-3\">\n                                Protocol\n                            </span>\n                            <span data-kid=\"1-2-1-2-1-2-1-4\">\n                                TCP\n                            </span>\n                            <span data-kid=\"1-2-1-2-1-2-1-5\">\n                                URL\n                            </span>\n                            <span data-kid=\"1-2-1-2-1-2-1-6\">\n                                Use\n                            </span>\n                            <span data-kid=\"1-2-1-2-1-2-1-7\">\n                            </span>\n                        </div>\n                        <div class=\"profile-row grid min-h-[75px] grid-cols-[58px_minmax(0,1fr)_108px_122px_126px_100px_54px] items-center border-b border-white/[0.055] px-5 text-[var(--body)]\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"default group first row\" data-selected=\"true\">\n                            <div class=\"flex items-center gap-2 font-['IBM_Plex_Mono'] text-[12px] text-[var(--muted)]\" data-kid=\"1-2-1-2-1-2-2-1\" data-name=\"default group first row order\">\n                                <span data-kid=\"1-2-1-2-1-2-2-1-1\" data-name=\"default group first row number\">\n                                    1\n                                </span>\n                                <button aria-label=\"Drag Seattle 03 to reorder\" class=\"icon-button flex size-7 items-center justify-center rounded-[6px] text-[15px]\" data-kid=\"1-2-1-2-1-2-2-1-2\" data-name=\"default group first row drag handle\" draggable=\"tru