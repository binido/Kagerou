    "var_844ef6033d4a": {
      "type": "variant",
      "label": "Kagerou — Settings",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 8280,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Inter+Tight:wght@500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .lunar-settings {\n    --canvas: #1A1B1E;\n    --sidebar: #17181B;\n    --surface: #222329;\n    --raised: #292A31;\n    --selected: #312E3B;\n    --accent: #AA9BD7;\n    --accent-highlight: #C3B7E6;\n    --primary: #F2F0F6;\n    --body: #C8C5D0;\n    --metadata: #918D99;\n    --divider: rgba(255, 255, 255, 0.055);\n    --font-body: 'Inter', sans-serif;\n    --font-display: 'Inter Tight', sans-serif;\n    font-family: var(--font-body);\n  }\n\n  .lunar-settings .nav-item,\n  .lunar-settings .sidebar-action,\n  .lunar-settings .theme-option,\n  .lunar-settings .settings-select,\n  .lunar-settings .switch-control {\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .lunar-settings .nav-item,\n  .lunar-settings .sidebar-action,\n  .lunar-settings .theme-option {\n    transition: color 150ms ease, background-color 150ms ease;\n  }\n\n  .lunar-settings .settings-row:last-child {\n    border-bottom-width: 0;\n  }\n\n  .lunar-settings .nav-item:hover,\n  .lunar-settings .sidebar-action:hover {\n    background: #232429;\n    color: var(--primary);\n  }\n\n  .lunar-settings .nav-item:focus-visible,\n  .lunar-settings .sidebar-action:focus-visible,\n  .lunar-settings .theme-option:focus-visible,\n  .lunar-settings .settings-select:focus-visible,\n  .lunar-settings .switch-control:focus-visible {\n    outline: 2px solid var(--accent);\n    outline-offset: 3px;\n  }\n\n  .lunar-settings .theme-option {\n    color: var(--metadata);\n  }\n\n  .lunar-settings .theme-option.is-selected {\n    background: var(--selected);\n    color: var(--primary);\n    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.14);\n  }\n\n  .lunar-settings .settings-select:hover {\n    background: var(--raised);\n    color: var(--primary);\n  }\n\n  .lunar-settings .switch-control {\n    background: var(--raised);\n    transition: background-color 200ms ease;\n  }\n\n  .lunar-settings .switch-thumb {\n    transition: transform 200ms ease;\n  }\n\n  .lunar-settings .switch-control[data-on='true'] {\n    background: var(--accent);\n  }\n\n  .lunar-settings .switch-control[data-on='true'] .switch-thumb {\n    transform: translateX(16px);\n    background: #222329;\n  }\n\n  .lunar-settings .switch-control[data-on='false'] .switch-thumb {\n    transform: translateX(0);\n    background: #918D99;\n  }\n\n  .lunar-settings.is-collapsed > aside {\n    width: 68px;\n  }\n\n  .lunar-settings.is-collapsed .sidebar-wordmark,\n  .lunar-settings.is-collapsed .nav-label,\n  .lunar-settings.is-collapsed .sidebar-button-label {\n    display: none;\n  }\n\n  .lunar-settings.is-collapsed .brand-row,\n  .lunar-settings.is-collapsed .nav-item,\n  .lunar-settings.is-collapsed .sidebar-action {\n    justify-content: center;\n    padding-left: 0;\n    padding-right: 0;\n  }\n</style>\n<div class=\"lunar-settings flex min-h-screen min-w-[960px] overflow-x-clip bg-[var(--canvas)] text-[var(--body)]\" data-kid=\"2\" data-name=\"app settings container\" id=\"kagerou-settings\">\n    <aside class=\"flex w-[216px] shrink-0 flex-col border-r border-white/[0.03] bg-[var(--sidebar)] px-3 py-5\" data-kid=\"2-1\" data-name=\"sidebar container\">\n        <div class=\"brand-row flex h-9 items-center gap-3 px-3\" data-kid=\"2-1-1\" data-name=\"brand logo container\">\n            <svg aria-hidden=\"true\" class=\"h-7 w-7 shrink-0 text-[var(--primary)]\" data-kid=\"2-1-1-1\" data-name=\"brand logo icon\" fill=\"none\" viewbox=\"0 0 28 28\">\n                <path d=\"M21.6 4.8c-4.5 4-4.5 14.4 0 18.4A11.4 11.4 0 1 1 21.6 4.8Z\" fill=\"currentColor\">\n                </path>\n            </svg>\n            <span class=\"sidebar-wordmark font-[var(--font-display)] text-[15px] font-semibold tracking-[-0.01em] text-[var(--primary)]\" data-kid=\"2-1-1-2\" data-name=\"brand name text\">\n                Kagerou\n            </span>\n        </div>\n        <nav aria-label=\"Primary navigation\" class=\"mt-9 space-y-1\" data-kid=\"2-1-2\" data-name=\"primary navigation\">\n            <button class=\"nav-item flex h-10 w-full items-center gap-3 rounded-[8px] px-3 text-left text-[13px] text-[var(--body)]\" data-kid=\"2-1-2-1\" data-name=\"dashboard navigation button\" type=\"button\">\n                <span class=\"text-[18px] leading-none text-[var(--metadata)]\" data-kid=\"2-1-2-1-1\" data-name=\"dashboard icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard inline-block h-[1em] w-[1em]\" data-kid=\"2-1-2-1-1-1\" data-name=\"dashboard icon\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"2-1-2-1-2\" data-name=\"dashboard label text\">\n                    Dashboard\n                </span>\n            </button>\n            <button class=\"nav-item flex h-10 w-full items-center gap-3 rounded-[8px] px-3 text-left text-[13px] text-[var(--body)]\" data-kid=\"2-1-2-2\" data-name=\"profiles navigation button\" type=\"button\">\n                <span class=\"text-[18px] leading-none text-[var(--metadata)]\" data-kid=\"2-1-2-2-1\" data-name=\"profiles icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-server inline-block h-[1em] w-[1em]\" data-kid=\"2-1-2-2-1-1\" data-name=\"profiles icon\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"2-1-2-2-2\" data-name=\"profiles label text\">\n                    Profiles\n                </span>\n            </button>\n            <button class=\"nav-item flex h-10 w-full items-center gap-3 rounded-[8px] px-3 text-left text-[13px] text-[var(--body)]\" data-kid=\"2-1-2-3\" data-name=\"subscriptions navigation button\" type=\"button\">\n                <span class=\"text-[18px] leading-none text-[var(--metadata)]\" data-kid=\"2-1-2-3-1\" data-name=\"subscriptions icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-rss inline-block h-[1em] w-[1em]\" data-kid=\"2-1-2-3-1-1\" data-name=\"subscriptions icon\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"2-1-2-3-2\" data-name=\"subscriptions label text\">\n                    Subscriptions\n                </span>\n            </button>\n            <button class=\"nav-item flex h-10 w-full items-center gap-3 rounded-[8px] px-3 text-left text-[13px] text-[var(--body)]\" data-kid=\"2-1-2-4\" data-name=\"routing rules navigation button\" type=\"button\">\n                <span class=\"text-[18px] leading-none text-[var(--metadata)]\" data-kid=\"2-1-2-4-1\" data-name=\"routing rules icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-route inline-block h-[1em] w-[1em]\" data-kid=\"2-1-2-4-1-1\" data-name=\"routing rules icon\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"2-1-2-4-2\" data-name=\"routing rules label text\">\n                    Routing rules\n                </span>\n            </button>\n            <button class=\"nav-item flex h-10 w-full items-center gap-3 rounded-[8px] px-3 text-left text-[13px] text-[var(--body)]\" data-kid=\"2-1-2-5\" data-name=\"logs navigation button\" type=\"button\">\n                <span class=\"text-[18px] leading-none text-[var(--metadata)]\" data-kid=\"2-1-2-5-1\" data-name=\"logs icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-file-text inline-block h-[1em] w-[1em]\" data-kid=\"2-1-2-5-1-1\" data-name=\"logs icon\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"2-1-2-5-2\" data-name=\"logs label text\">\n                    Logs\n                </span>\n            </button>\n            <button aria-current=\"page\" class=\"nav-item flex h-10 w-full items-center gap-3 rounded-[8px] bg-[var(--selected)] px-3 text-left text-[13px] text-[var(--primary)]\" data-kid=\"2-1-2-6\" data-name=\"settings navigation button\" type=\"button\">\n                <span class=\"text-[18px] leading-none text-[var(--accent)]\" data-kid=\"2-1-2-6-1\" data-name=\"settings icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-settings inline-block h-[1em] w-[1em]\" data-kid=\"2-1-2-6-1-1\" data-name=\"settings icon\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"2-1-2-6-2\" data-name=\"settings label text\">\n                    Settings\n                </span>\n            </button>\n        </nav>\n        <button aria-label=\"Collapse sidebar\" class=\"sidebar-action mt-auto flex h-10 w-full items-center gap-3 rounded-[8px] px-3 text-left text-[13px] text-[var(--metadata)]\" data-collapse-sidebar=\"\" data-dynamic=\"true\" data-kid=\"2-1-3\" data-name=\"collapse sidebar button\" data-reason=\"aria-label and title attributes toggled by script\" type=\"button\">\n            <span class=\"text-[18px] leading-none\" data-kid=\"2-1-3-1\" data-name=\"collapse icon container\">\n                <i aria-hidden=\"true\" class=\"ti ti-layout-sidebar-left-collapse inline-block h-[1em] w-[1em]\" data-kid=\"2-1-3-1-1\" data-name=\"collapse sidebar icon\">\n                </i>\n            </span>\n            <span class=\"sidebar-button-label\" data-kid=\"2-1-3-2\" data-name=\"collapse button label text\">\n                Collapse sidebar\n            </span>\n        </button>\n    </aside>\n    <main class=\"min-w-0 flex-1 px-[68px] py-[52px]\" data-kid=\"2-2\" data-name=\"main content area\" id=\"settings\">\n        <div class=\"max-w-[920px]\" data-kid=\"2-2-1\" data-name=\"settings panel container\">\n            <header class=\"flex items-end justify-between\" data-kid=\"2-2-1-1\" data-name=\"header section\">\n                <h1 class=\"font-[var(--font-display)] text-[28px] font-semibold leading-none tracking-[-0.035em] text-[var(--primary)]\" data-kid=\"2-2-1-1-1\" data-name=\"settings title\">\n                    Settings\n                </h1>\n                <p class=\"mb-0.5 text-[12px] leading-4 text-[var(--metadata)]\" data-kid=\"2-2-1-1-2\" data-name=\"instant update status text\">\n                    Changes apply instantly\n                </p>\n            </header>\n            <div class=\"mt-12 w-[680px] max-w-full\" data-kid=\"2-2-1-2\" data-name=\"settings options list\">\n                <section aria-labelledby=\"appearance-heading\" data-kid=\"2-2-1-2-1\" data-name=\"appearance settings section\">\n                    <h2 class=\"mb-3 text-[11px] font-medium uppercase tracking-[0.14em] text-[var(--metadata)]\" data-kid=\"2-2-1-2-1-1\" data-name=\"appearance section heading\" id=\"appearance-heading\">\n                        Appearance\n                    </h2>\n                    <div data-kid=\"2-2-1-2-1-2\" data-name=\"appearance settings rows\">\n                        <div class=\"settings-row flex h-14 items-center justify-between border-b border-[var(--divider)]\" data-kid=\"2-2-1-2-1-2-1\" data-name=\"theme selection row\">\n                            <span class=\"text-[14px] leading-5 text-[var(--body)]\" data-kid=\"2-2-1-2-1-2-1-1\" data-name=\"theme label\">\n                                Theme\n                            </span>\n                            <div aria-label=\"Theme\" class=\"flex rounded-[8px] bg-[var(--surface)] p-1\" data-kid=\"2-2-1-2-1-2-1-2\" data-name=\"theme switcher toggle group\" role=\"group\">\n                                <button aria-pressed=\"true\" class=\"theme-option is-selected h-8 rounded-[6px] px-4 text-[13px] font-medium leading-8\" data-dynamic=\"true\" data-kid=\"2-2-1-2-1-2-1-2-1\" data-name=\"dark theme option button\" data-reason=\"aria-pressed and is-selected class toggled by script\" data-theme-option=\"dark\" type=\"button\">\n                                    Dark\n                                </button>\n                                <button aria-pressed=\"false\" class=\"theme-option h-8 rounded-[6px] px-4 text-[13px] font-medium leading-8\" data-dynamic=\"true\" data-kid=\"2-2-1-2-1-2-1-2-2\" data-name=\"light theme option button\" data-reason=\"aria-pressed and is-selected class toggled by script\" data-theme-option=\"light\" type=\"button\">\n                                    Light\n                                </button>\n                            </div>\n                        </div>\n                        <div class=\"settings-row flex h-14 items-center justify-between border-b border-[var(--divider)]\" data-kid=\"2-2-1-2-1-2-2\" data-name=\"language selection row\">\n                            <label class=\"text-[14px] leading-5 text-[var(--body)]\" data-kid=\"2-2-1-2-1-2-2-1\" data-name=\"language label\" for=\"language\">\n                                Language\n                            </label>\n                            <span class=\"relative block\" data-kid=\"2-2-1-2-1-2-2-2\" data-name=\"language select container\">\n                                <select aria-label=\"Language\" class=\"settings-select h-9 w-[148px] appearance-none rounded-[8px] bg-[var(--surface)] px-3 pr-9 text-[13px] text-[var(--body)]\" data-kid=\"2-2-1-2-1-2-2-2-1\" data-name=\"language select dropdown\" id=\"language\">\n                                    <option data-kid=\"2-2-1-2-1-2-2-2-1-1\">\n                                        English\n                                    </option>\n                                    <option data-kid=\"2-2-1-2-1-2-2-2-1-2\">\n                                        中文\n                                    </option>\n                                    <option data-kid=\"2-2-1-2-1-2-2-2-1-3\">\n                                        日本語\n                                    </option>\n                                </select>\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-down pointer-events-none absolute right-3 top-1/2 inline-block h-[1em] w-[1em] -translate-y-1/2 text-[16px] leading-none text-[var(--metadata)]\" data-kid=\"2-2-1-2-1-2-2-2-2\" data-name=\"chevron down icon\">\n                                </i>\n                            </span>\n                        </div>\n                    </div>\n                </section>\n                <section aria-labelledby=\"startup-heading\" class=\"mt-9\" data-kid=\"2-2-1-2-2\" data-name=\"startup settings section\">\n                    <h2 class=\"mb-3 text-[11px] font-medium uppercase tracking-[0.14em] text-[var(--metadata)]\" data-kid=\"2-2-1-2-2-1\" data-name=\"startup section heading\" id=\"startup-heading\">\n                        Startup\n                    </h2>\n                    <div data-kid=\"2-2-1-2-2-2\" data-name=\"startup settings rows\">\n                        <div class=\"settings-row flex h-14 items-center justify-between border-b border-[var(--divider)]\" data-kid=\"2-2-1-2-2-2-1\" data-name=\"start automatically row\">\n                            <span class=\"text-[14px] leading-5 text-[var(--body)]\" data-kid=\"2-2-1-2-2-2-1-1\" data-name=\"start automatically label\">\n                                Start automatically\n                            </span>\n                            <button aria-checked=\"true\" aria-label=\"Start automatically\" class=\"switch-control relative h-5 w-9 rounded-full\" data-dynamic=\"true\" data-kid=\"2-2-1-2-2-2-1-2\" data-name=\"start automatically switch button\" data-on=\"true\" data-reason=\"data-on attribute and aria-checked attribute toggled by script\" data-switch=\"startup\" role=\"switch\" type=\"button\">\n                                <span aria-hidden=\"true\" class=\"switch-thumb absolute left-0.5 top-0.5 h-4 w-4 rounded-full\" data-kid=\"2-2-1-2-2-2-1-2-1\" data-name=\"switch toggle thumb\">\n                                </span>\n                            </button>\n                        </div>\n                    </div>\n                </section>\n                <section aria-labelledby=\"network-heading\" class=\"mt-9\" data-kid=\"2-2-1-2-3\" data-name=\"network settings section\">\n                    <h2 class=\"mb-3 text-[11px] font-medium uppercase tracking-[0.14em] text-[var(--metadata)]\" data-kid=\"2-2-1-2-3-1\" data-name=\"network section heading\" id=\"network-heading\">\n                        Network\n                    </h2>\n                    <div data-kid=\"2-2-1-2-3-2\" data-name=\"network settings rows\">\n                        <div class=\"settings-row flex h-14 items-center justify-between border-b border-[var(--divider)]\" data-kid=\"2-2-1-2-3-2-1\" data-name=\"tun interface selection row\">\n                            <label class=\"text-[14px] leading-5 text-[var(--body)]\" data-kid=\"2-2-1-2-3-2-1-1\" data-name=\"tun interface label\" for=\"tun-interface\">\n                                TUN interface\n                            </label>\n                            <span class=\"relative block\" data-kid=\"2-2-1-2-3-2-1-2\" data-name=\"tun interface select container\">\n                                <select aria-label=\"TUN interface\" class=\"settings-select h-9 w-[148px] appearance-none rounded-[8px] bg-[var(--surface)] px-3 pr-9 text-[13px] text-[var(--body)]\" data-kid=\"2-2-1-2-3-2-1-2-1\" data-name=\"tun interface select dropdown\" id=\"tun-interface\">\n                                    <option data-kid=\"2-2-1-2-3-2-1-2-1-1\">\n                                        utun / tun0\n                                    </option>\n                                    <option data-kid=\"2-2-1-2-3-2-1-2-1-2\">\n                                        utun\n                                    </option>\n                                    <option data-kid=\"2-2-1-2-3-2-1-2-1-3\">\n                                        tun0\n                                    </option>\n                                </select>\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-down pointer-events-none absolute right-3 top-1/2 inline-block h-[1em] w-[1em] -translate-y-1/2 text-[16px] leading-none text-[var(--metadata)]\" data-kid=\"2-2-1-2-3-2-1-2-2\" data-name=\"chevron down icon\">\n                                </i>\n                            </span>\n                        </div>\n                    </div>\n                </section>\n            </div>\n        </div>\n    </main>\n</div>\n<script>\n    (() => {\n    const root = document.getElementById('kagerou-settings');\n    if (!root) return;\n\n    const themeOptions = root.querySelectorAll('[data-theme-option]');\n    themeOptions.forEach((option) => {\n      option.addEventListener('click', () => {\n        themeOptions.forEach((item) => {\n          const selected = item === option;\n          item.classList.toggle('is-selected', selected);\n          item.setAttribute('aria-pressed', String(selected));\n        });\n      });\n    });\n\n    root.querySelectorAll('[data-switch]').forEach((switchControl) => {\n      switchControl.addEventListener('click', () => {\n        const nextState = switchControl.dataset.on !== 'true';\n        switchControl.dataset.on = String(nextState);\n        switchControl.setAttribute('aria-checked', String(nextState));\n      });\n    });\n\n    const collapseButton = root.querySelector('[data-collapse-sidebar]');\n    collapseButton?.addEventListener('click', () => {\n      const collapsed = root.classList.toggle('is-collapsed');\n      collapseButton.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');\n      collapseButton.setAttribute('title', collapsed ? 'Expand sidebar' : 'Collapse sidebar');\n    });\n  })();\n</script>\n",
