        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Inter+Tight:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .kagerou-sources-design { --canvas:#1a1b1e; --sidebar:#17181b; --surface:#222329; --raised:#292a31; --selected:#312e3b; --row-hover:#282930; --hairline:#2a2b31; --primary:#f2f0f6; --body:#c8c5d0; --muted:#918d99; --lavender:#aa9bd7; --lavender-hi:#c3b7e6; --ink:#211f27; --good:#70b68e; --warn:#d1aa64; --bad:#cf747b; color-scheme:dark; font-family:'Inter',sans-serif; }\n  .kagerou-sources-design [hidden] { display:none; }\n  .kagerou-sources-design button:focus-visible, .kagerou-sources-design a:focus-visible, .kagerou-sources-design input:focus-visible, .kagerou-sources-design select:focus-visible { outline:2px solid var(--lavender); outline-offset:3px; }\n  .kagerou-sources-design .nav-item:hover, .kagerou-sources-design .nav-item:focus-visible, .kagerou-sources-design .icon-button:hover, .kagerou-sources-design .icon-button:focus-visible { background:var(--row-hover); color:var(--primary); }\n  .kagerou-sources-design .nav-item[aria-current='page'] { background:var(--selected); color:var(--primary); }\n  .kagerou-sources-design .nav-item[aria-current='page'] .nav-icon { color:var(--lavender); }\n  .kagerou-sources-design .source-card:hover { background:var(--row-hover); border-color:#3a3942; }\n  .kagerou-sources-design .source-menu, .kagerou-sources-design .source-modal { box-shadow:0 18px 40px rgba(0,0,0,.3); }\n  .kagerou-sources-design .source-modal[hidden], .kagerou-sources-design .source-menu[hidden] { display:none; }\n  .kagerou-sources-design .type-option[data-selected='true'] { background:var(--selected); color:var(--primary); }\n  .kagerou-sources-design .sidebar { transition:width 180ms ease,padding 180ms ease; }\n  .kagerou-sources-design.is-collapsed .sidebar { width:68px; padding-left:12px; padding-right:12px; }\n  .kagerou-sources-design.is-collapsed .wordmark, .kagerou-sources-design.is-collapsed .nav-label, .kagerou-sources-design.is-collapsed .collapse-label { display:none; }\n  .kagerou-sources-design.is-collapsed .brand-row, .kagerou-sources-design.is-collapsed .nav-item, .kagerou-sources-design.is-collapsed .collapse-button { justify-content:center; padding-left:0; padding-right:0; }\n  @media (max-width:960px) { .kagerou-sources-design .sidebar { width:68px; padding-left:12px; padding-right:12px; } .kagerou-sources-design .wordmark,.kagerou-sources-design .nav-label,.kagerou-sources-design .collapse-label { display:none; } .kagerou-sources-design .brand-row,.kagerou-sources-design .nav-item,.kagerou-sources-design .collapse-button { justify-content:center; padding-left:0; padding-right:0; } .kagerou-sources-design main { padding-left:24px; padding-right:24px; } }\n</style>\n<div class=\"kagerou-sources-design flex min-h-screen min-w-[960px] w-full overflow-x-clip bg-[var(--canvas)] text-[var(--primary)] antialiased\" data-kid=\"1\" data-name=\"sources app layout\" id=\"sources-design\">\n    <aside aria-label=\"Primary navigation\" class=\"sidebar flex w-[216px] shrink-0 flex-col border-r border-[var(--hairline)] bg-[var(--sidebar)] px-3 py-6\" data-kid=\"1-1\" data-name=\"primary sidebar\">\n        <div class=\"brand-row mb-11 flex items-center gap-3 px-3\" data-kid=\"1-1-1\" data-name=\"brand header row\">\n            <span aria-hidden=\"true\" class=\"relative flex h-9 w-9 shrink-0 items-center justify-center\" data-kid=\"1-1-1-1\" data-name=\"logo container\">\n                <span class=\"absolute left-0 top-0 h-8 w-8 rounded-full bg-[var(--lavender)]\" data-kid=\"1-1-1-1-1\" data-name=\"logo circle background\">\n                </span>\n                <span class=\"absolute right-0 top-0.5 h-7 w-7 translate-x-1 rounded-full bg-[var(--sidebar)]\" data-kid=\"1-1-1-1-2\" data-name=\"logo overlay circle\">\n                </span>\n            </span>\n            <span class=\"wordmark min-w-0\" data-kid=\"1-1-1-2\" data-name=\"brand name and subtitle group\">\n                <span class=\"block font-['Inter_Tight'] text-[18px] font-semibold leading-none tracking-[-0.02em]\" data-kid=\"1-1-1-2-1\" data-name=\"brand name\">\n                    Kagerou\n                </span>\n                <span class=\"mt-2 block text-[9px] uppercase tracking-[0.2em] text-[var(--muted)]\" data-kid=\"1-1-1-2-2\" data-name=\"brand subtitle\">\n                    Instrument panel\n                </span>\n            </span>\n        </div>\n        <nav aria-label=\"Primary navigation\" class=\"flex flex-col gap-1\" data-kid=\"1-1-2\" data-name=\"navigation link list\">\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-1\" data-name=\"dashboard navigation link\" href=\"#dashboard\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-1-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard\" data-kid=\"1-1-2-1-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-1-2\">\n                    Dashboard\n                </span>\n            </a>\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-2\" data-name=\"profiles navigation link\" href=\"#profiles\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-2-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-server\" data-kid=\"1-1-2-2-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-2-2\">\n                    Profiles\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] font-medium text-[var(--primary)] transition-colors\" data-kid=\"1-1-2-3\" data-name=\"sources navigation link\" href=\"#sources\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px]\" data-kid=\"1-1-2-3-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-rss\" data-kid=\"1-1-2-3-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-3-2\">\n                    Sources\n                </span>\n            </a>\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-4\" data-name=\"routing rules navigation link\" href=\"#routing-rules\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-4-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-route\" data-kid=\"1-1-2-4-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-4-2\">\n                    Routing rules\n                </span>\n            </a>\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-5\" data-name=\"logs navigation link\" href=\"#logs\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-5-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-file-text\" data-kid=\"1-1-2-5-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-5-2\">\n                    Logs\n                </span>\n            </a>\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-6\" data-name=\"settings navigation link\" href=\"#settings\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-6-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-settings\" data-kid=\"1-1-2-6-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-6-2\">\n                    Settings\n                </span>\n            </a>\n        </nav>\n        <button aria-expanded=\"true\" aria-label=\"Collapse sidebar\" class=\"collapse-button icon-button mt-auto flex h-10 w-full items-center gap-3 rounded-[8px] px-3 text-left text-[13px] text-[var(--muted)] transition-colors\" data-collapse-sidebar=\"\" data-kid=\"1-1-3\" data-name=\"sidebar collapse button\" type=\"button\">\n            <span class=\"flex size-5 items-center justify-center text-[18px]\" data-kid=\"1-1-3-1\" data-name=\"collapse button icon\">\n                <i aria-hidden=\"true\" class=\"ti ti-layout-sidebar-left-collapse\" data-kid=\"1-1-3-1-1\">\n                </i>\n            </span>\n            <span class=\"collapse-label\" data-kid=\"1-1-3-2\" data-name=\"collapse button label\">\n                Collapse sidebar\n            </span>\n        </button>\n    </aside>\n    <main class=\"min-w-0 flex-1 bg-[var(--canvas)] px-12 pb-12 pt-10\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mx-auto w-full max-w-[1040px]\" data-kid=\"1-2-1\" data-name=\"sources page container\" id=\"sources\">\n            <header class=\"flex items-start justify-between gap-8\" data-kid=\"1-2-1-1\" data-name=\"sources page header\">\n                <div data-kid=\"1-2-1-1-1\" data-name=\"page breadcrumb and title group\">\n                    <div class=\"flex items-center gap-2 text-[10px] font-medium uppercase tracking-[0.18em] text-[var(--muted)]\" data-kid=\"1-2-1-1-1-1\" data-name=\"breadcrumb container\">\n                        <span data-kid=\"1-2-1-1-1-1-1\">\n                            Kagerou\n                        </span>\n                        <span class=\"text-[#5e5b66]\" data-kid=\"1-2-1-1-1-1-2\">\n                            /\n                        </span>\n                        <span data-kid=\"1-2-1-1-1-1-3\">\n                            Profile sources\n                        </span>\n                    </div>\n                    <h1 class=\"mt-3 font-['Inter_Tight'] text-[34px] font-semibold leading-none tracking-[-0.04em]\" data-kid=\"1-2-1-1-1-2\" data-name=\"page title\">\n                        Sources\n                    </h1>\n                    <p class=\"mt-3 max-w-[610px] text-[13px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-1-1-1-3\" data-name=\"page description\">\n                        Manage subscriptions and single keys that provide profiles to Kagerou.\n                    </p>\n                </div>\n                <div class=\"relative mt-1 shrink-0\" data-kid=\"1-2-1-1-2\" data-name=\"add source menu container\">\n                    <button aria-expanded=\"false\" class=\"inline-flex h-10 items-center gap-2 rounded-[8px] bg-[var(--lavender)] px-4 text-[13px] font-semibold text-[var(--ink)] transition-colors hover:bg-[var(--lavender-hi)]\" data-add-source=\"\" data-kid=\"1-2-1-1-2-1\" data-name=\"add source trigger button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-plus text-[16px]\" data-kid=\"1-2-1-1-2-1-1\">\n                        </i>\n                        Add source\n                        <i aria-hidden=\"true\" class=\"ti ti-chevron-down text-[14px]\" data-kid=\"1-2-1-1-2-1-2\">\n                        </i>\n                    </button>\n                    <div aria-label=\"Source type\" class=\"source-menu absolute right-0 top-12 z-30 w-[294px] overflow-hidden rounded-[10px] border border-[var(--hairline)] bg-[var(--raised)]\" data-dynamic=\"true\" data-kid=\"1-2-1-1-2-2\" data-name=\"add source overflow menu\" data-reason=\"hidden state toggled by script\" data-source-menu=\"\" hidden=\"\" role=\"menu\">\n                        <div class=\"border-b border-[var(--hairline)] px-4 py-3\" data-kid=\"1-2-1-1-2-2-1\">\n                            <p class=\"text-[10px] font-medium uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-1-2-2-1-1\">\n                                Add a source\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[var(--body)]\" data-kid=\"1-2-1-1-2-2-1-2\">\n                                Choose how Kagerou receives profiles.\n                            </p>\n                        </div>\n                        <button class=\"flex w-full items-start gap-3 px-4 py-3 text-left text-[var(--body)] hover:bg-[var(--row-hover)]\" data-kid=\"1-2-1-1-2-2-2\" data-source-kind=\"url\" role=\"menuitem\" type=\"button\">\n                            <span class=\"mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-[7px] bg-[var(--selected)] text-[16px] text-[var(--lavender-hi)]\" data-kid=\"1-2-1-1-2-2-2-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-rss\" data-kid=\"1-2-1-1-2-2-2-1-1\">\n                                </i>\n                            </span>\n                            <span data-kid=\"1-2-1-1-2-2-2-2\">\n                                <span class=\"block text-[13px] font-medium text-[var(--primary)]\" data-kid=\"1-2-1-1-2-2-2-2-1\">\n                                    Subscription URL\n                                </span>\n                                <span class=\"mt-1 block text-[11px] leading-4 text-[var(--muted)]\" data-kid=\"1-2-1-1-2-2-2-2-2\">\n                                    Import every VPN into one locked subscription group.\n                                </span>\n                            </span>\n                        </button>\n                        <button class=\"flex w-full items-start gap-3 border-t border-[var(--hairline)] px-4 py-3 text-left text-[var(--body)] hover:bg-[var(--row-hover)]\" data-kid=\"1-2-1-1-2-2-3\" data-source-kind=\"key\" role=\"menuitem\" type=\"button\">\n                            <span class=\"mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-[7px] bg-[var(--selected)] text-[16px] text-[var(--good)]\" data-kid=\"1-2-1-1-2-2-3-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-key\" data-kid=\"1-2-1-1-2-2-3-1-1\">\n                                </i>\n                            </span>\n                            <span data-kid=\"1-2-1-1-2-2-3-2\">\n                                <span class=\"block text-[13px] font-medium text-[var(--primary)]\" data-kid=\"1-2-1-1-2-2-3-2-1\">\n                                    Single key\n                                </span>\n                                <span class=\"mt-1 block text-[11px] leading-4 text-[var(--muted)]\" data-kid=\"1-2-1-1-2-2-3-2-2\">\n                                    Add one local profile to Default.\n                                </span>\n                            </span>\n                        </button>\n                    </div>\n                </div>\n            </header>\n            <div class=\"mt-8 flex items-center justify-between border-b border-[var(--hairline)] pb-3\" data-kid=\"1-2-1-2\" data-name=\"source statistics bar\">\n                <p class=\"font-['IBM_Plex_Mono'] text-[11px] text-[var(--body)]\" data-kid=\"1-2-1-2-1\">\n                    3 sources\n                    <span class=\"px-1.5 text-[var(--quiet)]\" data-kid=\"1-2-1-2-1-1\">\n                        ·\n                    </span>\n                    8 profiles\n                </p>\n                <p class=\"flex items-center gap-2 text-[11px] text-[var(--muted)]\" data-kid=\"1-2-1-2-2\">\n                    <i aria-hidden=\"true\" class=\"ti ti-info-circle text-[14px]\" data-kid=\"1-2-1-2-2-1\">\n                    </i>\n                    Groups and order live on Profiles\n                </p>\n            </div>\n            <section aria-label=\"Profile sources\" class=\"mt-4 space-y-3\" data-kid=\"1-2-1-3\" data-name=\"source list section\">\n                <article class=\"source-card rounded-[10px] border border-[var(--hairline)] bg-[var(--surface)] p-5 transition-colors\" data-kid=\"1-2-1-3-1\" data-name=\"personal subscription source card\" data-source-type=\"url\">\n                    <div class=\"flex items-start justify-between gap-5\" data-kid=\"1-2-1-3-1-1\">\n                        <div class=\"flex min-w-0 items-start gap-3.5\" data-kid=\"1-2-1-3-1-1-1\">\n                            <span class=\"flex size-10 shrink-0 items-center justify-center rounded-[9px] bg-[var(--raised)] text-[19px] text-[var(--lavender-hi)]\" data-kid=\"1-2-1-3-1-1-1-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-rss\" data-kid=\"1-2-1-3-1-1-1-1-1\">\n                                </i>\n                            </span>\n                            <div class=\"min-w-0\" data-kid=\"1-2-1-3-1-1-1-2\">\n                                <div class=\"flex flex-wrap items-center gap-2.5\" data-kid=\"1-2-1-3-1-1-1-2-1\">\n                                    <h2 class=\"font-['Inter_Tight'] text-[18px] font-semibold tracking-[-0.02em]\" data-kid=\"1-2-1-3-1-1-1-2-1-1\">\n                                        Personal / North America\n                                    </h2>\n                                    <span class=\"rounded-full bg-[rgba(112,182,142,.12)] px-2 py-1 text-[10px] font-medium text-[var(--good)]\" data-kid=\"1-2-1-3-1-1-1-2-1-2\">\n                                        Up to date\n                                    </span>\n                                </div>\n                                <p class=\"mt-1 text-[11px] text-[var(--muted)]\" data-kid=\"1-2-1-3-1-1-1-2-2\">\n                                    Subscription URL\n                                    <span class=\"px-1.5 text-[var(--quiet)]\" data-kid=\"1-2-1-3-1-1-1-2-2-1\">\n                                        ·\n                                    </span>\n                                    Remote URL\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"1-2-1-3-1-1-2\">\n                            <button class=\"inline-flex h-9 items-center gap-2 rounded-[8px] border border-[var(--hairline)] px-3 text-[11px] text-[var(--body)] hover:bg-[var(--raised)]\" data-kid=\"1-2-1-3-1-1-2-1\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-refresh text-[15px]\" data-kid=\"1-2-1-3-1-1-2-1-1\">\n                                </i>\n                                Refresh\n                            </button>\n                            <button aria-label=\"More actions for Personal / North America\" class=\"icon-button flex size-9 items-center justify-center rounded-[8px] border border-[var(--hairline)] text-[17px] text-[var(--body)]\" data-kid=\"1-2-1-3-1-1-2-2\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-dots\" data-kid=\"1-2-1-3-1-1-2-2-1\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 flex items-center gap-2 rounded-[8px] border border-[var(--hairline)] bg-[var(--canvas)] px-3 py-2.5\" data-kid=\"1-2-1-3-1-2\">\n                        <i aria-hidden=\"true\" class=\"ti ti-link text-[15px] text-[var(--muted)]\" data-kid=\"1-2-1-3-1-2-1\">\n                        </i>\n                        <code class=\"min-w-0 truncate font-['IBM_Plex_Mono'] text-[11px] text-[var(--body)]\" data-kid=\"1-2-1-3-1-2-2\">\n                            https://vpn.example.com/personal\n                        </code>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-3 gap-5 border-t border-[var(--hairline)] pt-3.5\" data-kid=\"1-2-1-3-1-3\">\n                        <div data-kid=\"1-2-1-3-1-3-1\">\n                            <p class=\"text-[10px] uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-3-1-3-1-1\">\n                                Profiles\n                            </p>\n                            <p class=\"mt-1 text-[13px] font-medium\" data-kid=\"1-2-1-3-1-3-1-2\">\n                                4 profiles\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-1-3-1-3-2\">\n                            <p class=\"text-[10px] uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-3-1-3-2-1\">\n                                Group\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[var(--body)]\" data-kid=\"1-2-1-3-1-3-2-2\">\n                                Personal / North America\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-1-3-1-3-3\">\n                            <p class=\"text-[10px] uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-3-1-3-3-1\">\n                                Last refresh\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[var(--body)]\" data-kid=\"1-2-1-3-1-3-3-2\">\n                                Updated 12 min ago\n                            </p>\n                        </div>\n                    </div>\n                    <p class=\"mt-3 flex items-center gap-1.5 text-[11px] text-[var(--muted)]\" data-kid=\"1-2-1-3-1-4\">\n                        <i aria-hidden=\"true\" class=\"ti ti-lock text-[13px] text-[var(--good)]\" data-kid=\"1-2-1-3-1-4-1\">\n                        </i>\n                        Creates a locked group on\n                        <span class=\"text-[var(--body)]\" data-kid=\"1-2-1-3-1-4-2\">\n                            Profiles\n                        </span>\n                    </p>\n                </article>\n                <article class=\"source-card rounded-[10px] border border-[var(--hairline)] bg-[var(--surface)] p-5 transition-colors\" data-kid=\"1-2-1-3-2\" data-name=\"emergency key source card\" data-source-type=\"key\">\n                    <div class=\"flex items-start justify-between gap-5\" data-kid=\"1-2-1-3-2-1\">\n                        <div class=\"flex min-w-0 items-start gap-3.5\" data-kid=\"1-2-1-3-2-1-1\">\n                            <span class=\"flex size-10 shrink-0 items-center justify-center rounded-[9px] bg-[var(--raised)] text-[19px] text-[var(--good)]\" data-kid=\"1-2-1-3-2-1-1-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-key\" data-kid=\"1-2-1-3-2-1-1-1-1\">\n                                </i>\n                            </span>\n                            <div class=\"min-w-0\" data-kid=\"1-2-1-3-2-1-1-2\">\n                                <div class=\"flex flex-wrap items-center gap-2.5\" data-kid=\"1-2-1-3-2-1-1-2-1\">\n                                    <h2 class=\"font-['Inter_Tight'] text-[18px] font-semibold tracking-[-0.02em]\" data-kid=\"1-2-1-3-2-1-1-2-1-1\">\n                                        Emergency access key\n                                    </h2>\n                                    <span class=\"rounded-full bg-[rgba(170,155,215,.12)] px-2 py-1 text-[10px] font-medium text-[var(--lavender-hi)]\" data-kid=\"1-2-1-3-2-1-1-2-1-2\">\n                                        Ready\n                                    </span>\n                                </div>\n                                <p class=\"mt-1 text-[11px] text-[var(--muted)]\" data-kid=\"1-2-1-3-2-1-1-2-2\">\n                                    Single key\n                                    <span class=\"px-1.5 text-[var(--quiet)]\" data-kid=\"1-2-1-3-2-1-1-2-2-1\">\n                                        ·\n                                    </span>\n                                    Local key\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"1-2-1-3-2-1-2\">\n                            <button class=\"inline-flex h-9 items-center gap-2 rounded-[8px] border border-[var(--hairline)] px-3 text-[11px] text-[var(--body)] hover:bg-[var(--raised)]\" data-kid=\"1-2-1-3-2-1-2-1\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-refresh text-[15px]\" data-kid=\"1-2-1-3-2-1-2-1-1\">\n                                </i>\n                                Refresh\n                            </button>\n                            <button aria-label=\"More actions for Emergency access key\" class=\"icon-button flex size-9 items-center justify-center rounded-[8px] border border-[var(--hairline)] text-[17px] text-[var(--body)]\" data-kid=\"1-2-1-3-2-1-2-2\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-dots\" data-kid=\"1-2-1-3-2-1-2-2-1\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 flex items-center gap-2 rounded-[8px] border border-[var(--hairline)] bg-[var(--canvas)] px-3 py-2.5\" data-kid=\"1-2-1-3-2-2\">\n                        <i aria-hidden=\"true\" class=\"ti ti-link text-[15px] text-[var(--muted)]\" data-kid=\"1-2-1-3-2-2-1\">\n                        </i>\n                        <code class=\"min-w-0 truncate font-['IBM_Plex_Mono'] text-[11px] text-[var(--body)]\" data-kid=\"1-2-1-3-2-2-2\">\n                            vless://••••••••••••••••\n                        </code>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-3 gap-5 border-t border-[var(--hairline)] pt-3.5\" data-kid=\"1-2-1-3-2-3\">\n                        <div data-kid=\"1-2-1-3-2-3-1\">\n                            <p class=\"text-[10px] uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-3-2-3-1-1\">\n                                Profiles\n                            </p>\n                            <p class=\"mt-1 text-[13px] font-medium\" data-kid=\"1-2-1-3-2-3-1-2\">\n                                1 profile\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-1-3-2-3-2\">\n                            <p class=\"text-[10px] uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-3-2-3-2-1\">\n                                Group\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[var(--body)]\" data-kid=\"1-2-1-3-2-3-2-2\">\n                                Default\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-1-3-2-3-3\">\n                            <p class=\"text-[10px] uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-3-2-3-3-1\">\n                                Last update\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[var(--body)]\" data-kid=\"1-2-1-3-2-3-3-2\">\n                                Added just now\n                            </p>\n                        </div>\n                    </div>\n                    <p class=\"mt-3 flex items-center gap-1.5 text-[11px] text-[var(--muted)]\" data-kid=\"1-2-1-3-2-4\">\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-right text-[13px] text-[var(--lavender)]\" data-kid=\"1-2-1-3-2-4-1\">\n                        </i>\n                        This key starts in\n                        <span class=\"text-[var(--body)]\" data-kid=\"1-2-1-3-2-4-2\">\n                            Default\n                        </span>\n                        and can move to a custom group.\n                    </p>\n                </article>\n                <article class=\"source-card rounded-[10px] border border-[var(--hairline)] bg-[var(--surface)] p-5 transition-colors\" data-kid=\"1-2-1-3-3\" data-name=\"work subscription source card\" data-source-type=\"url\">\n                    <div class=\"flex items-start justify-between gap-5\" data-kid=\"1-2-1-3-3-1\">\n                        <div class=\"flex min-w-0 items-start gap-3.5\" data-kid=\"1-2-1-3-3-1-1\">\n                            <span class=\"flex size-10 shrink-0 items-center justify-center rounded-[9px] bg-[var(--raised)] text-[19px] text-[var(--lavender-hi)]\" data-kid=\"1-2-1-3-3-1-1-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-rss\" data-kid=\"1-2-1-3-3-1-1-1-1\">\n                                </i>\n                            </span>\n                            <div class=\"min-w-0\" data-kid=\"1-2-1-3-3-1-1-2\">\n                                <div class=\"flex flex-wrap items-center gap-2.5\" data-kid=\"1-2-1-3-3-1-1-2-1\">\n                                    <h2 class=\"font-['Inter_Tight'] text-[18px] font-semibold tracking-[-0.02em]\" data-kid=\"1-2-1-3-3-1-1-2-1-1\">\n                                        Work / Europe\n                                    </h2>\n                                    <span class=\"rounded-full bg-[rgba(209,170,100,.12)] px-2 py-1 text-[10px] font-medium text-[var(--warn)]\" data-kid=\"1-2-1-3-3-1-1-2-1-2\">\n                                        Refresh due\n                                    </span>\n                                </div>\n                                <p class=\"mt-1 text-[11px] text-[var(--muted)]\" data-kid=\"1-2-1-3-3-1-1-2-2\">\n                                    Subscription URL\n                                    <span class=\"px-1.5 text-[var(--quiet)]\" data-kid=\"1-2-1-3-3-1-1-2-2-1\">\n                                        ·\n                                    </span>\n                                    Remote URL\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"1-2-1-3-3-1-2\">\n                            <button class=\"inline-flex h-9 items-center gap-2 rounded-[8px] border border-[var(--hairline)] px-3 text-[11px] text-[var(--body)] hover:bg-[var(--raised)]\" data-kid=\"1-2-1-3-3-1-2-1\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-refresh text-[15px]\" data-kid=\"1-2-1-3-3-1-2-1-1\">\n                                </i>\n                                Refresh\n                            </button>\n                            <button aria-label=\"More actions for Work / Europe\" class=\"icon-button flex size-9 items-center justify-center rounded-[8px] border border-[var(--hairline)] text-[17px] text-[var(--body)]\" data-kid=\"1-2-1-3-3-1-2-2\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-dots\" data-kid=\"1-2-1-3-3-1-2-2-1\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 flex items-center gap-2 rounded-[8px] border border-[var(--hairline)] bg-[var(--canvas)] px-3 py-2.5\" data-kid=\"1-2-1-3-3-2\">\n                        <i aria-hidden=\"true\" class=\"ti ti-link text-[15px] text-[var(--muted)]\" data-kid=\"1-2-1-3-3-2-1\">\n                        </i>\n                        <code class=\"min-w-0 truncate font-['IBM_Plex_Mono'] text-[11px] text-[var(--body)]\" data-kid=\"1-2-1-3-3-2-2\">\n                            https://vpn.example.com/work\n                        </code>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-3 gap-5 border-t border-[var(--hairline)] pt-3.5\" data-kid=\"1-2-1-3-3-3\">\n                        <div data-kid=\"1-2-1-3-3-3-1\">\n                            <p class=\"text-[10px] uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-3-3-3-1-1\">\n                                Profiles\n                            </p>\n                            <p class=\"mt-1 text-[13px] font-medium\" data-kid=\"1-2-1-3-3-3-1-2\">\n                                3 profiles\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-1-3-3-3-2\">\n                            <p class=\"text-[10px] uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-3-3-3-2-1\">\n                                Group\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[var(--body)]\" data-kid=\"1-2-1-3-3-3-2-2\">\n                                Work / Europe\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-1-3-3-3-3\">\n                            <p class=\"text-[10px] uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-3-3-3-3-1\">\n                                Last refresh\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[var(--body)]\" data-kid=\"1-2-1-3-3-3-3-2\">\n                                Updated 2 days ago\n                            </p>\n                        </div>\n                    </div>\n                    <p class=\"mt-3 flex items-center gap-1.5 text-[11px] text-[var(--muted)]\" data-kid=\"1-2-1-3-3-4\">\n                        <i aria-hidden=\"true\" class=\"ti ti-lock text-[13px] text-[var(--good)]\" data-kid=\"1-2-1-3-3-4-1\">\n                        </i>\n                        Creates a locked group on\n                        <span class=\"text-[var(--body)]\" data-kid=\"1-2-1-3-3-4-2\">\n                            Profiles\n                        </span>\n                    </p>\n                </article>\n            </section>\n        </div>\n    </main>\n</div>\n<div aria-hidden=\"true\" class=\"source-modal fixed inset-0 z-50 flex items-center justify-center bg-[rgba(13,14,16,.78)] px-4 py-8\" data-dynamic=\"true\" data-kid=\"2\" data-name=\"add source modal\" data-reason=\"visibility toggled by script\" data-source-modal=\"\" hidden=\"\" role=\"dialog\">\n    <div class=\"w-[500px] max-w-full rounded-[12px] border border-[#3b3a45] bg-[var(--raised)] p-6\" data-kid=\"2-1\" data-name=\"add source modal card\">\n        <div class=\"flex items-start justify-between gap-5\" data-kid=\"2-1-1\">\n            <div data-kid=\"2-1-1-1\">\n                <p class=\"text-[10px] uppercase tracking-[0.16em] text-[var(--muted)]\" data-kid=\"2-1-1-1-1\">\n                    Profile source\n                </p>\n                <h2 class=\"mt-2 font-['Inter_Tight'] text-[24px] font-semibold tracking-[-0.025em]\" data-kid=\"2-1-1-1-2\">\n                    Add subscription\n                </h2>\n                <p class=\"mt-2 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"2-1-1-1-3\">\n                    The subscription name becomes the locked group name on Profiles.\n                </p>\n            </div>\n            <button aria-label=\"Close source dialog\" class=\"icon-button flex size-10 items-center justify-center rounded-[8px] text-[20px] text-[var(--muted)]\" data-close-modal=\"\" data-kid=\"2-1-1-2\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-x\" data-kid=\"2-1-1-2-1\">\n                </i>\n            </button>\n        </div>\n        <div class=\"mt-6 grid grid-cols-2 gap-1 rounded-[9px] bg-[var(--canvas)] p-1\" data-kid=\"2-1-2\" data-name=\"source type selector group\">\n            <button aria-pressed=\"true\" class=\"type-option h-10 rounded-[7px] text-[12px] text-[var(--body)]\" data-kid=\"2-1-2-1\" data-kind=\"url\" data-name=\"url source type option\" data-selected=\"true\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-rss mr-1.5\" data-kid=\"2-1-2-1-1\">\n                </i>\n                Subscription URL\n            </button>\n            <button aria-pressed=\"false\" class=\"type-option h-10 rounded-[7px] text-[12px] text-[var(--body)]\" data-kid=\"2-1-2-2\" data-kind=\"key\" data-name=\"key source type option\" data-selected=\"false\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-key mr-1.5\" data-kid=\"2-1-2-2-1\">\n                </i>\n                Single key\n            </button>\n        </div>\n        <form class=\"mt-6 space-y-4\" data-kid=\"2-1-3\" data-name=\"add source form\">\n            <label class=\"block text-[13px] font-medium\" data-kid=\"2-1-3-1\" for=\"subscription-name\">\n                Subscription name\n                <span class=\"text-[var(--muted)]\" data-kid=\"2-1-3-1-1\">\n                    (optional)\n                </span>\n            </label>\n            <input class=\"h-11 w-full rounded-[8px] border border-white/10 bg-[var(--surface)] px-3.5 text-[13px] text-[var(--body)]\" data-kid=\"2-1-3-2\" data-name=\"subscription name input\" id=\"subscription-name\" placeholder=\"e.g. Personal / North America\" type=\"text\"/>\n            <label class=\"block text-[13px] font-medium\" data-kid=\"2-1-3-3\" for=\"subscription-url\">\n                Source URL\n            </label>\n            <input class=\"h-11 w-full rounded-[8px] border border-white/10 bg-[var(--surface)] px-3.5 font-['IBM_Plex_Mono'] text-[12px] text-[var(--body)]\" data-kid=\"2-1-3-4\" data-name=\"subscription url input\" id=\"subscription-url\" placeholder=\"https://example.com/profiles\" type=\"url\"/>\n            <p class=\"flex items-center gap-1.5 text-[11px] text-[var(--muted)]\" data-kid=\"2-1-3-5\">\n                <i aria-hidden=\"true\" class=\"ti ti-info-circle text-[14px]\" data-kid=\"2-1-3-5-1\">\n                </i>\n                Leave the name blank to derive it from the URL hostname.\n            </p>\n            <div class=\"flex justify-end gap-2 pt-2\" data-kid=\"2-1-3-6\">\n                <button class=\"rounded-[8px] px-4 py-2.5 text-[13px] text-[var(--body)] hover:bg-[var(--row-hover)]\" data-close-modal=\"\" data-kid=\"2-1-3-6-1\" type=\"button\">\n                    Cancel\n                </button>\n                <button class=\"rounded-[8px] bg-[var(--lavender)] px-4 py-2.5 text-[13px] font-semibold text-[var(--ink)]\" data-kid=\"2-1-3-6-2\" data-name=\"add subscription submit button\" type=\"submit\">\n                    Add subscription\n                </button>\n            </div>\n        </form>\n    </div>\n</div>\n<script>\n    (() => { const root=document.getElementById('sources-design'); if(!root)return; const menu=root.querySelector('[data-source-menu]'); const trigger=root.querySelector('[data-add-source]'); const modal=root.parentElement.querySelector('[data-source-modal]'); trigger.addEventListener('click',()=>{menu.hidden=!menu.hidden;trigger.setAttribute('aria-expanded',String(!menu.hidden));}); root.querySelectorAll('[data-source-kind]').forEach((button)=>button.addEventListener('click',()=>{menu.hidden=true;trigger.setAttribute('aria-expanded','false');modal.hidden=false;modal.setAttribute('aria-hidden','false');})); modal?.querySelectorAll('[data-close-modal]').forEach((button)=>button.addEventListener('click',()=>{modal.hidden=true;modal.setAttribute('aria-hidden','true');})); const collapse=root.querySelector('[data-collapse-sidebar]'); collapse?.addEventListener('click',()=>{const collapsed=root.classList.toggle('is-collapsed');collapse.setAttribute('aria-expanded',String(!collapsed));collapse.setAttribute('aria-label',collapsed?'Expand sidebar':'Collapse sidebar');}); document.addEventListener('click',(event)=>{if(!event.target.closest('[data-add-source]')&&!event.target.closest('[data-source-menu]')){menu.hidden=true;trigger.setAttribute('aria-expanded','false');}});})();\n</script>\n",
