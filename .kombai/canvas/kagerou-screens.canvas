    },
    "var_cad39bcd3eea": {
      "type": "variant",
      "label": "Kagerou — Profiles",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Inter+Tight:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .kagerou-profiles-primary { --canvas:#1a1b1e; --sidebar:#17181b; --surface:#222329; --raised:#292a31; --selected:#312e3b; --row-hover:#282930; --hairline:#2a2b31; --primary:#f2f0f6; --body:#c8c5d0; --muted:#918d99; --quiet:#77747f; --lavender:#aa9bd7; --lavender-hi:#c3b7e6; --ink:#211f27; --good:#70b68e; --bad:#cf747b; color-scheme:dark; font-family:'Inter',sans-serif; }\n  .kagerou-profiles-primary [hidden] { display:none; }\n  .kagerou-profiles-primary button:focus-visible, .kagerou-profiles-primary a:focus-visible { outline:2px solid var(--lavender); outline-offset:3px; }\n  .kagerou-profiles-primary .nav-item:hover, .kagerou-profiles-primary .nav-item:focus-visible, .kagerou-profiles-primary .icon-button:hover, .kagerou-profiles-primary .icon-button:focus-visible { background:var(--row-hover); color:var(--primary); }\n  .kagerou-profiles-primary .nav-item[aria-current='page'] { background:var(--selected); color:var(--primary); }\n  .kagerou-profiles-primary .nav-item[aria-current='page'] .nav-icon { color:var(--lavender); }\n  .kagerou-profiles-primary .group-trigger:hover .group-chevron { color:var(--lavender-hi); }\n  .kagerou-profiles-primary .group-card[data-open='false'] .group-header { border-bottom-color:transparent; }\n  .kagerou-profiles-primary .group-card[data-open='false'] .group-panel { display:none; }\n  .kagerou-profiles-primary .group-card[data-open='false'] .group-chevron { transform:rotate(-90deg); }\n  .kagerou-profiles-primary .group-chevron { transition:transform 160ms ease,color 160ms ease; }\n  .kagerou-profiles-primary .profile-row:hover, .kagerou-profiles-primary .profile-row:focus-within { background:var(--row-hover); }\n  .kagerou-profiles-primary .profile-row[data-selected='true'], .kagerou-profiles-primary .profile-row[data-selected='true']:hover { background:var(--selected); }\n  .kagerou-profiles-primary .menu { box-shadow:0 16px 32px rgba(0,0,0,.32); }\n  .kagerou-profiles-primary .menu-item:hover, .kagerou-profiles-primary .menu-item:focus-visible { background:var(--selected); color:var(--primary); }\n  .kagerou-profiles-primary .sidebar { transition:width 180ms ease,padding 180ms ease; }\n  .kagerou-profiles-primary.is-collapsed .sidebar { width:68px; padding-left:12px; padding-right:12px; }\n  .kagerou-profiles-primary.is-collapsed .wordmark, .kagerou-profiles-primary.is-collapsed .nav-label, .kagerou-profiles-primary.is-collapsed .collapse-label { display:none; }\n  .kagerou-profiles-primary.is-collapsed .brand-row, .kagerou-profiles-primary.is-collapsed .nav-item, .kagerou-profiles-primary.is-collapsed .collapse-button { justify-content:center; padding-left:0; padding-right:0; }\n  @media (max-width:960px) { .kagerou-profiles-primary .sidebar { width:68px; padding-left:12px; padding-right:12px; } .kagerou-profiles-primary .wordmark,.kagerou-profiles-primary .nav-label,.kagerou-profiles-primary .collapse-label { display:none; } .kagerou-profiles-primary .brand-row,.kagerou-profiles-primary .nav-item,.kagerou-profiles-primary .collapse-button { justify-content:center; padding-left:0; padding-right:0; } .kagerou-profiles-primary main { padding-left:24px; padding-right:24px; } }\n</style>\n<div class=\"kagerou-profiles-primary flex min-h-screen min-w-[960px] w-full overflow-x-clip bg-[var(--canvas)] text-[var(--primary)] antialiased\" data-kid=\"1\" data-name=\"profile management app container\" id=\"profiles-primary\">\n    <aside aria-label=\"Primary navigation\" class=\"sidebar flex w-[216px] shrink-0 flex-col border-r border-[var(--hairline)] bg-[var(--sidebar)] px-3 py-6\" data-kid=\"1-1\" data-name=\"sidebar navigation\">\n        <div class=\"brand-row mb-11 flex items-center gap-3 px-3\" data-kid=\"1-1-1\">\n            <span aria-hidden=\"true\" class=\"relative flex h-9 w-9 shrink-0 items-center justify-center\" data-kid=\"1-1-1-1\">\n                <span class=\"absolute left-0 top-0 h-8 w-8 rounded-full bg-[var(--lavender)]\" data-kid=\"1-1-1-1-1\">\n                </span>\n                <span class=\"absolute right-0 top-0.5 h-7 w-7 translate-x-1 rounded-full bg-[var(--sidebar)]\" data-kid=\"1-1-1-1-2\">\n                </span>\n            </span>\n            <span class=\"wordmark min-w-0\" data-kid=\"1-1-1-2\">\n                <span class=\"block font-['Inter_Tight'] text-[18px] font-semibold leading-none tracking-[-0.02em]\" data-kid=\"1-1-1-2-1\">\n                    Kagerou\n                </span>\n                <span class=\"mt-2 block text-[9px] uppercase tracking-[0.2em] text-[var(--muted)]\" data-kid=\"1-1-1-2-2\">\n                    Instrument panel\n                </span>\n            </span>\n        </div>\n        <nav aria-label=\"Primary navigation\" class=\"flex flex-col gap-1\" data-kid=\"1-1-2\">\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-1\" href=\"#dashboard\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-1-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard\" data-kid=\"1-1-2-1-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-1-2\">\n                    Dashboard\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] font-medium text-[var(--primary)] transition-colors\" data-kid=\"1-1-2-2\" href=\"#profiles\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px]\" data-kid=\"1-1-2-2-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-server\" data-kid=\"1-1-2-2-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-2-2\">\n                    Profiles\n                </span>\n            </a>\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-3\" href=\"#sources\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-3-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-rss\" data-kid=\"1-1-2-3-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-3-2\">\n                    Sources\n                </span>\n            </a>\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-4\" href=\"#routing-rules\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-4-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-route\" data-kid=\"1-1-2-4-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-4-2\">\n                    Routing rules\n                </span>\n            </a>\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-5\" href=\"#logs\">\n                <span class=\"nav-icon flex size-5 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--muted)]\" data-kid=\"1-1-2-5-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-file-text\" data-kid=\"1-1-2-5-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-5-2\">\n                    Logs\n                </span>\n            </a>\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-6\" href=\"#settings\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-6-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-settings\" data-kid=\"1-1-2-6-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-6-2\">\n                    Settings\n                </span>\n            </a>\n        </nav>\n        <button aria-expanded=\"true\" aria-label=\"Collapse sidebar\" class=\"collapse-button icon-button mt-auto flex h-10 w-full items-center gap-3 rounded-[8px] px-3 text-left text-[13px] text-[var(--muted)] transition-colors\" data-collapse-sidebar=\"\" data-kid=\"1-1-3\" data-name=\"sidebar collapse button\" type=\"button\">\n            <span class=\"flex size-5 items-center justify-center text-[18px]\" data-kid=\"1-1-3-1\" data-name=\"sidebar collapse icon\">\n                <i aria-hidden=\"true\" class=\"ti ti-layout-sidebar-left-collapse\" data-kid=\"1-1-3-1-1\">\n                </i>\n            </span>\n            <span class=\"collapse-label\" data-kid=\"1-1-3-2\" data-name=\"sidebar collapse button label\">\n                Collapse sidebar\n            </span>\n        </button>\n    </aside>\n    <main class=\"min-w-0 flex-1 bg-[var(--canvas)] px-12 pb-10 pt-10\" data-kid=\"1-2\">\n        <div class=\"mx-auto w-full max-w-[1040px]\" data-kid=\"1-2-1\" data-name=\"profile management view\" id=\"profiles\">\n            <header class=\"mb-7 flex items-start justify-between gap-8\" data-kid=\"1-2-1-1\" data-name=\"header area\">\n                <div data-kid=\"1-2-1-1-1\">\n                    <div class=\"flex items-center gap-2 text-[10px] font-medium uppercase tracking-[0