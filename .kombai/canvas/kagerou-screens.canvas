    "var_844ef6033d4a": {
      "type": "variant",
      "label": "Kagerou — Settings",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 8280,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Inter+Tight:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .kagerou-settings-design { --canvas:#1a1b1e; --sidebar:#17181b; --surface:#222329; --raised:#292a31; --selected:#312e3b; --row-hover:#282930; --hairline:#2a2b31; --primary:#f2f0f6; --body:#c8c5d0; --muted:#918d99; --lavender:#aa9bd7; --lavender-hi:#c3b7e6; --ink:#211f27; --bad:#cf747b; color-scheme:dark; font-family:'Inter',sans-serif; }\n  .kagerou-settings-design [hidden] { display:none; }\n  .kagerou-settings-design button:focus-visible, .kagerou-settings-design a:focus-visible, .kagerou-settings-design input:focus-visible, .kagerou-settings-design select:focus-visible { outline:2px solid var(--lavender); outline-offset:3px; }\n  .kagerou-settings-design .nav-item:hover, .kagerou-settings-design .nav-item:focus-visible, .kagerou-settings-design .collapse-button:hover, .kagerou-settings-design .collapse-button:focus-visible { background:var(--row-hover); color:var(--primary); }\n  .kagerou-settings-design .nav-item[aria-current='page'] { background:var(--selected); color:var(--primary); }\n  .kagerou-settings-design .nav-item[aria-current='page'] .nav-icon { color:var(--lavender); }\n  .kagerou-settings-design .switch { background:#292a31; transition:background 180ms ease; }\n  .kagerou-settings-design .switch[data-on='true'] { background:var(--lavender); }\n  .kagerou-settings-design .switch-thumb { transition:transform 180ms ease; }\n  .kagerou-settings-design .switch[data-on='true'] .switch-thumb { transform:translateX(16px); background:#222329; }\n  .kagerou-settings-design .sidebar { transition:width 180ms ease,padding 180ms ease; }\n  .kagerou-settings-design.is-collapsed .sidebar { width:68px; padding-left:12px; padding-right:12px; }\n  .kagerou-settings-design.is-collapsed .wordmark, .kagerou-settings-design.is-collapsed .nav-label, .kagerou-settings-design.is-collapsed .collapse-label { display:none; }\n  .kagerou-settings-design.is-collapsed .brand-row, .kagerou-settings-design.is-collapsed .nav-item, .kagerou-settings-design.is-collapsed .collapse-button { justify-content:center; padding-left:0; padding-right:0; }\n  @media (max-width:960px) { .kagerou-settings-design .sidebar { width:68px; padding-left:12px; padding-right:12px; } .kagerou-settings-design .wordmark,.kagerou-settings-design .nav-label,.kagerou-settings-design .collapse-label { display:none; } .kagerou-settings-design .brand-row,.kagerou-settings-design .nav-item,.kagerou-settings-design .collapse-button { justify-content:center; padding-left:0; padding-right:0; } .kagerou-settings-design main { padding-left:32px; padding-right:32px; } }\n</style>\n<div class=\"kagerou-settings-design flex min-h-screen min-w-[960px] w-full overflow-x-clip bg-[var(--canvas)] text-[var(--body)]\" data-kid=\"1\" data-name=\"app settings container\" id=\"settings-design\">\n    <aside aria-label=\"Primary navigation\" class=\"sidebar flex w-[216px] shrink-0 flex-col border-r border-[var(--hairline)] bg-[var(--sidebar)] px-3 py-6\" data-kid=\"1-1\" data-name=\"sidebar container\">\n        <div class=\"brand-row mb-11 flex items-center gap-3 px-3\" data-kid=\"1-1-1\" data-name=\"brand logo and name container\">\n            <span aria-hidden=\"true\" class=\"relative flex h-9 w-9 shrink-0 items-center justify-center\" data-kid=\"1-1-1-1\" data-name=\"brand logo icon\">\n                <span class=\"absolute left-0 top-0 h-8 w-8 rounded-full bg-[var(--lavender)]\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo circle\">\n                </span>\n                <span class=\"absolute right-0 top-0.5 h-7 w-7 translate-x-1 rounded-full bg-[var(--sidebar)]\" data-kid=\"1-1-1-1-2\" data-name=\"brand logo cutout circle\">\n                </span>\n            </span>\n            <span class=\"wordmark min-w-0\" data-kid=\"1-1-1-2\" data-name=\"brand name and subtitle container\">\n                <span class=\"block font-['Inter_Tight'] text-[18px] font-semibold leading-none tracking-[-0.02em] text-[var(--primary)]\" data-kid=\"1-1-1-2-1\" data-name=\"brand name text\">\n                    Kagerou\n                </span>\n                <span class=\"mt-2 block text-[9px] uppercase tracking-[0.2em] text-[var(--muted)]\" data-kid=\"1-1-1-2-2\" data-name=\"brand subtitle text\">\n                    Instrument panel\n                </span>\n            </span>\n        </div>\n        <nav aria-label=\"Primary navigation\" class=\"flex flex-col gap-1\" data-kid=\"1-1-2\" data-name=\"primary navigation container\">\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-1\" data-name=\"dashboard navigation link\" href=\"#dashboard\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-1-1\" data-name=\"dashboard icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard\" data-kid=\"1-1-2-1-1-1\" data-name=\"dashboard icon\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-1-2\" data-name=\"dashboard label text\">\n                    Dashboard\n                </span>\n            </a>\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-2\" data-name=\"profiles navigation link\" href=\"#profiles\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-2-1\" data-name=\"profiles icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-server\" data-kid=\"1-1-2-2-1-1\" data-name=\"profiles icon\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-2-2\" data-name=\"profiles label text\">\n                    Profiles\n                </span>\n            </a>\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-3\" data-name=\"sources navigation link\" href=\"#sources\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-3-1\" data-name=\"sources icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-rss\" data-kid=\"1-1-2-3-1-1\" data-name=\"sources icon\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-3-2\" data-name=\"sources label text\">\n                    Sources\n                </span>\n            </a>\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-4\" data-name=\"routing rules navigation link\" href=\"#routing-rules\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-4-1\" data-name=\"routing rules icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-route\" data-kid=\"1-1-2-4-1-1\" data-name=\"routing rules icon\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-4-2\" data-name=\"routing rules label text\">\n                    Routing rules\n                </span>\n            </a>\n            <a class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body)] transition-colors\" data-kid=\"1-1-2-5\" data-name=\"logs navigation link\" href=\"#logs\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-1-2-5-1\" data-name=\"logs icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-file-text\" data-kid=\"1-1-2-5-1-1\" data-name=\"logs icon\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-5-2\" data-name=\"logs label text\">\n                    Logs\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"nav-item flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] font-medium text-[var(--primary)] transition-colors\" data-kid=\"1-1-2-6\" data-name=\"settings navigation link\" href=\"#settings\">\n                <span class=\"nav-icon flex size-5 items-center justify-center text-[18px]\" data-kid=\"1-1-2-6-1\" data-name=\"settings icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-settings\" data-kid=\"1-1-2-6-1-1\" data-name=\"settings icon\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-6-2\" data-name=\"settings label text\">\n                    Settings\n                </span>\n            </a>\n        </nav>\n        <button aria-expanded=\"true\" aria-label=\"Collapse sidebar\" class=\"collapse-button mt-auto flex h-10 w-full items-center gap-3 rounded-[8px] px-3 text-left text-[13px] text-[var(--muted)] transition-colors\" data-collapse-sidebar=\"\" data-dynamic=\"true\" data-kid=\"1-1-3\" data-name=\"collapse sidebar button\" data-reason=\"aria-expanded and aria-label toggled by script\" type=\"button\">\n            <span class=\"flex size-5 items-center justify-center text-[18px]\" data-kid=\"1-1-3-1\" data-name=\"collapse icon container\">\n                <i aria-hidden=\"true\" class=\"ti ti-layout-sidebar-left-collapse\" data-kid=\"1-1-3-1-1\" data-name=\"collapse sidebar icon\">\n                </i>\n            </span>\n            <span class=\"collapse-label\" data-kid=\"1-1-3-2\" data-name=\"collapse button label text\">\n                Collapse sidebar\n            </span>\n        </button>\n    </aside>\n    <main class=\"min-w-0 flex-1 px-[68px] py-[52px]\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"w-full max-w-[920px]\" data-kid=\"1-2-1\" data-name=\"settings panel container\">\n            <header class=\"flex items-end justify-between\" data-kid=\"1-2-1-1\" data-name=\"settings header section\">\n                <h1 class=\"font-['Inter_Tight'] text-[28px] font-semibold leading-none tracking-[-0.035em] text-[var(--primary)]\" data-kid=\"1-2-1-1-1\" data-name=\"settings title\">\n                    Settings\n                </h1>\n                <p class=\"mb-0.5 text-[12px] leading-4 text-[var(--muted)]\" data-kid=\"1-2-1-1-2\" data-name=\"instant update status text\">\n                    Changes apply instantly\n                </p>\n            </header>\n            <div class=\"mt-12 w-[680px] max-w-full space-y-9\" data-kid=\"1-2-1-2\" data-name=\"settings sections list\">\n                <section aria-labelledby=\"appearance-heading\" data-kid=\"1-2-1-2-1\" data-name=\"appearance settings section\">\n                    <h2 class=\"mb-3 text-[11px] font-medium uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-2-1-1\" data-name=\"appearance section heading\" id=\"appearance-heading\">\n                        Appearance\n                    </h2>\n                    <div data-kid=\"1-2-1-2-1-2\" data-name=\"appearance settings rows container\">\n                        <div class=\"flex h-14 items-center justify-between border-b border-white/[0.055]\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"theme selection row\">\n                            <span class=\"text-[14px] leading-5\" data-kid=\"1-2-1-2-1-2-1-1\" data-name=\"theme label text\">\n                                Theme\n                            </span>\n                            <div aria-label=\"Theme\" class=\"flex rounded-[8px] bg-[var(--surface)] p-1\" data-kid=\"1-2-1-2-1-2-1-2\" data-name=\"theme switcher toggle group\" role=\"group\">\n                                <button aria-pressed=\"true\" class=\"rounded-[6px] bg-[var(--selected)] px-4 py-2 text-[13px] text-[var(--primary)]\" data-kid=\"1-2-1-2-1-2-1-2-1\" data-name=\"dark theme option button\" type=\"button\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-moon mr-1.5 text-[13px]\" data-kid=\"1-2-1-2-1-2-1-2-1-1\" data-name=\"dark theme icon\">\n                                    </i>\n                                    Dark\n                                </button>\n                                <button aria-pressed=\"false\" class=\"rounded-[6px] px-4 py-2 text-[13px] text-[var(--muted)]\" data-kid=\"1-2-1-2-1-2-1-2-2\" data-name=\"light theme option button\" type=\"button\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-sun mr-1.5 text-[13px]\" data-kid=\"1-2-1-2-1-2-1-2-2-1\" data-name=\"light theme icon\">\n                                    </i>\n                                    Light\n                                </button>\n                            </div>\n                        </div>\n                        <div class=\"flex h-14 items-center justify-between border-b border-white/[0.055]\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"language selection row\">\n                            <label class=\"text-[14px] leading-5\" data-kid=\"1-2-1-2-1-2-2-1\" data-name=\"language label\" for=\"settings-language\">\n                                Language\n                            </label>\n                            <select class=\"h-9 w-[148px] appearance-none rounded-[8px] border-0 bg-[var(--surface)] px-3 text-[13px] text-[var(--body)]\" data-kid=\"1-2-1-2-1-2-2-2\" data-name=\"language select dropdown\" id=\"settings-language\">\n                                <option data-kid=\"1-2-1-2-1-2-2-2-1\">\n                                    English\n                                </option>\n                                <option data-kid=\"1-2-1-2-1-2-2-2-2\">\n                                    中文\n                                </option>\n                                <option data-kid=\"1-2-1-2-1-2-2-2-3\">\n                                    日本語\n                                </option>\n                            </select>\n                        </div>\n                    </div>\n                </section>\n                <section aria-labelledby=\"startup-heading\" data-kid=\"1-2-1-2-2\" data-name=\"startup settings section\">\n                    <h2 class=\"mb-3 text-[11px] font-medium uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-2-2-1\" data-name=\"startup section heading\" id=\"startup-heading\">\n                        Startup\n                    </h2>\n                    <div class=\"flex h-14 items-center justify-between border-b border-white/[0.055]\" data-kid=\"1-2-1-2-2-2\" data-name=\"start automatically row\">\n                        <div data-kid=\"1-2-1-2-2-2-1\" data-name=\"start automatically label container\">\n                            <span class=\"block text-[14px] leading-5\" data-kid=\"1-2-1-2-2-2-1-1\" data-name=\"start automatically label\">\n                                Start automatically\n                            </span>\n                        </div>\n                        <button aria-checked=\"true\" aria-label=\"Start automatically\" class=\"switch relative h-5 w-9 rounded-full\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"start automatically switch button\" data-on=\"true\" data-reason=\"data-on, aria-checked and related UI visibility toggled by script\" role=\"switch\" type=\"button\">\n                            <span aria-hidden=\"true\" class=\"switch-thumb absolute left-0.5 top-0.5 size-4 rounded-full bg-[var(--muted)]\" data-kid=\"1-2-1-2-2-2-2-1\" data-name=\"switch toggle thumb\">\n                            </span>\n                        </button>\n                    </div>\n                </section>\n                <section aria-labelledby=\"subscriptions-heading\" data-kid=\"1-2-1-2-3\" data-name=\"subscriptions settings section\">\n                    <h2 class=\"mb-3 text-[11px] font-medium uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-2-3-1\" data-name=\"subscriptions section heading\" id=\"subscriptions-heading\">\n                        Subscriptions\n                    </h2>\n                    <div data-kid=\"1-2-1-2-3-2\" data-name=\"subscriptions settings rows container\">\n                        <div class=\"flex min-h-14 items-center justify-between gap-8 border-b border-white/[0.055]\" data-kid=\"1-2-1-2-3-2-1\" data-name=\"auto-update subscriptions row\">\n                            <div data-kid=\"1-2-1-2-3-2-1-1\" data-name=\"auto-update label container\">\n                                <span class=\"block text-[14px] leading-5 text-[var(--body)]\" data-kid=\"1-2-1-2-3-2-1-1-1\" data-name=\"auto-update subscriptions label\">\n                                    Auto-update subscriptions\n                                </span>\n                                <p class=\"mt-1 text-[11px] leading-4 text-[var(--muted)]\" data-kid=\"1-2-1-2-3-2-1-1-2\" data-name=\"auto-update subscriptions description\">\n                                    Keep URL subscription groups fresh automatically.\n                                </p>\n                            </div>\n                            <button aria-checked=\"true\" aria-label=\"Auto-update subscriptions\" class=\"switch relative h-5 w-9 shrink-0 rounded-full\" data-auto-switch=\"\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-2-1-2\" data-name=\"auto-update subscriptions switch button\" data-on=\"true\" data-reason=\"data-on, aria-checked and related UI visibility toggled by script\" role=\"switch\" type=\"button\">\n                                <span aria-hidden=\"true\" class=\"switch-thumb absolute left-0.5 top-0.5 size-4 rounded-full bg-[#222329]\" data-kid=\"1-2-1-2-3-2-1-2-1\" data-name=\"switch toggle thumb\">\n                                </span>\n                            </button>\n                        </div>\n                        <div class=\"auto-details\" data-auto-details=\"\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-2-2\" data-name=\"auto-update subscription details container\" data-reason=\"hidden attribute toggled by script\">\n                            <div class=\"flex min-h-14 items-center justify-between gap-8 border-b border-white/[0.055]\" data-kid=\"1-2-1-2-3-2-2-1\" data-name=\"update interval selection row\">\n                                <label class=\"text-[14px] leading-5 text-[var(--body)]\" data-kid=\"1-2-1-2-3-2-2-1-1\" data-name=\"update interval label\" for=\"update-interval\">\n                                    Update interval\n                                </label>\n                                <select class=\"h-9 w-[148px] rounded-[8px] border-0 bg-[var(--surface)] px-3 text-[13px] text-[var(--body)]\" data-interval=\"\" data-kid=\"1-2-1-2-3-2-2-1-2\" data-name=\"update interval select dropdown\" id=\"update-interval\">\n                                    <option data-kid=\"1-2-1-2-3-2-2-1-2-1\" value=\"5\">\n                                        5 minutes\n                                    </option>\n                                    <option data-kid=\"1-2-1-2-3-2-2-1-2-2\" value=\"10\">\n                                        10 minutes\n                                    </option>\n                                    <option data-kid=\"1-2-1-2-3-2-2-1-2-3\" value=\"15\">\n                                        15 minutes\n                                    </option>\n                                    <option data-kid=\"1-2-1-2-3-2-2-1-2-4\" value=\"30\">\n                                        30 minutes\n                                    </option>\n                                    <option data-kid=\"1-2-1-2-3-2-2-1-2-5\" value=\"60\">\n                                        60 minutes\n                                    </option>\n                                    <option data-kid=\"1-2-1-2-3-2-2-1-2-6\" selected=\"\" value=\"custom\">\n                                        Custom\n                                    </option>\n                                </select>\n                            </div>\n                            <div class=\"flex min-h-14 items-start justify-between gap-8 border-b border-white/[0.055] py-3\" data-custom-row=\"\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-2-2-2\" data-name=\"custom update interval row\" data-reason=\"hidden attribute toggled by script\">\n                                <div data-kid=\"1-2-1-2-3-2-2-2-1\" data-name=\"custom interval label container\">\n                                    <label class=\"block pt-1 text-[14px] leading-5 text-[var(--body)]\" data-kid=\"1-2-1-2-3-2-2-2-1-1\" data-name=\"custom interval label\" for=\"custom-minutes\">\n                                        Custom interval (minutes)\n                                    </label>\n                                    <p class=\"mt-1 text-[11px] leading-4 text-[var(--muted)]\" data-kid=\"1-2-1-2-3-2-2-2-1-2\" data-name=\"custom interval description\">\n                                        Choose how often Kagerou checks remote subscriptions.\n                                    </p>\n                                </div>\n                                <input aria-describedby=\"custom-minutes-help\" class=\"h-9 w-[148px] rounded-[8px] border-0 bg-[var(--surface)] px-3 text-right font-['IBM_Plex_Mono'] text-[13px] text-[var(--body)]\" data-kid=\"1-2-1-2-3-2-2-2-2\" data-name=\"custom interval input field\" id=\"custom-minutes\" min=\"1\" step=\"1\" type=\"number\" value=\"60\"/>\n                                <span class=\"sr-only\" data-kid=\"1-2-1-2-3-2-2-2-3\" data-name=\"custom interval help text\" id=\"custom-minutes-help\">\n                                    Enter a whole number greater than zero.\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n                <section aria-labelledby=\"network-heading\" data-kid=\"1-2-1-2-4\" data-name=\"network settings section\">\n                    <h2 class=\"mb-3 text-[11px] font-medium uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-2-4-1\" data-name=\"network section heading\" id=\"network-heading\">\n                        Network\n                    </h2>\n                    <div class=\"flex h-14 items-center justify-between border-b border-white/[0.055]\" data-kid=\"1-2-1-2-4-2\" data-name=\"tun interface selection row\">\n                        <label class=\"text-[14px] leading-5 text-[var(--body)]\" data-kid=\"1-2-1-2-4-2-1\" data-name=\"tun interface label\" for=\"tun-interface\">\n                            TUN interface\n                        </label>\n                        <select class=\"h-9 w-[148px] rounded-[8px] border-0 bg-[var(--surface)] px-3 text-[13px] text-[var(--body)]\" data-kid=\"1-2-1-2-4-2-2\" data-name=\"tun interface select dropdown\" id=\"tun-interface\">\n                            <option data-kid=\"1-2-1-2-4-2-2-1\">\n                                utun / tun0\n                            </option>\n                            <option data-kid=\"1-2-1-2-4-2-2-2\">\n                                utun\n                            </option>\n                            <option data-kid=\"1-2-1-2-4-2-2-3\">\n                                tun0\n                            </option>\n                        </select>\n                    </div>\n                </section>\n            </div>\n        </div>\n    </main>\n</div>\n<script>\n    (() => { const root=document.getElementById('settings-design'); if(!root)return; const autoSwitch=root.querySelector('[data-auto-switch]'); const details=root.querySelector('[data-auto-details]'); const interval=root.querySelector('[data-interval]'); const custom=root.querySelector('[data-custom-row]'); const update=()=>{const on=autoSwitch.dataset.on==='true';autoSwitch.setAttribute('aria-checked',String(on));details.hidden=!on;custom.hidden=interval.value!=='custom';}; autoSwitch.addEventListener('click',()=>{autoSwitch.dataset.on=String(autoSwitch.dataset.on!=='true');update();}); interval.addEventListener('change',update); const collapse=root.querySelector('[data-collapse-sidebar]'); collapse?.addEventListener('click',()=>{const collapsed=root.classList.toggle('is-collapsed');collapse.setAttribute('aria-expanded',String(!collapsed));collapse.setAttribute('aria-label',collapsed?'Expand sidebar':'Collapse sidebar');}); update();})();\n</script>\n",
      "comments": [],
      "created": "2026-09-03T06:04:57.637199+00:00",
      "modified": "2026-09-03T07:46:46.929260+00:00",
      "id": "var_844ef6033d4a"
    },
    "var_ce7fa3c94443": {
      "type": "variant",
      "label": "Kagerou — Sources",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 9660,
        "y": 0,
