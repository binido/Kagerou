      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Inter+Tight:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  #lunar-app {\n    --canvas: #1A1B1E;\n    --sidebar: #17181B;\n    --surface: #222329;\n    --raised: #292A31;\n    --selected: #312E3B;\n    --lavender: #AA9BD7;\n    --highlight: #C3B7E6;\n    --text-primary: #F2F0F6;\n    --text-body: #C8C5D0;\n    --text-muted: #918D99;\n    --good: #70B68E;\n    --amber: #D1AA64;\n    --bad: #CF747B;\n    --line: #34353C;\n    --line-soft: #2A2B31;\n    --hover: #232429;\n    --ink: #1A1B1E;\n    --toggle-off: #41414A;\n    --upload-line: #8B9AAE;\n  }\n\n  #lunar-app .lunar-inter { font-family: 'Inter', sans-serif; }\n  #lunar-app .lunar-tight { font-family: 'Inter Tight', sans-serif; }\n  #lunar-app .lunar-mono { font-family: 'IBM Plex Mono', monospace; }\n  #lunar-app .sidebar-label,\n  #lunar-app .sidebar-wordmark { transition: opacity 160ms ease, visibility 160ms ease; }\n  #lunar-app #sidebar { transition: width 180ms ease; }\n  #lunar-app.is-collapsed #sidebar { width: 68px; }\n  #lunar-app.is-collapsed .sidebar-wordmark,\n  #lunar-app.is-collapsed .sidebar-label { opacity: 0; visibility: hidden; width: 0; overflow: hidden; }\n  #lunar-app.is-collapsed .brand-row,\n  #lunar-app.is-collapsed .nav-item,\n  #lunar-app.is-collapsed .collapse-button { justify-content: center; padding-left: 0; padding-right: 0; }\n  #lunar-app.is-collapsed .collapse-icon { transform: rotate(180deg); }\n  #lunar-app .dial-shell { transition: background-color 180ms ease, border-color 180ms ease, transform 120ms ease; }\n  #lunar-app .dial-shell:hover { background-color: var(--selected); }\n  #lunar-app .dial-shell:active { transform: translateY(1px); }\n  #lunar-app #connect-dial[data-state='disconnected'] { border-color: var(--line); }\n  #lunar-app #connect-dial[data-state='disconnected'] .dial-inner { background-color: var(--surface); }\n  #lunar-app #connect-dial[data-state='disconnected'] .dial-status { color: var(--text-body); }\n  #lunar-app .toggle-track { transition: background-color 160ms ease; }\n  #lunar-app .toggle-thumb { transition: transform 160ms ease, background-color 160ms ease; }\n  #lunar-app .lunar-switch.is-on .toggle-track { background-color: var(--lavender); }\n  #lunar-app .lunar-switch.is-on .toggle-thumb { transform: translateX(16px); background-color: var(--ink); }\n  #lunar-app .lunar-switch:not(.is-on) .toggle-thumb { transform: translateX(0); background-color: var(--text-muted); }\n  #lunar-app .nav-item:focus-visible,\n  #lunar-app .collapse-button:focus-visible,\n  #lunar-app .lunar-switch:focus-visible,\n  #lunar-app #disconnect-action:focus-visible,\n  #lunar-app #connect-dial:focus-visible {\n    outline: 2px solid var(--lavender);\n    outline-offset: 3px;\n  }\n  #lunar-app .nav-item:hover { background-color: var(--hover); }\n  #lunar-app .nav-item[data-active='true'] { background-color: var(--selected); }\n  #lunar-app .nav-item[data-active='true'] .nav-icon { color: var(--lavender); }\n  #lunar-app .nav-item:active,\n  #lunar-app .collapse-button:active,\n  #lunar-app .lunar-switch:active { background-color: var(--line-soft); }\n  #lunar-app .lunar-switch:hover .toggle-track { background-color: var(--highlight); }\n  #lunar-app .lunar-switch:not(.is-on):hover .toggle-track { background-color: #41414A; }\n  #lunar-app #disconnect-action:hover { color: var(--highlight); text-decoration-color: var(--highlight); }\n  #lunar-app #lunar-mark-cutout { background-color: var(--sidebar); }\n\n  @media (max-width: 1179px) {\n    #lunar-app #sidebar { width: 68px; }\n    #lunar-app .sidebar-wordmark,\n    #lunar-app .sidebar-label { opacity: 0; visibility: hidden; width: 0; overflow: hidden; }\n    #lunar-app .brand-row,\n    #lunar-app .nav-item,\n    #lunar-app .collapse-button { justify-content: center; padding-left: 0; padding-right: 0; }\n    #lunar-app .main-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }\n    #lunar-app .connection-stage,\n    #lunar-app .telemetry-panel { grid-column: span 12 / span 12; }\n    #lunar-app .telemetry-panel { min-height: 0; display: grid; grid-template-columns: 1fr 1.35fr 0.7fr; }\n    #lunar-app .telemetry-top { border-bottom: 0; border-right: 1px solid var(--line); }\n    #lunar-app .telemetry-chart { border-right: 1px solid var(--line); }\n    #lunar-app .telemetry-session { border-top: 0; }\n  }\n</style>\n<div class=\"lunar-inter min-h-screen min-w-[960px] w-full overflow-x-clip bg-[var(--canvas)] text-[var(--text-primary)]\" data-kid=\"1\" data-name=\"lunar app container\" id=\"lunar-app\">\n    <div class=\"flex min-h-screen\" data-kid=\"1-1\" data-name=\"layout wrapper\">\n        <aside aria-label=\"Primary navigation\" class=\"flex w-[216px] shrink-0 flex-col border-r border-[var(--line-soft)] bg-[var(--sidebar)] px-3 py-4\" data-kid=\"1-1-1\" data-name=\"sidebar navigation panel\" id=\"sidebar\">\n            <div class=\"brand-row mb-8 flex h-10 items-center gap-3 rounded-lg px-3\" data-kid=\"1-1-1-1\" data-name=\"brand header row\">\n                <div aria-label=\"Kagerou gibbous mark\" class=\"relative h-7 w-7 shrink-0\" data-kid=\"1-1-1-1-1\" data-name=\"kagerou gibbous mark icon\" role=\"img\">\n                    <span class=\"absolute inset-0 rounded-full bg-[var(--lavender)]\" data-kid=\"1-1-1-1-1-1\" data-name=\"mark fill\">\n                    </span>\n                    <span class=\"absolute -right-3 top-1 h-5 w-5 rounded-full\" data-kid=\"1-1-1-1-1-2\" data-name=\"mark cutout\" id=\"lunar-mark-cutout\">\n                    </span>\n                </div>\n                <span class=\"sidebar-wordmark lunar-tight whitespace-nowrap text-[13px] font-semibold uppercase tracking-[0.2em] text-[var(--text-primary)]\" data-kid=\"1-1-1-1-2\" data-name=\"brand wordmark\">\n                    Kagerou\n                </span>\n            </div>\n            <nav aria-label=\"App sections\" class=\"flex flex-col gap-1\" data-kid=\"1-1-1-2\" data-name=\"navigation link group\">\n                <button aria-current=\"page\" class=\"nav-item group flex h-10 w-full items-center gap-3 rounded-lg px-3 text-left text-[13px] font-semibold text-[var(--highlight)] focus-visible:outline-none\" data-active=\"true\" data-kid=\"1-1-1-2-1\" data-name=\"dashboard navigation link\" title=\"Dashboard\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"nav-icon ti ti-layout-dashboard shrink-0 text-[18px] text-[var(--text-muted)]\" data-kid=\"1-1-1-2-1-1\" data-name=\"dashboard icon\">\n                    </i>\n                    <span class=\"sidebar-label whitespace-nowrap\" data-kid=\"1-1-1-2-1-2\" data-name=\"dashboard label\">\n                        Dashboard\n                    </span>\n                </button>\n                <button class=\"nav-item group flex h-10 w-full items-center gap-3 rounded-lg px-3 text-left text-[13px] text-[var(--text-body)] focus-visible:outline-none\" data-kid=\"1-1-1-2-2\" data-name=\"profiles navigation link\" title=\"Profiles\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"nav-icon ti ti-server shrink-0 text-[18px] text-[var(--text-muted)]\" data-kid=\"1-1-1-2-2-1\" data-name=\"profiles icon\">\n                    </i>\n                    <span class=\"sidebar-label whitespace-nowrap\" data-kid=\"1-1-1-2-2-2\" data-name=\"profiles label\">\n                        Profiles\n                    </span>\n                </button>\n                <button class=\"nav-item group flex h-10 w-full items-center gap-3 rounded-lg px-3 text-left text-[13px] text-[var(--text-body)] focus-visible:outline-none\" data-kid=\"1-1-1-2-3\" data-name=\"subscriptions navigation link\" title=\"Subscriptions\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"nav-icon ti ti-rss shrink-0 text-[18px] text-[var(--text-muted)]\" data-kid=\"1-1-1-2-3-1\" data-name=\"subscriptions icon\">\n                    </i>\n                    <span class=\"sidebar-label whitespace-nowrap\" data-kid=\"1-1-1-2-3-2\" data-name=\"subscriptions label\">\n                        Subscriptions\n                    </span>\n                </button>\n                <button class=\"nav-item group flex h-10 w-full items-center gap-3 rounded-lg px-3 text-left text-[13px] text-[var(--text-body)] focus-visible:outline-none\" data-kid=\"1-1-1-2-4\" data-name=\"routing rules navigation link\" title=\"Routing rules\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"nav-icon ti ti-route shrink-0 text-[18px] text-[var(--text-muted)]\" data-kid=\"1-1-1-2-4-1\" data-name=\"routing rules icon\">\n                    </i>\n                    <span class=\"sidebar-label whitespace-nowrap\" data-kid=\"1-1-1-2-4-2\" data-name=\"routing rules label\">\n                        Routing rules\n                    </span>\n                </button>\n                <button class=\"nav-item group flex h-10 w-full items-center gap-3 rounded-lg px-3 text-left text-[13px] text-[var(--text-body)] focus-visible:outline-none\" data-kid=\"1-1-1-2-5\" data-name=\"logs navigation link\" title=\"Logs\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"nav-icon ti ti-notes shrink-0 text-[18px] text-[var(--text-muted)]\" data-kid=\"1-1-1-2-5-1\" data-name=\"logs icon\">\n                    </i>\n                    <span class=\"sidebar-label whitespace-nowrap\" data-kid=\"1-1-1-2-5-2\" data-name=\"logs label\">\n                        Logs\n                    </span>\n                </button>\n                <button class=\"nav-item group flex h-10 w-full items-center gap-3 rounded-lg px-3 text-left text-[13px] text-[var(--text-body)] focus-visible:outline-none\" data-kid=\"1-1-1-2-6\" data-name=\"settings navigation link\" title=\"Settings\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"nav-icon ti ti-settings shrink-0 text-[18px] text-[var(--text-muted)]\" data-kid=\"1-1-1-2-6-1\" data-name=\"settings icon\">\n                    </i>\n                    <span class=\"sidebar-label whitespace-nowrap\" data-kid=\"1-1-1-2-6-2\" data-name=\"settings label\">\n                        Settings\n                    </span>\n                </button>\n            </nav>\n            <button aria-expanded=\"true\" class=\"collapse-button mt-auto flex h-10 w-full items-center gap-3 rounded-lg px-3 text-left text-[13px] text-[var(--text-muted)] focus-visible:outline-none hover:bg-[var(--hover)]\" data-dynamic=\"true\" data-kid=\"1-1-1-3\" data-name=\"sidebar collapse toggle button\" data-reason=\"aria-expanded and title attribute updated by script\" id=\"collapse-sidebar\" title=\"Collapse sidebar\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"collapse-icon ti ti-layout-sidebar-left-collapse shrink-0 text-[18px]\" data-kid=\"1-1-1-3-1\" data-name=\"collapse icon\">\n                </i>\n                <span class=\"sidebar-label whitespace-nowrap\" data-kid=\"1-1-1-3-2\" data-name=\"collapse button label\">\n                    Collapse sidebar\n                </span>\n            </button>\n        </aside>\n        <main aria-labelledby=\"page-title\" class=\"min-w-0 flex-1 px-12 py-9\" data-kid=\"1-1-2\" data-name=\"main content area\">\n            <header class=\"mb-6 flex items-end justify-between\" data-kid=\"1-1-2-1\" data-name=\"page header section\">\n                <div data-kid=\"1-1-2-1-1\" data-name=\"page title container\">\n                    <p class=\"text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--text-muted)]\" data-kid=\"1-1-2-1-1-1\" data-name=\"page breadcrumb label\">\n                        Connection\n                    </p>\n                    <h1 class=\"lunar-tight mt-2 text-[30px] font-semibold leading-none tracking-[-0.02em] text-[var(--text-primary)]\" data-kid=\"1-1-2-1-1-2\" data-name=\"main page title\" id=\"page-title\">\n                        Dashboard\n                    </h1>\n                </div>\n            </header>\n            <div class=\"main-grid grid grid-cols-12 items-stretch gap-5\" data-kid=\"1-1-2-2\" data-name=\"main content grid\">\n                <section aria-labelledby=\"connection-stage-title\" class=\"connection-stage relative col-span-8 flex min-h-[584px] flex-col overflow-hidden rounded-[10px] border border-[var(--line-soft)] bg-[var(--surface)] p-8\" data-kid=\"1-1-2-2-1\" data-name=\"connection stage section\">\n                    <div aria-hidden=\"true\" class=\"pointer-events-none absolute right-7 top-7 flex items-center gap-2\" data-kid=\"1-1-2-2-1-1\" data-name=\"connection status indicator container\">\n                        <span class=\"h-px w-7 bg-[var(--line)]\" data-kid=\"1-1-2-2-1-1-1\" data-name=\"horizontal line\">\n                        </span>\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[var(--lavender)]\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"status dot\">\n                        </span>\n                    </div>\n                    <div data-kid=\"1-1-2-2-1-2\" data-name=\"connection details container\">\n                        <p class=\"text-[11px] font-medium uppercase tracking-[0.18em] text-[var(--text-muted)]\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"active profile label\">\n                            Active profile\n                        </p>\n                        <h2 class=\"lunar-tight mt-2 text-[22px] font-semibold leading-tight tracking-[-0.01em] text-[var(--text-primary)]\" data-kid=\"1-1-2-2-1-2-2\" data-name=\"active profile name\" id=\"connection-stage-title\">\n                            Aurora / Seattle 03\n                        </h2>\n                        <p class=\"mt-2 flex items-center gap-2 text-[14px] text-[var(--text-body)]\" data-kid=\"1-1-2-2-1-2-3\" data-name=\"location details container\">\n                            <i aria-hidden=\"true\" class=\"ti ti-map-pin text-[16px] text-[var(--text-muted)]\" data-kid=\"1-1-2-2-1-2-3-1\" data-name=\"location icon\">\n                            </i>\n                            <span data-kid=\"1-1-2-2-1-2-3-2\" data-name=\"location text\">\n                                Seattle, United States\n                            </span>\n                        </p>\n                    </div>\n                    <div class=\"flex flex-1 flex-col items-center justify-center\" data-kid=\"1-1-2-2-1-3\" data-name=\"connection controls container\">\n                        <button aria-label=\"Connection control: Connected\" aria-pressed=\"true\" class=\"dial-shell flex h-[190px] w-[190px] shrink-0 items-center justify-center rounded-full border-[3px] border-[var(--lavender)] bg-[var(--canvas)] p-2 shadow-[0_20px_64px_rgba(9,8,13,.20)] focus-visible:outline-none\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-3-1\" data-name=\"connection toggle dial\" data-reason=\"aria-pressed, aria-label, and data-state updated by script\" data-state=\"connected\" id=\"connect-dial\" type=\"button\">\n                            <span class=\"dial-inner flex h-full w-full flex-col items-center justify-center rounded-full border border-[var(--line)] bg-[var(--raised)]\" data-kid=\"1-1-2-2-1-3-1-1\" data-name=\"dial inner circle\">\n                                <i aria-hidden=\"true\" class=\"ti ti-power text-[25px] leading-none text-[var(--highlight)]\" data-kid=\"1-1-2-2-1-3-1-1-1\" data-name=\"power icon\">\n                                </i>\n                                <span class=\"dial-status lunar-tight mt-3 text-[18px] font-semibold text-[var(--text-primary)]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-3-1-1-2\" data-name=\"dial status label\" data-reason=\"text updated to Connected/Disconnected by script\">\n                                    Connected\n                                </span>\n                            </span>\n                        </button>\n                        <button class=\"mt-6 rounded-lg px-3 py-1 text-[12px] text-[var(--lavender)] underline decoration-[var(--lavender)]/50 underline-offset-4 hover:text-[var(--highlight)] focus-visible:outline-none\" data-action=\"disconnect\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-3-2\" data-name=\"disconnect action button\" data-reason=\"text and data-action attribute toggled by script\" id=\"disconnect-action\" type=\"button\">\n                            Disconnect\n                        </button>\n                        <div class=\"mt-10 flex rounded-lg border border-[var(--line)] bg-[var(--canvas)] p-1\" data-kid=\"1-1-2-2-1-3-3\" data-name=\"mode toggle container\">\n                            <button aria-checked=\"true\" aria-label=\"TUN mode\" class=\"lunar-switch is-on flex h-10 items-center gap-3 rounded-md px-3 text-left text-[13px] text-[var(--text-body)] focus-visible:outline-none\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-3-3-1\" data-name=\"tun mode switch\" data-reason=\"aria-checked and CSS class updated by script\" data-toggle=\"tun\" role=\"switch\" type=\"button\">\n                                <span data-kid=\"1-1-2-2-1-3-3-1-1\" data-name=\"tun mode label\">\n                                    TUN mode\n                                </span>\n                                <span aria-hidden=\"true\" class=\"toggle-track flex h-5 w-9 items-center rounded-full bg-[var(--lavender)] p-0.5\" data-kid=\"1-1-2-2-1-3-3-1-2\" data-name=\"tun toggle track\">\n                                    <span class=\"toggle-thumb block h-4 w-4 rounded-full bg-[var(--ink)]\" data-kid=\"1-1-2-2-1-3-3-1-2-1\" data-name=\"tun toggle thumb\">\n                                    </span>\n                                </span>\n                            </button>\n                            <span aria-hidden=\"true\" class=\"my-2 w-px bg-[var(--line)]\" data-kid=\"1-1-2-2-1-3-3-2\" data-name=\"divider\">\n                            </span>\n                            <button aria-checked=\"false\" aria-label=\"System proxy\" class=\"lunar-switch flex h-10 items-center gap-3 rounded-md px-3 text-left text-[13px] text-[var(--text-body)] focus-visible:outline-none\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-3-3-3\" data-name=\"system proxy switch\" data-reason=\"aria-checked and CSS class updated by script\" data-toggle=\"proxy\" role=\"switch\" type=\"button\">\n                                <span data-kid=\"1-1-2-2-1-3-3-3-1\" data-name=\"system proxy label\">\n                                    System proxy\n                                </span>\n                                <span aria-hidden=\"true\" class=\"toggle-track flex h-5 w-9 items-center rounded-full bg-[var(--toggle-off)] p-0.5\" data-kid=\"1-1-2-2-1-3-3-3-2\" data-name=\"proxy toggle track\">\n                                    <span class=\"toggle-thumb block h-4 w-4 rounded-full bg-[var(--text-muted)]\" data-kid=\"1-1-2-2-1-3-3-3-2-1\" data-name=\"proxy toggle thumb\">\n                                    </span>\n                                </span>\n                            </button>\n                        </div>\n                    </div>\n                </section>\n                <aside aria-labelledby=\"telemetry-title\" class=\"telemetry-panel col-span-4 flex min-h-[584px] flex-col overflow-hidden rounded-[10px] border border-[var(--line-soft)] bg-[var(--surface)]\" data-kid=\"1-1-2-2-2\" data-name=\"telemetry panel\">\n                    <div class=\"telemetry-top border-b border-[var(--line)] px-6 py-6\" data-kid=\"1-1-2-2-2-1\" data-name=\"telemetry header\">\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"telemetry title row\">\n                            <h2 class=\"text-[11px] font-medium uppercase tracking-[0.18em] text-[var(--text-muted)]\" data-kid=\"1-1-2-2-2-1-1-1\" data-name=\"telemetry section title\" id=\"telemetry-title\">\n                                Live telemetry\n                            </h2>\n                            <span class=\"lunar-mono text-[10px] text-[var(--text-muted)]\" data-kid=\"1-1-2-2-2-1-1-2\" data-name=\"telemetry interval label\">\n                                60 SEC\n                            </span>\n                        </div>\n                        <div class=\"mt-7 grid grid-cols-2 gap-4\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"speed stats container\">\n                            <div data-kid=\"1-1-2-2-2-1-2-1\" data-name=\"download speed container\">\n                                <p class=\"text-[12px] text-[var(--text-muted)]\" data-kid=\"1-1-2-2-2-1-2-1-1\" data-name=\"download label\">\n                                    Download\n                                </p>\n                                <p class=\"lunar-tight mt-1 whitespace-nowrap text-[29px] font-semibold leading-none tabular-nums tracking-[-0.02em] text-[var(--text-primary)]\" data-kid=\"1-1-2-2-2-1-2-1-2\" data-name=\"download speed value\">\n                                    82.4\n                                    <span class=\"text-[12px] font-medium tracking-normal text-[var(--text-body)]\" data-kid=\"1-1-2-2-2-1-2-1-2-1\" data-name=\"download unit\">\n                                        Mbps\n                                    </span>\n                                </p>\n                            </div>\n                            <div data-kid=\"1-1-2-2-2-1-2-2\" data-name=\"upload speed container\">\n                                <p class=\"text-[12px] text-[var(--text-muted)]\" data-kid=\"1-1-2-2-2-1-2-2-1\" data-name=\"upload label\">\n                                    Upload\n                                </p>\n                                <p class=\"lunar-tight mt-1 whitespace-nowrap text-[29px] font-semibold leading-none tabular-nums tracking-[-0.02em] text-[var(--text-primary)]\" data-kid=\"1-1-2-2-2-1-2-2-2\" data-name=\"upload speed value\">\n                                    18.7\n                                    <span class=\"text-[12px] font-medium tracking-normal text-[var(--text-body)]\" data-kid=\"1-1-2-2-2-1-2-2-2-1\" data-name=\"upload unit\">\n                                        Mbps\n                                    </span>\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"telemetry-chart flex-1 px-6 py-6\" data-kid=\"1-1-2-2-2-2\" data-name=\"telemetry chart container\">\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"chart header\">\n                            <p class=\"text-[12px] text-[var(--text-body)]\" data-kid=\"1-1-2-2-2-2-1-1\" data-name=\"chart description\">\n                                Last 60 seconds\n                            </p>\n                            <span class=\"lunar-mono text-[10px] text-[var(--text-muted)]\" data-kid=\"1-1-2-2-2-2-1-2\" data-name=\"chart unit label\">\n                                Mbps\n                            </span>\n                        </div>\n                        <svg aria-label=\"Download and upload speeds over the last 60 seconds\" class=\"mt-5 h-[202px] w-full\" data-kid=\"1-1-2-2-2-2-2\" data-name=\"telemetry speed chart\" role=\"img\" viewbox=\"0 0 260 200\">\n                            <path d=\"M0 44H260 M0 80H260 M0 115H260 M0 150H260\" fill=\"none\" opacity=\"0.72\" stroke=\"var(--line)\" stroke-dasharray=\"2 6\" stroke-width=\"1\">\n                            </path>\n                            <path d=\"M0 164H260\" fill=\"none\" stroke=\"var(--line)\" stroke-width=\"1\">\n                            </path>\n                            <path d=\"M0 158 C13 153 22 149 31 142 S47 129 57 139 S72 156 84 141 S98 116 109 128 S125 145 137 117 S151 104 161 112 S177 124 189 93 S204 103 215 80 S231 91 242 62 S252 57 260 47\" fill=\"none\" stroke=\"var(--lavender)\" stroke-linecap=\"round\" stroke-width=\"2\">\n                            </path>\n                            <path d=\"M0 163 C14 158 24 159 35 154 S52 158 64 151 S83 151 94 144 S112 148 123 138 S141 142 151 132 S168 136 180 123 S195 131 207 116 S223 122 234 108 S250 111 260 99\" fill=\"none\" stroke=\"var(--upload-line)\" stroke-linecap=\"round\" stroke-width=\"2\">\n                            </path>\n                            <g fill=\"var(--text-muted)\" font-family=\"IBM Plex Mono, monospace\" font-size=\"9\">\n                                <text x=\"0\" y=\"184\">\n                                    60s\n                                </text>\n                                <text x=\"119\" y=\"184\">\n                                    30s\n                                </text>\n                                <text x=\"239\" y=\"184\">\n                                    now\n                                </text>\n                            </g>\n                            <g opacity=\"0.8\" stroke=\"var(--text-muted)\" stroke-width=\"1\">\n                                <path d=\"M0 164v5 M52 164v5 M104 164v5 M156 164v5 M208 164v5 M260 164v5\">\n                                </path>\n                            </g>\n                            <g class=\"lunar-mono\" font-size=\"10\" font-weight=\"500\">\n                                <rect fill=\"var(--surface)\" height=\"19\" opacity=\"0.96\" rx=\"3\" width=\"72\" x=\"185\" y=\"17\">\n                                </rect>\n                                <text fill=\"var(--lavender)\" x=\"191\" y=\"30\">\n                                    Download\n                                </text>\n                                <rect fill=\"var(--surface)\" height=\"19\" opacity=\"0.96\" rx=\"3\" width=\"72\" x=\"185\" y=\"139\">\n                                </rect>\n                                <text fill=\"var(--upload-line)\" x=\"191\" y=\"152\">\n                                    Upload\n                                </text>\n                            </g>\n                        </svg>\n                    </div>\n                    <div class=\"telemetry-session flex items-end justify-between border-t border-[var(--line)] px-6 py-6\" data-kid=\"1-1-2-2-2-3\" data-name=\"telemetry session container\">\n                        <div data-kid=\"1-1-2-2-2-3-1\" data-name=\"session traffic stats container\">\n                            <p class=\"text-[12px] text-[var(--text-muted)]\" data-kid=\"1-1-2-2-2-3-1-1\" data-name=\"session traffic label\">\n                                Session traffic\n                            </p>\n                            <p class=\"lunar-tight mt-2 text-[27px] font-semibold leading-none tabular-nums tracking-[-0.02em] text-[var(--text-primary)]\" data-kid=\"1-1-2-2-2-3-1-2\" data-name=\"session traffic value\">\n                                1.84\n                                <span class=\"text-[12px] font-medium tracking-normal text-[var(--text-body)]\" data-kid=\"1-1-2-2-2-3-1-2-1\" data-name=\"session traffic unit\">\n                                    GB\n                                </span>\n                            </p>\n                        </div>\n                        <i aria-hidden=\"true\" class=\"ti ti-activity text-[19px] text-[var(--lavender)]\" data-kid=\"1-1-2-2-2-3-2\" data-name=\"activity icon\">\n                        </i>\n                    </div>\n                </aside>\n            </div>\n        </main>\n    </div>\n</div>\n<script>\n    (() => {\n    const app = document.getElementById('lunar-app');\n    const collapseButton = document.getElementById('collapse-sidebar');\n    const dial = document.getElementById('connect-dial');\n    const disconnectAction = document.getElementById('disconnect-action');\n    const status = dial.querySelector('.dial-status');\n\n    collapseButton.addEventListener('click', () => {\n      const collapsed = app.classList.toggle('is-collapsed');\n      collapseButton.setAttribute('aria-expanded', String(!collapsed));\n      collapseButton.setAttribute('title', collapsed ? 'Expand sidebar' : 'Collapse sidebar');\n    });\n\n    document.querySelectorAll('[data-toggle]').forEach((toggle) => {\n      toggle.addEventListener('click', () => {\n        const nextState = toggle.getAttribute('aria-checked') !== 'true';\n        toggle.setAttribute('aria-checked', String(nextState));\n        toggle.classList.toggle('is-on', nextState);\n      });\n    });\n\n    const setConnection = (connected) => {\n      dial.dataset.state = connected ? 'connected' : 'disconnected';\n      dial.setAttribute('aria-pressed', String(connected));\n      dial.setAttribute('aria-label', `Connection control: ${connected ? 'Connected' : 'Disconnected'}`);\n      status.textContent = connected ? 'Connected' : 'Disconnected';\n      disconnectAction.textContent = connected ? 'Disconnect' : 'Connect';\n      disconnectAction.dataset.action = connected ? 'disconnect' : 'connect';\n    };\n\n    dial.addEventListener('click', () => setConnection(dial.dataset.state !== 'connected'));\n    disconnectAction.addEventListener('click', () => setConnection(dial.dataset.state !== 'connected'));\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-09-03T06:04:44.325053+00:00",
      "modified": "2026-09-03T06:05:39.504215+00:00",
      "id": "var_98f6ee27aa7c"
    },
    "var_cad39bcd3eea": {
      "type": "variant",
      "label": "Kagerou — Profiles",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Inter+Tight:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .kagerou-profiles {\n    --canvas: #1A1B1E;\n    --sidebar: #17181B;\n    --surface: #222329;\n    --raised: #292A31;\n    --selected: #312E3B;\n    --row-hover: #282930;\n    --hairline: #2A2B31;\n    --lavender: #AA9BD7;\n    --lavender-hi: #C3B7E6;\n    --ink: #211F27;\n    --primary: #F2F0F6;\n    --body-copy: #C8C5D0;\n    --muted: #918D99;\n    --good: #70B68E;\n    --warn: #D1AA64;\n    --bad: #CF747B;\n    color-scheme: dark;\n  }\n\n  .kagerou-profiles .nav-link:hover,\n  .kagerou-profiles .nav-link:focus-visible {\n    background: var(--row-hover);\n    color: var(--primary);\n  }\n\n  .kagerou-profiles .nav-link[aria-current='page'] {\n    background: var(--selected);\n    color: var(--primary);\n  }\n\n  .kagerou-profiles .nav-link[aria-current='page'] .nav-icon {\n    color: var(--lavender);\n  }\n\n  .kagerou-profiles .nav-icon {\n    color: var(--muted);\n  }\n\n  .kagerou-profiles .nav-link:focus-visible,\n  .kagerou-profiles .sidebar-button:focus-visible,\n  .kagerou-profiles .group-trigger:focus-visible,\n  .kagerou-profiles .test-all:focus-visible,\n  .kagerou-profiles .select-action:focus-visible {\n    outline: 2px solid var(--lavender);\n    outline-offset: 3px;\n  }\n\n  .kagerou-profiles .profile-grid {\n    grid-template-columns: minmax(0, 2.25fr) minmax(132px, .9fr) minmax(124px, .72fr) 116px;\n  }\n\n  .kagerou-profiles .disclosure[data-open='false'] .disclosure-header {\n    border-bottom-color: transparent;\n  }\n\n  .kagerou-profiles .disclosure-panel {\n    display: grid;\n    grid-template-rows: 1fr;\n    transition: grid-template-rows 180ms ease;\n  }\n\n  .kagerou-profiles .disclosure[data-open='false'] .disclosure-panel {\n    grid-template-rows: 0fr;\n  }\n\n  .kagerou-profiles .disclosure-panel-inner {\n    min-height: 0;\n    overflow: hidden;\n  }\n\n  .kagerou-profiles .disclosure-chevron {\n    transition: transform 180ms ease, color 180ms ease;\n  }\n\n  .kagerou-profiles .disclosure[data-open='false'] .disclosure-chevron {\n    transform: rotate(-90deg);\n  }\n\n  .kagerou-profiles .group-trigger:hover .disclosure-chevron {\n    color: var(--lavender-hi);\n  }\n\n  .kagerou-profiles .profile-row {\n    min-width: 0;\n  }\n\n  .kagerou-profiles .profile-row:hover {\n    background: var(--row-hover);\n  }\n\n  .kagerou-profiles .profile-row[data-selected='true'],\n  .kagerou-profiles .profile-row[data-selected='true']:hover {\n    background: var(--selected);\n  }\n\n  .kagerou-profiles .profile-row:focus-visible,\n  .kagerou-profiles .profile-row:focus-within {\n    box-shadow: inset 0 0 0 1px var(--lavender);\n  }\n\n  .kagerou-profiles .server-name {\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .kagerou-profiles .select-action {\n    border: 1px solid var(--hairline);\n    color: var(--body-copy);\n  }\n\n  .kagerou-profiles .select-action:hover {\n    background: var(--raised);\n    border-color: #464650;\n    color: var(--primary);\n  }\n\n  .kagerou-profiles .profile-row[data-selected='true'] .select-action {\n    border-color: transparent;\n    background: var(--lavender);\n    color: var(--ink);\n  }\n\n  .kagerou-profiles .profile-row[data-selected='true'] .select-action:hover {\n    background: var(--lavender-hi);\n  }\n\n  .kagerou-profiles .status-dot {\n    height: 6px;\n    width: 6px;\n    flex: 0 0 6px;\n    border-radius: 999px;\n  }\n\n  .kagerou-profiles.is-collapsed .sidebar-wordmark,\n  .kagerou-profiles.is-collapsed .nav-label,\n  .kagerou-profiles.is-collapsed .sidebar-button-label {\n    display: none;\n  }\n\n  .kagerou-profiles.is-collapsed .sidebar-mark-row,\n  .kagerou-profiles.is-collapsed .nav-link,\n  .kagerou-profiles.is-collapsed .sidebar-button {\n    justify-content: center;\n  }\n\n  .kagerou-profiles.is-collapsed .sidebar {\n    width: 68px;\n    padding-left: 12px;\n    padding-right: 12px;\n  }\n\n  @media (max-width: 960px) {\n    .kagerou-profiles .sidebar {\n      width: 68px;\n      padding-left: 12px;\n      padding-right: 12px;\n    }\n\n    .kagerou-profiles .sidebar-wordmark,\n    .kagerou-profiles .nav-label,\n    .kagerou-profiles .sidebar-button-label,\n    .kagerou-profiles .sidebar-status {\n      display: none;\n    }\n\n    .kagerou-profiles .sidebar-mark-row,\n    .kagerou-profiles .nav-link,\n    .kagerou-profiles .sidebar-button {\n      justify-content: center;\n    }\n\n    .kagerou-profiles .profile-grid {\n      grid-template-columns: minmax(0, 1.7fr) minmax(112px, .9fr) minmax(108px, .7fr) 94px;\n    }\n  }\n</style>\n<div class=\"kagerou-profiles flex min-h-screen w-full overflow-x-clip bg-[var(--canvas)] font-['Inter'] text-[var(--primary)] antialiased\" data-kid=\"1\" id=\"profiles-app\">\n    <aside aria-label=\"Primary navigation\" class=\"sidebar flex w-[216px] shrink-0 flex-col border-r border-[var(--hairline)] bg-[var(--sidebar)] px-3 py-6\" data-kid=\"1-1\">\n        <div class=\"sidebar-mark-row mb-11 flex items-center gap-3 px-3\" data-kid=\"1-1-1\">\n            <span aria-hidden=\"true\" class=\"relative flex h-9 w-9 shrink-0 items-center justify-center\" data-kid=\"1-1-1-1\">\n                <span class=\"absolute left-0 top-0 h-8 w-8 rounded-full bg-[var(--lavender)]\" data-kid=\"1-1-1-1-1\">\n                </span>\n                <span class=\"absolute right-0 top-0.5 h-7 w-7 translate-x-1 rounded-full bg-[var(--sidebar)]\" data-kid=\"1-1-1-1-2\">\n                </span>\n            </span>\n            <span class=\"sidebar-wordmark min-w-0\" data-kid=\"1-1-1-2\">\n                <span class=\"block font-['Inter Tight'] text-[18px] font-semibold leading-none tracking-[-0.02em]\" data-kid=\"1-1-1-2-1\">\n                    Kagerou\n                </span>\n                <span class=\"mt-2 block text-[9px] uppercase tracking-[0.2em] text-[var(--muted)]\" data-kid=\"1-1-1-2-2\">\n                    Instrument panel\n                </span>\n            </span>\n        </div>\n        <nav aria-label=\"Primary navigation\" class=\"flex flex-col gap-1\" data-kid=\"1-1-2\">\n            <a class=\"nav-link flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body-copy)] transition-colors duration-150\" data-kid=\"1-1-2-1\" href=\"#dashboard\">\n                <span class=\"nav-icon flex h-5 w-5 shrink-0 items-center justify-center text-[18px]\" data-kid=\"1-1-2-1-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard\" data-kid=\"1-1-2-1-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-1-2\">\n                    Dashboard\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"nav-link flex h-10 items-center gap-3 rounded-[8px] bg-[var(--selected)] px-3 text-[13px] font-medium text-[var(--primary)] transition-colors duration-150\" data-kid=\"1-1-2-2\" href=\"#profiles\">\n                <span class=\"nav-icon flex h-5 w-5 shrink-0 items-center justify-center text-[18px]\" data-kid=\"1-1-2-2-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-server\" data-kid=\"1-1-2-2-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-2-2\">\n                    Profiles\n                </span>\n            </a>\n            <a class=\"nav-link flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body-copy)] transition-colors duration-150\" data-kid=\"1-1-2-3\" href=\"#subscriptions\">\n                <span class=\"nav-icon flex h-5 w-5 shrink-0 items-center justify-center text-[18px]\" data-kid=\"1-1-2-3-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-rs