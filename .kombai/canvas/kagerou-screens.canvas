    "var_ce7fa3c94443": {
      "type": "variant",
      "label": "Kagerou — Sources",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 9660,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Inter+Tight:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .kagerou-sources {\n    --canvas: #1A1B1E;\n    --sidebar: #17181B;\n    --surface: #222329;\n    --raised: #292A31;\n    --selected: #312E3B;\n    --row-hover: #282930;\n    --hairline: #2A2B31;\n    --lavender: #AA9BD7;\n    --lavender-hi: #C3B7E6;\n    --ink: #211F27;\n    --primary: #F2F0F6;\n    --body-copy: #C8C5D0;\n    --muted: #918D99;\n    --quiet: #77747F;\n    --good: #70B68E;\n    --warn: #D1AA64;\n    --bad: #CF747B;\n    color-scheme: dark;\n  }\n\n  .kagerou-sources .font-display { font-family: 'Inter Tight', sans-serif; }\n  .kagerou-sources .font-data { font-family: 'IBM Plex Mono', monospace; }\n  .kagerou-sources [hidden] { display: none; }\n  .kagerou-sources .source-card { transition: background-color 150ms ease, border-color 150ms ease; }\n  .kagerou-sources .source-card:hover { background: var(--row-hover); border-color: #3A3942; }\n  .kagerou-sources .source-card:focus-within { box-shadow: inset 0 0 0 1px var(--lavender); }\n  .kagerou-sources .nav-link:hover,\n  .kagerou-sources .nav-link:focus-visible,\n  .kagerou-sources .sidebar-button:hover,\n  .kagerou-sources .sidebar-button:focus-visible { background: var(--row-hover); color: var(--primary); }\n  .kagerou-sources .nav-link[aria-current='page'] { background: var(--selected); color: var(--primary); }\n  .kagerou-sources .nav-link[aria-current='page'] .nav-icon { color: var(--lavender); }\n  .kagerou-sources .nav-link:focus-visible,\n  .kagerou-sources .sidebar-button:focus-visible,\n  .kagerou-sources .action-button:focus-visible,\n  .kagerou-sources .menu-item:focus-visible,\n  .kagerou-sources .modal-control:focus-visible,\n  .kagerou-sources .source-field:focus-visible,\n  .kagerou-sources .modal-close:focus-visible,\n  .kagerou-sources .dialog-action:focus-visible { outline: 2px solid var(--lavender); outline-offset: 3px; }\n  .kagerou-sources .action-button { transition: color 150ms ease, background-color 150ms ease, border-color 150ms ease; }\n  .kagerou-sources .action-button:hover { background: var(--raised); color: var(--primary); border-color: #464650; }\n  .kagerou-sources .primary-action:hover { background: var(--lavender-hi); }\n  .kagerou-sources .add-menu,\n  .kagerou-sources .overflow-menu,\n  .kagerou-sources .toast,\n  .kagerou-sources .modal-layer { z-index: 50; }\n  .kagerou-sources .add-menu { box-shadow: 0 18px 40px rgba(0,0,0,.28); }\n  .kagerou-sources .overflow-menu { box-shadow: 0 16px 32px rgba(0,0,0,.28); }\n  .kagerou-sources .modal-layer { background: rgba(13,14,16,.78); }\n  .kagerou-sources .modal-card { box-shadow: 0 18px 48px rgba(0,0,0,.34); }\n  .kagerou-sources .type-option.is-selected { background: var(--selected); color: var(--primary); box-shadow: inset 0 0 0 1px rgba(170,155,215,.24); }\n  .kagerou-sources .type-option:not(.is-selected):hover { background: var(--raised); color: var(--primary); }\n  .kagerou-sources .status-good { color: var(--good); background: rgba(112,182,142,.12); }\n  .kagerou-sources .status-warn { color: var(--warn); background: rgba(209,170,100,.12); }\n  .kagerou-sources .status-neutral { color: var(--lavender-hi); background: rgba(170,155,215,.12); }\n  .kagerou-sources .source-icon { background: var(--raised); color: var(--lavender-hi); }\n  .kagerou-sources .source-card[data-source-type='key'] .source-icon { color: var(--good); }\n  .kagerou-sources .source-card.is-updating .source-icon { color: var(--warn); }\n  .kagerou-sources .source-card.is-updating .source-status { color: var(--warn); background: rgba(209,170,100,.12); }\n  .kagerou-sources.is-collapsed .sidebar { width: 68px; padding-left: 12px; padding-right: 12px; }\n  .kagerou-sources.is-collapsed .sidebar-wordmark,\n  .kagerou-sources.is-collapsed .nav-label,\n  .kagerou-sources.is-collapsed .sidebar-button-label { display: none; }\n  .kagerou-sources.is-collapsed .sidebar-mark-row,\n  .kagerou-sources.is-collapsed .nav-link,\n  .kagerou-sources.is-collapsed .sidebar-button { justify-content: center; }\n  @media (max-width: 960px) {\n    .kagerou-sources .sidebar { width: 68px; padding-left: 12px; padding-right: 12px; }\n    .kagerou-sources .sidebar-wordmark,\n    .kagerou-sources .nav-label,\n    .kagerou-sources .sidebar-button-label { display: none; }\n    .kagerou-sources .sidebar-mark-row,\n    .kagerou-sources .nav-link,\n    .kagerou-sources .sidebar-button { justify-content: center; }\n    .kagerou-sources .content-wrap { padding-left: 28px; padding-right: 28px; }\n  }\n</style>\n<div class=\"kagerou-sources flex min-h-screen w-full overflow-x-clip bg-[var(--canvas)] font-['Inter'] text-[var(--primary)] antialiased\" data-kid=\"1\" id=\"sources-app\">\n    <aside aria-label=\"Primary navigation\" class=\"sidebar flex w-[216px] shrink-0 flex-col border-r border-[var(--hairline)] bg-[var(--sidebar)] px-3 py-6\" data-kid=\"1-1\">\n        <div class=\"sidebar-mark-row mb-11 flex items-center gap-3 px-3\" data-kid=\"1-1-1\">\n            <span aria-hidden=\"true\" class=\"relative flex h-9 w-9 shrink-0 items-center justify-center\" data-kid=\"1-1-1-1\">\n                <span class=\"absolute left-0 top-0 h-8 w-8 rounded-full bg-[var(--lavender)]\" data-kid=\"1-1-1-1-1\">\n                </span>\n                <span class=\"absolute right-0 top-0.5 h-7 w-7 translate-x-1 rounded-full bg-[var(--sidebar)]\" data-kid=\"1-1-1-1-2\">\n                </span>\n            </span>\n            <span class=\"sidebar-wordmark min-w-0\" data-kid=\"1-1-1-2\">\n                <span class=\"font-display block text-[18px] font-semibold leading-none tracking-[-0.02em]\" data-kid=\"1-1-1-2-1\">\n                    Kagerou\n                </span>\n                <span class=\"mt-2 block text-[9px] uppercase tracking-[0.2em] text-[var(--muted)]\" data-kid=\"1-1-1-2-2\">\n                    Instrument panel\n                </span>\n            </span>\n        </div>\n        <nav aria-label=\"Primary navigation\" class=\"flex flex-col gap-1\" data-kid=\"1-1-2\">\n            <a class=\"nav-link flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body-copy)]\" data-kid=\"1-1-2-1\" href=\"#dashboard\">\n                <span class=\"nav-icon flex h-5 w-5 shrink-0 items-center justify-center text-[18px]\" data-kid=\"1-1-2-1-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard\" data-kid=\"1-1-2-1-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-1-2\">\n                    Dashboard\n                </span>\n            </a>\n            <a class=\"nav-link flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body-copy)]\" data-kid=\"1-1-2-2\" href=\"#profiles\">\n                <span class=\"nav-icon flex h-5 w-5 shrink-0 items-center justify-center text-[18px]\" data-kid=\"1-1-2-2-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-server\" data-kid=\"1-1-2-2-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-2-2\">\n                    Profiles\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"nav-link flex h-10 items-center gap-3 rounded-[8px] bg-[var(--selected)] px-3 text-[13px] font-medium text-[var(--primary)]\" data-kid=\"1-1-2-3\" href=\"#sources\">\n                <span class=\"nav-icon flex h-5 w-5 shrink-0 items-center justify-center text-[18px]\" data-kid=\"1-1-2-3-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-rss\" data-kid=\"1-1-2-3-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-3-2\">\n                    Sources\n                </span>\n            </a>\n            <a class=\"nav-link flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body-copy)]\" data-kid=\"1-1-2-4\" href=\"#routing-rules\">\n                <span class=\"nav-icon flex h-5 w-5 shrink-0 items-center justify-center text-[18px]\" data-kid=\"1-1-2-4-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-route\" data-kid=\"1-1-2-4-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-4-2\">\n                    Routing rules\n                </span>\n            </a>\n            <a class=\"nav-link flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body-copy)]\" data-kid=\"1-1-2-5\" href=\"#logs\">\n                <span class=\"nav-icon flex h-5 w-5 shrink-0 items-center justify-center text-[18px]\" data-kid=\"1-1-2-5-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-file-text\" data-kid=\"1-1-2-5-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-5-2\">\n                    Logs\n                </span>\n            </a>\n            <a class=\"nav-link flex h-10 items-center gap-3 rounded-[8px] px-3 text-[13px] text-[var(--body-copy)]\" data-kid=\"1-1-2-6\" href=\"#settings\">\n                <span class=\"nav-icon flex h-5 w-5 shrink-0 items-center justify-center text-[18px]\" data-kid=\"1-1-2-6-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-settings\" data-kid=\"1-1-2-6-1-1\">\n                    </i>\n                </span>\n                <span class=\"nav-label\" data-kid=\"1-1-2-6-2\">\n                    Settings\n                </span>\n            </a>\n        </nav>\n        <div class=\"mt-auto pt-8\" data-kid=\"1-1-3\">\n            <button aria-expanded=\"true\" aria-label=\"Collapse sidebar\" class=\"sidebar-button flex h-10 w-full items-center gap-3 rounded-[8px] px-3 text-left text-[13px] text-[var(--muted)]\" data-kid=\"1-1-3-1\" id=\"collapse-sidebar\" type=\"button\">\n                <span class=\"flex h-5 w-5 shrink-0 items-center justify-center text-[18px]\" data-kid=\"1-1-3-1-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-layout-sidebar-left-collapse\" data-kid=\"1-1-3-1-1-1\">\n                    </i>\n                </span>\n                <span class=\"sidebar-button-label\" data-kid=\"1-1-3-1-2\">\n                    Collapse sidebar\n                </span>\n            </button>\n        </div>\n    </aside>\n    <main class=\"min-w-0 flex-1 bg-[var(--canvas)]\" data-kid=\"1-2\" id=\"sources\">\n        <div class=\"content-wrap mx-auto w-full max-w-[1040px] px-12 pb-12 pt-10\" data-kid=\"1-2-1\">\n            <header class=\"flex items-start justify-between gap-8\" data-kid=\"1-2-1-1\">\n                <div data-kid=\"1-2-1-1-1\">\n                    <div class=\"flex items-center gap-2 text-[10px] font-medium uppercase tracking-[0.18em] text-[var(--muted)]\" data-kid=\"1-2-1-1-1-1\">\n                        <span data-kid=\"1-2-1-1-1-1-1\">\n                            Kagerou\n                        </span>\n                        <span class=\"text-[#5E5B66]\" data-kid=\"1-2-1-1-1-1-2\">\n                            /\n                        </span>\n                        <span data-kid=\"1-2-1-1-1-1-3\">\n                            Profile sources\n                        </span>\n                    </div>\n                    <h1 class=\"font-display mt-3 text-[34px] font-semibold leading-none tracking-[-0.04em] text-[var(--primary)]\" data-kid=\"1-2-1-1-1-2\">\n                        Sources\n                    </h1>\n                    <p class=\"mt-3 max-w-[600px] text-[13px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-1-1-1-3\">\n                        Manage URLs and keys that provide profiles to Kagerou.\n                    </p>\n                </div>\n                <div class=\"relative mt-1 shrink-0\" data-kid=\"1-2-1-1-2\">\n                    <button aria-controls=\"add-source-menu\" aria-expanded=\"true\" class=\"primary-action inline-flex h-10 items-center gap-2 rounded-[8px] bg-[var(--lavender)] px-4 text-[13px] font-semibold text-[var(--ink)]\" data-kid=\"1-2-1-1-2-1\" id=\"add-source-trigger\" type=\"button\">\n                        <span class=\"text-[16px] leading-none\" data-kid=\"1-2-1-1-2-1-1\">\n                            <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-2-1-1-2-1-1-1\">\n                            </i>\n                        </span>\n                        <span data-kid=\"1-2-1-1-2-1-2\">\n                            Add source\n                        </span>\n                        <span class=\"ml-1 text-[15px] leading-none\" data-kid=\"1-2-1-1-2-1-3\">\n                            <i aria-hidden=\"true\" class=\"add-menu-chevron ti ti-chevron-up\" data-kid=\"1-2-1-1-2-1-3-1\">\n                            </i>\n                        </span>\n                    </button>\n                    <div aria-label=\"Source type\" class=\"add-menu absolute right-0 top-[48px] w-[294px] overflow-hidden rounded-[10px] border border-[var(--hairline)] bg-[var(--raised)]\" data-kid=\"1-2-1-1-2-2\" id=\"add-source-menu\" role=\"menu\">\n                        <div class=\"border-b border-[var(--hairline)] px-4 py-3\" data-kid=\"1-2-1-1-2-2-1\">\n                            <p class=\"text-[11px] font-medium uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-1-2-2-1-1\">\n                                Add a source\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[var(--body-copy)]\" data-kid=\"1-2-1-1-2-2-1-2\">\n                                Choose how Kagerou receives profiles.\n                            </p>\n                        </div>\n                        <button class=\"menu-item flex w-full items-start gap-3 px-4 py-3 text-left text-[var(--body-copy)] hover:bg-[var(--row-hover)]\" data-kid=\"1-2-1-1-2-2-2\" data-source-kind=\"url\" role=\"menuitem\" type=\"button\">\n                            <span class=\"mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-[7px] bg-[var(--selected)] text-[16px] text-[var(--lavender-hi)]\" data-kid=\"1-2-1-1-2-2-2-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-rss\" data-kid=\"1-2-1-1-2-2-2-1-1\">\n                                </i>\n                            </span>\n                            <span class=\"min-w-0\" data-kid=\"1-2-1-1-2-2-2-2\">\n                                <span class=\"block text-[13px] font-medium text-[var(--primary)]\" data-kid=\"1-2-1-1-2-2-2-2-1\">\n                                    Subscription URL\n                                </span>\n                                <span class=\"mt-1 block text-[11px] leading-4 text-[var(--muted)]\" data-kid=\"1-2-1-1-2-2-2-2-2\">\n                                    Import and refresh profiles from a remote URL.\n                                </span>\n                            </span>\n                        </button>\n                        <button class=\"menu-item flex w-full items-start gap-3 border-t border-[var(--hairline)] px-4 py-3 text-left text-[var(--body-copy)] hover:bg-[var(--row-hover)]\" data-kid=\"1-2-1-1-2-2-3\" data-source-kind=\"key\" role=\"menuitem\" type=\"button\">\n                            <span class=\"mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-[7px] bg-[var(--selected)] text-[16px] text-[var(--good)]\" data-kid=\"1-2-1-1-2-2-3-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-key\" data-kid=\"1-2-1-1-2-2-3-1-1\">\n                                </i>\n                            </span>\n                            <span class=\"min-w-0\" data-kid=\"1-2-1-1-2-2-3-2\">\n                                <span class=\"block text-[13px] font-medium text-[var(--primary)]\" data-kid=\"1-2-1-1-2-2-3-2-1\">\n                                    Single key\n                                </span>\n                                <span class=\"mt-1 block text-[11px] leading-4 text-[var(--muted)]\" data-kid=\"1-2-1-1-2-2-3-2-2\">\n                                    Add one key as a single local profile.\n                                </span>\n                            </span>\n                        </button>\n                    </div>\n                </div>\n            </header>\n            <div class=\"mt-8 flex items-center justify-between border-b border-[var(--hairline)] pb-3\" data-kid=\"1-2-1-2\">\n                <p class=\"font-data text-[11px] text-[var(--body-copy)]\" data-kid=\"1-2-1-2-1\">\n                    <span data-dynamic=\"true\" data-kid=\"1-2-1-2-1-1\" data-name=\"source count\" data-reason=\"number text updated when sources are removed by script\" id=\"source-count\">\n                        3\n                    </span>\n                    sources\n                    <span class=\"px-1.5 text-[var(--quiet)]\" data-kid=\"1-2-1-2-1-2\">\n                        ·\n                    </span>\n                    <span data-dynamic=\"true\" data-kid=\"1-2-1-2-1-3\" data-name=\"profile count\" data-reason=\"number text updated when sources are removed by script\" id=\"profile-count\">\n                        8\n                    </span>\n                    profiles\n                </p>\n                <p class=\"flex items-center gap-2 text-[11px] text-[var(--muted)]\" data-kid=\"1-2-1-2-2\">\n                    <i aria-hidden=\"true\" class=\"ti ti-info-circle text-[14px]\" data-kid=\"1-2-1-2-2-1\">\n                    </i>\n                    Selection and order live on Profiles\n                </p>\n            </div>\n            <section aria-label=\"Profile sources\" class=\"mt-4 space-y-3\" data-kid=\"1-2-1-3\" id=\"source-list\">\n                <article class=\"source-card rounded-[10px] border border-[var(--hairline)] bg-[var(--surface)] p-5\" data-kid=\"1-2-1-3-1\" data-source-id=\"personal\" data-source-type=\"url\">\n                    <div class=\"flex items-start justify-between gap-5\" data-kid=\"1-2-1-3-1-1\">\n                        <div class=\"flex min-w-0 items-start gap-3.5\" data-kid=\"1-2-1-3-1-1-1\">\n                            <span class=\"source-icon flex h-10 w-10 shrink-0 items-center justify-center rounded-[9px] text-[19px]\" data-kid=\"1-2-1-3-1-1-1-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-rss\" data-kid=\"1-2-1-3-1-1-1-1-1\">\n                                </i>\n                            </span>\n                            <div class=\"min-w-0\" data-kid=\"1-2-1-3-1-1-1-2\">\n                                <div class=\"flex flex-wrap items-center gap-2.5\" data-kid=\"1-2-1-3-1-1-1-2-1\">\n                                    <h2 class=\"font-display text-[18px] font-semibold tracking-[-0.02em] text-[var(--primary)]\" data-kid=\"1-2-1-3-1-1-1-2-1-1\">\n                                        Personal / North America\n                                    </h2>\n                                    <span class=\"source-status status-good rounded-full px-2 py-1 text-[10px] font-medium\" data-dynamic=\"true\" data-kid=\"1-2-1-3-1-1-1-2-1-2\" data-name=\"source status badge\" data-reason=\"text and class updated when source is refreshed by script\" data-status=\"\">\n                                        Up to date\n                                    </span>\n                                </div>\n                                <p class=\"mt-1 text-[11px] text-[var(--muted)]\" data-kid=\"1-2-1-3-1-1-1-2-2\">\n                                    <span data-kid=\"1-2-1-3-1-1-1-2-2-1\" data-source-kind-label=\"\">\n                                        Subscription URL\n                                    </span>\n                                  