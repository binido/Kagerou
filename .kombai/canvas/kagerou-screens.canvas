      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Inter+Tight:wght@500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .lunar-app {\n    --canvas: #1a1b1e;\n    --sidebar: #17181b;\n    --surface: #222329;\n    --surface-hover: #282930;\n    --selected: #2d2a36;\n    --viewport: #141518;\n    --accent: #aa9bd7;\n    --accent-bright: #c3b7e6;\n    --text: #f2f0f6;\n    --body: #c8c5d0;\n    --muted: #918d99;\n    --quiet: #77747f;\n    --good: #70b68e;\n    --warn: #d1aa64;\n    --error: #cf747b;\n    font-family: 'Inter', sans-serif;\n    color: var(--text);\n  }\n\n  .lunar-heading { font-family: 'Inter Tight', sans-serif; }\n  .lunar-log-font { font-family: 'IBM Plex Mono', monospace; }\n\n  .lunar-log-scroll {\n    scrollbar-color: #5a5664 transparent;\n    scrollbar-width: thin;\n    scrollbar-gutter: stable;\n  }\n\n  .lunar-log-scroll:focus-visible {\n    outline: 2px solid var(--accent);\n    outline-offset: 2px;\n  }\n\n  .lunar-log-scroll::-webkit-scrollbar { width: 9px; }\n  .lunar-log-scroll::-webkit-scrollbar-track { background: transparent; }\n  .lunar-log-scroll::-webkit-scrollbar-thumb {\n    background: #5a5664;\n    border: 2px solid var(--viewport);\n    border-radius: 999px;\n  }\n\n  .log-match {\n    color: inherit;\n    background: transparent;\n    text-decoration-line: underline;\n    text-decoration-color: var(--accent);\n    text-decoration-thickness: 2px;\n    text-underline-offset: 3px;\n  }\n\n  @media (max-width: 1179px) {\n    .lunar-sidebar { width: 68px; padding-left: 10px; padding-right: 10px; }\n    .lunar-brand { justify-content: center; padding-left: 0; padding-right: 0; }\n    .lunar-brand-copy,\n    .lunar-side-heading,\n    .lunar-nav-label,\n    .lunar-side-status,\n    .lunar-collapse-copy { display: none; }\n    .lunar-nav-button,\n    .lunar-collapse-button { ju