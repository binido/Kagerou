name and region info\">\n                                    <p class=\"truncate text-sm font-medium text-[var(--primary)]\" data-kid=\"1-1-2-1-2-1-2-5-1-1\" data-name=\"profile name text\">\n                                        Montreal · 04\n                                    </p>\n                                    <p class=\"mt-1 truncate text-xs text-[var(--meta)]\" data-kid=\"1-1-2-1-2-1-2-5-1-2\" data-name=\"profile region text\">\n                                        ca-east-1\n                                    </p>\n                                </div>\n                                <span class=\"w-fit rounded-[6px] bg-[var(--raised)] px-2 py-1 text-[11px] font-medium text-[var(--body)]\" data-kid=\"1-1-2-1-2-1-2-5-2\" data-name=\"protocol badge\">\n                                    Hysteria2\n                                </span>\n                                <span class=\"flex items-center gap-2 text-xs tabular-nums text-[var(--body)]\" data-kid=\"1-1-2-1-2-1-2-5-3\" data-name=\"ping indicator container\">\n                                    <span class=\"h-2 w-2 rounded-full bg-[var(--poor)]\" data-kid=\"1-1-2-1-2-1-2-5-3-1\" data-name=\"ping status dot\">\n                                    </span>\n                                    128 ms\n                                </span>\n                                <button aria-pressed=\"false\" class=\"justify-self-end rounded-lg px-2.5 py-1.5 text-xs font-medium text-[var(--body)] hover:bg-white/[0.06] hover:text-[var(--primary)] focus-visible:outline-2 focus-visible:outline-[var(--lavender)] focus-visible:outline-offset-2\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-1-2-5-4\" data-name=\"profile select toggle button\" data-reason=\"aria-pressed, button state, icon rendering and classes updated by script\" data-select=\"\" type=\"button\">\n                                    <span data-action-label=\"\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-1-2-5-4-1\" data-name=\"action label text\" data-reason=\"text content updated by script\">\n                                        Select\n                                    </span>\n                                </button>\n                            </div>\n                        </div>\n                    </section>\n                    <section aria-labelledby=\"work-group-title\" class=\"overflow-hidden rounded-[10px] bg-[var(--surface)]\" data-kid=\"1-1-2-1-2-2\" data-name=\"work subscription group section\">\n                        <div class=\"flex min-h-[72px] items-center justify-between gap-4 px-5\" data-kid=\"1-1-2-1-2-2-1\" data-name=\"group header and action bar\">\n                            <button aria-controls=\"work-profiles\" aria-expanded=\"false\" class=\"flex min-w-0 flex-1 items-center gap-3 rounded-lg py-2 text-left hover:text-[var(--lavender-hi)] focus-visible:outline-2 focus-visible:outline-[var(--lavender)] focus-visible:outline-offset-2\" data-disclosure=\"work-profiles\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-1-1\" data-name=\"group toggle button\" data-reason=\"aria-expanded attribute updated by script\" type=\"button\">\n                                <span class=\"flex w-5 shrink-0 justify-center text-[19px] leading-none text-[var(--body)]\" data-kid=\"1-1-2-1-2-2-1-1-1\" data-name=\"group toggle chevron container\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-chevron-right\" data-chevron=\"\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-1-1-1-1\" data-name=\"chevron icon\" data-reason=\"icon class toggled by script\">\n                                    </i>\n                                </span>\n                                <span class=\"min-w-0\" data-kid=\"1-1-2-1-2-2-1-1-2\" data-name=\"group information wrapper\">\n                                    <span class=\"block truncate font-tight text-[17px] font-semibold tracking-[-0.015em] text-[var(--primary)]\" data-kid=\"1-1-2-1-2-2-1-1-2-1\" data-name=\"group title\" id=\"work-group-title\">\n                                        Work / Europe\n                                    </span>\n                                    <span class=\"mt-1 block text-xs text-[var(--meta)]\" data-kid=\"1-1-2-1-2-2-1-1-2-2\" data-name=\"group profile count text\">\n                                        3 profiles\n                                    </span>\n                                </span>\n                            </button>\n                            <button class=\"inline-flex h-9 shrink-0 items-center gap-1.5 rounded-lg px-3 text-xs font-medium text-[var(--body)] hover:bg-[var(--raised)] hover:text-[var(--primary)] focus-visible:outline-2 focus-visible:outline-[var(--lavender)] focus-visible:outline-offset-2\" data-kid=\"1-1-2-1-2-2-1-2\" data-name=\"test all button\" data-test-all=\"\" type=\"button\">\n                                <span data-kid=\"1-1-2-1-2-2-1-2-1\" data-name=\"test all button text\">\n                                    Test all\n                                </span>\n                                <span class=\"text-[14px] leading-none\" data-kid=\"1-1-2-1-2-2-1-2-2\" data-name=\"test all icon container\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-player-play\" data-kid=\"1-1-2-1-2-2-1-2-2-1\" data-name=\"play icon\">\n                                    </i>\n                                </span>\n                            </button>\n                        </div>\n                        <div aria-labelledby=\"work-group-title\" class=\"border-t border-white/[0.06]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-2\" data-name=\"work profiles list\" data-reason=\"hidden attribute toggled by script\" hidden=\"\" id=\"work-profiles\" role=\"region\">\n                            <div class=\"grid min-h-[62px] grid-cols-[minmax(0,1fr)_148px_112px_88px] items-center border-t border-white/[0.05] bg-[var(--surface)] px-5 hover:bg-[var(--raised)]\" data-kid=\"1-1-2-1-2-2-2-1\" data-name=\"first profile row\" data-profile-row=\"\">\n                                <div class=\"min-w-0\" data-kid=\"1-1-2-1-2-2-2-1-1\" data-name=\"profile name and region info\">\n                                    <p class=\"truncate text-sm font-medium text-[var(--primary)]\" data-kid=\"1-1-2-1-2-2-2-1-1-1\" data-name=\"profile name text\">\n                                        Frankfurt · 01\n                                    </p>\n                                    <p class=\"mt-1 truncate text-xs text-[var(--meta)]\" data-kid=\"1-1-2-1-2-2-2-1-1-2\" data-name=\"profile region text\">\n                                        eu-central-1\n                                    </p>\n                                </div>\n                                <span class=\"w-fit rounded-[6px] bg-[var(--raised)] px-2 py-1 text-[11px] font-medium text-[var(--body)]\" data-kid=\"1-1-2-1-2-2-2-1-2\" data-name=\"protocol badge\">\n                                    VMess\n                                </span>\n                                <span class=\"flex items-center gap-2 text-xs tabular-nums text-[var(--body)]\" data-kid=\"1-1-2-1-2-2-2-1-3\" data-name=\"ping indicator container\">\n                                    <span class=\"h-2 w-2 rounded-full bg-[var(--good)]\" data-kid=\"1-1-2-1-2-2-2-1-3-1\" data-name=\"ping status dot\">\n                                    </span>\n                                    47 ms\n                                </span>\n                                <button aria-pressed=\"false\" class=\"justify-self-end rounded-lg px-2.5 py-1.5 text-xs font-medium text-[var(--body)] hover:bg-white/[0.06] hover:text-[var(--primary)] focus-visible:outline-2 focus-visible:outline-[var(--lavender)] focus-visible:outline-offset-2\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-2-1-4\" data-name=\"profile select toggle button\" data-reason=\"aria-pressed, button state, icon rendering and classes updated by script\" data-select=\"\" type=\"button\">\n                                    <span data-action-label=\"\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-2-1-4-1\" data-name=\"action label text\" data-reason=\"text content updated by script\">\n                                        Select\n                                    </span>\n                                </button>\n                            </div>\n                            <div class=\"grid min-h-[62px] grid-cols-[minmax(0,1fr)_148px_112px_88px] items-center border-t border-white/[0.05] bg-[var(--surface)] px-5 hover:bg-[var(--raised)]\" data-kid=\"1-1-2-1-2-2-2-2\" data-name=\"second profile row\" data-profile-row=\"\">\n                                <div class=\"min-w-0\" data-kid=\"1-1-2-1-2-2-2-2-1\" data-name=\"profile name and region info\">\n                                    <p class=\"truncate text-sm font-medium text-[var(--primary)]\" data-kid=\"1-1-2-1-2-2-2-2-1-1\" data-name=\"profile name text\">\n                                        Amsterdam · 02\n                                    </p>\n                                    <p class=\"mt-1 truncate text-xs text-[var(--meta)]\" data-kid=\"1-1-2-1-2-2-2-2-1-2\" data-name=\"profile region text\">\n                                        eu-west-1\n                                    </p>\n                                </div>\n                                <span class=\"w-fit rounded-[6px] bg-[var(--raised)] px-2 py-1 text-[11px] font-medium text-[var(--body)]\" data-kid=\"1-1-2-1-2-2-2-2-2\" data-name=\"protocol badge\">\n                                    VLESS\n                                </span>\n                                <span class=\"flex items-center gap-2 text-xs tabular-nums text-[var(--body)]\" data-kid=\"1-1-2-1-2-2-2-2-3\" data-name=\"ping indicator container\">\n                                    <span class=\"h-2 w-2 rounded-full bg-[var(--moderate)]\" data-kid=\"1-1-2-1-2-2-2-2-3-1\" data-name=\"ping status dot\">\n                                    </span>\n                                    63 ms\n                                </span>\n                                <button aria-pressed=\"false\" class=\"justify-self-end rounded-lg px-2.5 py-1.5 text-xs font-medium text-[var(--body)] hover:bg-white/[0.06] hover:text-[var(--primary)] focus-visible:outline-2 focus-visible:outline-[var(--lavender)] focus-visible:outline-offset-2\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-2-2-4\" data-name=\"profile select toggle button\" data-reason=\"aria-pressed, button state, icon rendering and classes updated by script\" data-select=\"\" type=\"button\">\n                                    <span data-action-label=\"\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-2-2-4-1\" data-name=\"action label text\" data-reason=\"text content updated by script\">\n                                        Select\n                                    </span>\n                                </button>\n                            </div>\n                            <div class=\"grid min-h-[62px] grid-cols-[minmax(0,1fr)_148px_112px_88px] items-center border-t border-white/[0.05] bg-[var(--surface)] px-5 hover:bg-[var(--raised)]\" data-kid=\"1-1-2-1-2-2-2-3\" data-name=\"third profile row\" data-profile-row=\"\">\n                                <div class=\"min-w-0\" data-kid=\"1-1-2-1-2-2-2-3-1\" data-name=\"profile name and region info\">\n                                    <p class=\"truncate text-sm font-medium text-[var(--primary)]\" data-kid=\"1-1-2-1-2-2-2-3-1-1\" data-name=\"profile name text\">\n                                        London · 03\n                                    </p>\n                                    <p class=\"mt-1 truncate text-xs text-[var(--meta)]\" data-kid=\"1-1-2-1-2-2-2-3-1-2\" data-name=\"profile region text\">\n                                        uk-south-1\n                                    </p>\n                                </div>\n                                <span class=\"w-fit rounded-[6px] bg-[var(--raised)] px-2 py-1 text-[11px] font-medium text-[var(--body)]\" data-kid=\"1-1-2-1-2-2-2-3-2\" data-name=\"protocol badge\">\n                                    Trojan\n                                </span>\n                                <span class=\"flex items-center gap-2 text-xs tabular-nums text-[var(--body)]\" data-kid=\"1-1-2-1-2-2-2-3-3\" data-name=\"ping indicator container\">\n                                    <span class=\"h-2 w-2 rounded-full bg-[var(--moderate)]\" data-kid=\"1-1-2-1-2-2-2-3-3-1\" data-name=\"ping status dot\">\n                                    </span>\n                                    91 ms\n                                </span>\n                                <button aria-pressed=\"false\" class=\"justify-self-end rounded-lg px-2.5 py-1.5 text-xs font-medium text-[var(--body)] hover:bg-white/[0.06] hover:text-[var(--primary)] focus-visible:outline-2 focus-visible:outline-[var(--lavender)] focus-visible:outline-offset-2\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-2-3-4\" data-name=\"profile select toggle button\" data-reason=\"aria-pressed, button state, icon rendering and classes updated by script\" data-select=\"\" type=\"button\">\n                                    <span data-action-label=\"\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-2-3-4-1\" data-name=\"action label text\" data-reason=\"text content updated by script\">\n                                        Select\n                                    </span>\n                                </button>\n                            </div>\n                        </div>\n                    </section>\n                </div>\n            </div>\n        </main>\n    </div>\n    <div aria-describedby=\"modal-description\" aria-labelledby=\"modal-title\" aria-modal=\"true\" class=\"lunar-modal fixed inset-0 z-50 flex items-center justify-center bg-[#0D0E10]/74 px-4 py-8\" data-dynamic=\"true\" data-kid=\"1-2\" data-name=\"add subscription modal background\" data-reason=\"hidden/aria-hidden attribute toggled by script\" id=\"subscription-modal\" role=\"dialog\">\n        <div class=\"relative w-[480px] max-w-full rounded-[12px] bg-[var(--raised)] p-6 shadow-[0_18px_48px_rgba(0,0,0,.24)]\" data-kid=\"1-2-1\" data-name=\"modal dialog container\">\n            <div class=\"flex items-start justify-between gap-6\" data-kid=\"1-2-1-1\" data-name=\"modal header bar\">\n                <div data-kid=\"1-2-1-1-1\" data-name=\"modal title container\">\n                    <h2 class=\"font-tight text-[24px] font-semibold leading-tight tracking-[-0.025em] text-[var(--primary)]\" data-kid=\"1-2-1-1-1-1\" data-name=\"modal title heading\" id=\"modal-title\">\n                        Add subscription\n                    </h2>\n                </div>\n                <button aria-label=\"Close add subscription dialog\" class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-[var(--meta)] hover:bg-white/[0.06] hover:text-[var(--primary)] focus-visible:outline-2 focus-visible:outline-[var(--lavender)] focus-visible:outline-offset-2\" data-close-modal=\"\" data-kid=\"1-2-1-1-2\" data-name=\"modal close button\" type=\"button\">\n                    <span class=\"text-[18px] leading-none\" data-kid=\"1-2-1-1-2-1\" data-name=\"close icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-x\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"close icon\">\n                        </i>\n                    </span>\n                </button>\n            </div>\n            <p class=\"sr-only\" data-kid=\"1-2-1-2\" data-name=\"modal description text\" id=\"modal-description\">\n                Add a subscription URL to import profiles into a new group.\n            </p>\n            <form class=\"mt-7\" data-kid=\"1-2-1-3\" data-name=\"subscription add form\" id=\"subscription-form\">\n                <label class=\"mb-2 block text-sm font-medium text-[var(--primary)]\" data-kid=\"1-2-1-3-1\" data-name=\"url input field label\" for=\"subscription-url\">\n                    Subscription URL\n                </label>\n                <input aria-describedby=\"url-hint\" autocomplete=\"url\" class=\"h-11 w-full rounded-lg border border-white/[0.10] bg-[var(--surface)] px-3.5 text-sm text-[var(--body)] placeholder:text-[var(--body)] caret-[var(--lavender-hi)] focus:border-[var(--lavender-hi)] focus:outline-hidden focus:ring-2 focus:ring-[var(--lavender)]/35\" data-dynamic=\"true\" data-kid=\"1-2-1-3-2\" data-name=\"url input text field\" data-reason=\"border color and focus managed by form validation script\" id=\"subscription-url\" name=\"subscription-url\" placeholder=\"https://example.com/subscription\" type=\"url\"/>\n                <p aria-live=\"polite\" class=\"mt-2 flex items-center gap-1.5 text-xs text-[var(--meta)]\" data-dynamic=\"true\" data-kid=\"1-2-1-3-3\" data-name=\"url input hint text\" data-reason=\"class and text content updated by form validation script\" id=\"url-hint\">\n                    <span class=\"text-[14px] leading-none\" data-kid=\"1-2-1-3-3-1\" data-name=\"info icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-info-circle\" data-kid=\"1-2-1-3-3-1-1\" data-name=\"info icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-2-1-3-3-2\" data-name=\"hint description text\">\n                        Paste a URL to import profiles into a new group.\n                    </span>\n                </p>\n                <div class=\"mt-6 flex items-center justify-end gap-2\" data-kid=\"1-2-1-3-4\" data-name=\"modal form action button container\">\n                    <button class=\"rounded-lg px-4 py-2.5 text-sm font-medium text-[var(--body)] hover:bg-white/[0.06] hover:text-[var(--primary)] focus-visible:outline-2 focus-visible:outline-[var(--lavender)] focus-visible:outline-offset-2\" data-close-modal=\"\" data-kid=\"1-2-1-3-4-1\" data-name=\"cancel button\" type=\"button\">\n                        Cancel\n                    </button>\n                    <button class=\"rounded-lg bg-[var(--lavender)] px-4 py-2.5 text-sm font-semibold text-[var(--ink)] hover:bg-[var(--lavender-hi)] focus-visible:outline-2 focus-visible:outline-[var(--lavender-hi)] focus-visible:outline-offset-2\" data-kid=\"1-2-1-3-4-2\" data-name=\"submit button\" type=\"submit\">\n                        Add\n                    </button>\n                </div>\n            </form>\n        </div>\n    </div>\n</div>\n<script>\n    (() => {\n    const modal = document.getElementById('subscription-modal');\n    const input = document.getElementById('subscription-url');\n    const hint = document.getElementById('url-hint');\n    const form = document.getElementById('subscription-form');\n\n    const setModal = (open) => {\n      modal.hidden = !open;\n      modal.setAttribute('aria-hidden', String(!open));\n      if (open) window.requestAnimationFrame(() => input.focus());\n    };\n\n    document.querySelectorAll('[data-open-modal]').forEach((button) => {\n      button.addEventListener('click', () => setModal(true));\n    });\n    document.querySelectorAll('[data-close-modal]').forEach((button) => {\n      button.addEventListener('click', () => setModal(false));\n    });\n    modal.addEventListener('click', (event) => {\n      if (event.target === modal) setModal(false);\n    });\n    document.addEventListener('keydown', (event) => {\n      if (event.key === 'Escape' && !modal.hidden) setModal(false);\n    });\n\n    document.querySelectorAll('[data-disclosure]').forEach((button) => {\n      button.addEventListener('click', () => {\n        const panel = document.getElementById(button.dataset.disclosure);\n        const expanded = button.getAttribute('aria-expanded') === 'true';\n        button.setAttribute('aria-expanded', String(!expanded));\n        panel.hidden = expanded;\n        const chevron = button.querySelector('[data-chevron]');\n        chevron.classList.toggle('ti-chevron-down', !expanded);\n        chevron.classList.toggle('ti-chevron-right', expanded);\n      });\n    });\n\n    document.querySelectorAll('[data-select]').forEach((button) => {\n      button.addEventListener('click', () => {\n        document.querySelectorAll('[data-select]').forEach((other) => {\n          const row = other.closest('[data-profile-row]');\n          const selected = other === button;\n          other.setAttribute('aria-pressed', String(selected));\n          const label = other.querySelector('[data-action-label]');\n          if (label) label.textContent = selected ? 'Selected' : 'Select';\n          const icon = other.querySelector('.ti-check');\n          if (selected && !icon) {\n            const iconWrap = document.createElement('span');\n            iconWrap.className = 'ml-1 text-[14px] leading-none';\n            iconWrap.innerHTML = '<i class=\"ti ti-check\" aria-hidden=\"true\"></i>';\n            other.appendChild(iconWrap);\n          } else if (!selected && icon) {\n            icon.parentElement.remove();\n          }\n          row.classList.toggle('bg-[var(--selected)]', selected);\n          row.classList.toggle('bg-[var(--surface)]', !selected);\n          other.classList.toggle('text-[var(--lavender-hi)]', selected);\n          other.classList.toggle('text-[var(--body)]', !selected);\n        });\n      });\n    });\n\n    form.addEventListener('submit', (event) => {\n      event.preventDefault();\n      const valid = input.value.trim().match(/^https?:\\/\\/[^\\s]+$/i);\n      if (!valid) {\n        hint.className = 'mt-2 flex items-center gap-1.5 text-xs text-[var(--poor)]';\n        hint.querySelector('span:last-child').textContent = 'Enter a valid subscription URL.';\n        input.classList.add('border-[var(--poor)]');\n        input.focus();\n        return;\n      }\n      setModal(false);\n    });\n\n    window.requestAnimationFrame(() => input.focus());\n  })();\n</script>\n",
