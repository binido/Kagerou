      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  body { margin: 0; }\n  .lunar-app { font-family: 'Inter', sans-serif; }\n  .toggle-track {\n    background: #292a31;\n    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.09);\n    transition: background-color 180ms ease, box-shadow 180ms ease;\n  }\n  .toggle-track.is-on {\n    background: #c3b7e6;\n    box-shadow: inset 0 0 0 1px rgba(242, 240, 246, 0.22);\n  }\n  .toggle-thumb {\n    background: #918d99;\n    transform: translateX(0);\n    transition: background-color 180ms ease, transform 180ms ease;\n  }\n  .toggle-thumb.is-on {\n    background: #17181b;\n    transform: translateX(16px);\n  }\n  .toggle-status.is-on { color: #c3b7e6; }\n  .routing-row { border-bottom: 1px solid rgba(255, 255, 255, 0.055); }\n  .routing-row:hover { background: #282930; }\n  .routing-row.is-selected {\n    background: #312e3b;\n    box-shadow: inset 0 0 0 1px rgba(170, 155, 215, 0.2);\n  }\n  .routing-row.is-selected:hover { background: #353140; }\n  .routing-edit { visibility: hidden; }\n  .routing-row.is-selected .routing-edit { visibility: visible; }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"lunar-app min-h-screen w-full overflow-clip bg-[#1a1b1e] text-[#f2f0f6]\" data-kid=\"2\" data-name=\"lunar application container\" id=\"lunar-routing-rules\">\n    <div class=\"flex min-h-screen w-full\" data-kid=\"2-1\" data-name=\"main page layout\">\n        <aside aria-label=\"Main navigation\" class=\"flex w-[216px] shrink-0 flex-col border-r border-white/[0.045] bg-[#17181b] px-3 py-4\" data-kid=\"2-1-1\" data-name=\"sidebar navigation\">\n            <div class=\"mb-9 flex items-center gap-3 px-3\" data-kid=\"2-1-1-1\" data-name=\"brand logo area\">\n                <span aria-hidden=\"true\" class=\"relative flex h-8 w-8 shrink-0 items-center justify-center\" data-kid=\"2-1-1-1-1\" data-name=\"brand icon container\">\n                    <span class=\"absolute left-0 top-0 h-8 w-8 rounded-full bg-[#aa9bd7] ring-1 ring-inset ring-[#c3b7e6]/25\" data-kid=\"2-1-1-1-1-1\" data-name=\"brand icon circle outer\">\n                    </span>\n                    <span class=\"absolute left-[7px] top-0 h-8 w-8 rounded-full bg-[#17181b]\" data-kid=\"2-1-1-1-1-2\" data-name=\"brand icon circle inner\">\n                    </span>\n                </span>\n                <span class=\"text-[15px] font-semibold tracking-[-0.01em] text-[#f2f0f6]\" data-kid=\"2-1-1-1-2\" data-name=\"brand name text\">\n                    Kagerou\n                </span>\n            </div>\n            <div class=\"mb-2 px-3 text-[10px] font-semibold uppercase tracking-[0.16em] text-[#6f6c75]\" data-kid=\"2-1-1-2\" data-name=\"workspace section header\">\n                Workspace\n            </div>\n            <nav aria-label=\"Workspace\" class=\"space-y-1\" data-kid=\"2-1-1-3\" data-name=\"workspace navigation menu\">\n                <a aria-label=\"Dashboard\" class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-[13px] text-[#a7a4ae] outline-hidden ring-[#aa9bd7]/60 transition-colors hover:bg-[#232429] hover:text-[#e8e5ee] focus-visible:ring-2\" data-kid=\"2-1-1-3-1\" data-name=\"dashboard navigation link\" href=\"#dashboard\">\n                    <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard text-[17px]\" data-kid=\"2-1-1-3-1-1\" data-name=\"dashboard icon\">\n                    </i>\n                    <span data-kid=\"2-1-1-3-1-2\" data-name=\"dashboard label text\">\n                        Dashboard\n                    </span>\n                </a>\n                <a aria-label=\"Profiles\" class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-[13px] text-[#a7a4ae] outline-hidden ring-[#aa9bd7]/60 transition-colors hover:bg-[#232429] hover:text-[#e8e5ee] focus-visible:ring-2\" data-kid=\"2-1-1-3-2\" data-name=\"profiles navigation link\" href=\"#profiles\">\n                    <i aria-hidden=\"true\" class=\"ti ti-server text-[17px]\" data-kid=\"2-1-1-3-2-1\" data-name=\"profiles icon\">\n                    </i>\n                    <span data-kid=\"2-1-1-3-2-2\" data-name=\"profiles label text\">\n                        Profiles\n                    </span>\n                </a>\n                <a aria-label=\"Subscriptions\" class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-[13px] text-[#a7a4ae] outline-hidden ring-[#aa9bd7]/60 transition-colors hover:bg-[#232429] hover:text-[#e8e5ee] focus-visible:ring-2\" data-kid=\"2-1-1-3-3\" data-name=\"subscriptions navigation link\" href=\"#subscriptions\">\n                    <i aria-hidden=\"true\" class=\"ti ti-rss text-[17px]\" data-kid=\"2-1-1-3-3-1\" data-name=\"subscriptions icon\">\n                    </i>\n                    <span data-kid=\"2-1-1-3-3-2\" data-name=\"subscriptions label text\">\n                        Subscriptions\n                    </span>\n                </a>\n                <a aria-current=\"page\" aria-label=\"Routing rules\" class=\"flex h-10 items-center gap-3 rounded-lg bg-[#2d2a36] px-3 text-[13px] font-medium text-[#f2f0f6] outline-hidden ring-1 ring-inset ring-[#aa9bd7]/15 focus-visible:ring-2 focus-visible:ring-[#aa9bd7]/70\" data-kid=\"2-1-1-3-4\" data-name=\"routing rules active navigation link\" href=\"#routing-rules\">\n                    <i aria-hidden=\"true\" class=\"ti ti-route text-[17px] text-[#c3b7e6]\" data-kid=\"2-1-1-3-4-1\" data-name=\"routing rules icon\">\n                    </i>\n                    <span data-kid=\"2-1-1-3-4-2\" data-name=\"routing rules label text\">\n                        Routing rules\n                    </span>\n                </a>\n                <a aria-label=\"Logs\" class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-[13px] text-[#a7a4ae] outline-hidden ring-[#aa9bd7]/60 transition-colors hover:bg-[#232429] hover:text-[#e8e5ee] focus-visible:ring-2\" data-kid=\"2-1-1-3-5\" data-name=\"logs navigation link\" href=\"#logs\">\n                    <i aria-hidden=\"true\" class=\"ti ti-scroll-text text-[17px]\" data-kid=\"2-1-1-3-5-1\" data-name=\"logs icon\">\n                    </i>\n                    <span data-kid=\"2-1-1-3-5-2\" data-name=\"logs label text\">\n                        Logs\n                    </span>\n                </a>\n                <a aria-label=\"Settings\" class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-[13px] text-[#a7a4ae] outline-hidden ring-[#aa9bd7]/60 transition-colors hover:bg-[#232429] hover:text-[#e8e5ee] focus-visible:ring-2\" data-kid=\"2-1-1-3-6\" data-name=\"settings navigation link\" href=\"#settings\">\n                    <i aria-hidden=\"true\" class=\"ti ti-settings text-[17px]\" data-kid=\"2-1-1-3-6-1\" data-name=\"settings icon\">\n                    </i>\n                    <span data-kid=\"2-1-1-3-6-2\" data-name=\"settings label text\">\n                        Settings\n                    </span>\n                </a>\n            </nav>\n            <div class=\"mt-auto\" data-kid=\"2-1-1-4\" data-name=\"sidebar bottom area\">\n                <div class=\"border-t border-white/[0.045] pt-3\" data-kid=\"2-1-1-4-1\" data-name=\"sidebar collapse button container\">\n                    <button aria-label=\"Collapse sidebar\" class=\"flex h-10 w-full items-center gap-3 rounded-lg px-3 text-left text-[13px] text-[#918d99] outline-hidden ring-[#aa9bd7]/60 transition-colors hover:bg-[#232429] hover:text-[#c8c5d0] focus-visible:ring-2\" data-kid=\"2-1-1-4-1-1\" data-name=\"collapse sidebar button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-layout-sidebar-left-collapse text-[17px]\" data-kid=\"2-1-1-4-1-1-1\" data-name=\"collapse sidebar icon\">\n                        </i>\n                        <span data-kid=\"2-1-1-4-1-1-2\" data-name=\"collapse sidebar text\">\n                            Collapse sidebar\n                        </span>\n                    </button>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1 bg-[#1a1b1e] px-12 py-10\" data-kid=\"2-1-2\" data-name=\"main content area\" id=\"routing-rules\">\n            <div class=\"mx-auto w-full max-w-[1000px]\" data-kid=\"2-1-2-1\" data-name=\"routing rules content container\">\n                <header class=\"flex items-start justify-between gap-8\" data-kid=\"2-1-2-1-1\" data-name=\"page header section\">\n                    <div data-kid=\"2-1-2-1-1-1\" data-name=\"page header title area\">\n                        <p class=\"mb-2 text-[10px] font-semibold uppercase tracking-[0.17em] text-[#77747f]\" data-kid=\"2-1-2-1-1-1-1\" data-name=\"network label\">\n                            Network\n                        </p>\n                        <h1 class=\"text-[29px] font-semibold leading-9 tracking-[-0.035em] text-[#f2f0f6]\" data-kid=\"2-1-2-1-1-1-2\" data-name=\"page main heading\">\n                            Routing rules\n                        </h1>\n                        <p class=\"mt-2 max-w-[620px] text-[13px] leading-5 text-[#918d99]\" data-kid=\"2-1-2-1-1-1-3\" data-name=\"page description\">\n                            Decide which traffic goes direct, through your proxy, or is blocked.\n                        </p>\n                    </div>\n                    <div class=\"mt-1 flex shrink-0 items-center gap-2 text-[11px] text-[#77747f]\" data-kid=\"2-1-2-1-1-2\" data-name=\"connection status indicator area\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#70b68e]\" data-kid=\"2-1-2-1-1-2-1\" data-name=\"status dot\">\n                        </span>\n                        <span data-kid=\"2-1-2-1-1-2-2\" data-name=\"connection status text\">\n                            Connection active\n                        </span>\n                    </div>\n                </header>\n                <section aria-labelledby=\"presets-heading\" class=\"mt-9\" data-kid=\"2-1-2-1-2\" data-name=\"presets section\">\n                    <div class=\"mb-3 flex items-end justify-between gap-6\" data-kid=\"2-1-2-1-2-1\" data-name=\"presets section header\">\n                        <div data-kid=\"2-1-2-1-2-1-1\" data-name=\"presets title area\">\n                            <p class=\"mb-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-[#77747f]\" data-kid=\"2-1-2-1-2-1-1-1\" data-name=\"presets label\">\n                                Presets\n                            </p>\n                            <h2 class=\"text-[16px] font-semibold tracking-[-0.015em] text-[#e8e5ee]\" data-kid=\"2-1-2-1-2-1-1-2\" data-name=\"presets section title\" id=\"presets-heading\">\n                                Common traffic shortcuts\n                            </h2>\n                        </div>\n                        <p class=\"text-[11px] text-[#77747f]\" data-kid=\"2-1-2-1-2-1-2\" data-name=\"presets description\">\n                            Applied before custom rules\n                        </p>\n                    </div>\n                    <div class=\"overflow-hidden rounded-[10px] bg-[#222329] ring-1 ring-inset ring-white/[0.055]\" data-kid=\"2-1-2-1-2-2\" data-name=\"presets list container\">\n                        <div class=\"flex min-h-[62px] items-center justify-between gap-8 border-b border-white/[0.055] px-5 py-3\" data-kid=\"2-1-2-1-2-2-1\" data-name=\"bypass lan setting row\">\n                            <div class=\"min-w-0\" data-kid=\"2-1-2-1-2-2-1-1\" data-name=\"bypass lan title description\">\n                                <p class=\"text-[13px] font-medium text-[#e3e0e9]\" data-kid=\"2-1-2-1-2-2-1-1-1\" data-name=\"bypass lan title\">\n                                    Bypass LAN\n                                </p>\n                                <p class=\"mt-1 text-[11px] leading-4 text-[#77747f]\" data-kid=\"2-1-2-1-2-2-1-1-2\" data-name=\"bypass lan description\">\n                                    Send local network traffic directly.\n                                </p>\n                            </div>\n                            <div class=\"flex shrink-0 items-center gap-3\" data-kid=\"2-1-2-1-2-2-1-2\" data-name=\"bypass lan toggle container\">\n                                <span class=\"toggle-status is-on text-[11px] font-medium text-[#c3b7e6]\" data-dynamic=\"true\" data-kid=\"2-1-2-1-2-2-1-2-1\" data-name=\"bypass lan status text\" data-reason=\"text toggled between On/Off by click event\" data-toggle-status=\"\">\n                                    On\n                                </span>\n                                <button aria-checked=\"true\" aria-label=\"Toggle Bypass LAN\" class=\"group flex h-8 w-12 cursor-pointer items-center justify-center rounded-lg outline-hidden ring-[#aa9bd7]/70 focus-visible:ring-2\" data-kid=\"2-1-2-1-2-2-1-2-2\" data-name=\"bypass lan toggle switch\" data-toggle=\"\" role=\"switch\" type=\"button\">\n                                    <span class=\"toggle-track is-on relative block h-5 w-9 rounded-full\" data-kid=\"2-1-2-1-2-2-1-2-2-1\" data-name=\"bypass lan toggle track\" data-toggle-track=\"\">\n                                        <span class=\"toggle-thumb is-on absolute left-0.5 top-0.5 block h-4 w-4 rounded-full shadow-sm\" data-kid=\"2-1-2-1-2-2-1-2-2-1-1\" data-name=\"bypass lan toggle thumb\" data-toggle-thumb=\"\">\n                                        </span>\n                                    </span>\n                                </button>\n                            </div>\n                        </div>\n                        <div class=\"flex min-h-[62px] items-center justify-between gap-8 px-5 py-3\" data-kid=\"2-1-2-1-2-2-2\" data-name=\"block ads setting row\">\n                            <div class=\"min-w-0\" data-kid=\"2-1-2-1-2-2-2-1\" data-name=\"block ads title description\">\n                                <p class=\"text-[13px] font-medium text-[#e3e0e9]\" data-kid=\"2-1-2-1-2-2-2-1-1\" data-name=\"block ads title\">\n                                    Block ads\n                                </p>\n                                <p class=\"mt-1 text-[11px] leading-4 text-[#77747f]\" data-kid=\"2-1-2-1-2-2-2-1-2\" data-name=\"block ads description\">\n                                    Block known advertising domains.\n                                </p>\n                            </div>\n                            <div class=\"flex shrink-0 items-center gap-3\" data-kid=\"2-1-2-1-2-2-2-2\" data-name=\"block ads toggle container\">\n                                <span class=\"toggle-status is-on text-[11px] font-medium text-[#c3b7e6]\" data-dynamic=\"true\" data-kid=\"2-1-2-1-2-2-2-2-1\" data-name=\"block ads status text\" data-reason=\"text toggled between On/Off by click event\" data-toggle-status=\"\">\n                                    On\n                                </span>\n                                <button aria-checked=\"true\" aria-label=\"Toggle Block ads\" class=\"group flex h-8 w-12 cursor-pointer items-center justify-center rounded-lg outline-hidden ring-[#aa9bd7]/70 focus-visible:ring-2\" data-kid=\"2-1-2-1-2-2-2-2-2\" data-name=\"block ads toggle switch\" data-toggle=\"\" role=\"switch\" type=\"button\">\n                                    <span class=\"toggle-track is-on relative block h-5 w-9 rounded-full\" data-kid=\"2-1-2-1-2-2-2-2-2-1\" data-name=\"block ads toggle track\" data-toggle-track=\"\">\n                                        <span class=\"toggle-thumb is-on absolute left-0.5 top-0.5 block h-4 w-4 rounded-full shadow-sm\" data-kid=\"2-1-2-1-2-2-2-2-2-1-1\" data-name=\"block ads toggle thumb\" data-toggle-thumb=\"\">\n                                        </span>\n                                    </span>\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n                <section aria-labelledby=\"rules-heading\" class=\"mt-10\" data-kid=\"2-1-2-1-3\" data-name=\"custom rules section\">\n                    <div class=\"mb-3 flex items-end justify-between gap-6\" data-kid=\"2-1-2-1-3-1\" data-name=\"custom rules header area\">\n                        <div data-kid=\"2-1-2-1-3-1-1\" data-name=\"custom rules title area\">\n                            <p class=\"mb-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-[#77747f]\" data-kid=\"2-1-2-1-3-1-1-1\" data-name=\"custom rules label\">\n                                Custom rules\n                            </p>\n                            <h2 class=\"text-[16px] font-semibold tracking-[-0.015em] text-[#e8e5ee]\" data-kid=\"2-1-2-1-3-1-1-2\" data-name=\"custom rules title\" id=\"rules-heading\">\n                                Traffic matches\n                            </h2>\n                        </div>\n                        <p class=\"text-[11px] text-[#77747f]\" data-kid=\"2-1-2-1-3-1-2\" data-name=\"custom rules count and description\">\n                            First match wins\n                            <span class=\"px-1 text-[#5e5b64]\" data-kid=\"2-1-2-1-3-1-2-1\" data-name=\"separator dot\">\n                                ·\n                            </span>\n                            4 rules\n                        </p>\n                    </div>\n                    <div aria-label=\"Routing rules table\" class=\"overflow-hidden rounded-[10px] bg-[#222329] ring-1 ring-inset ring-white/[0.055]\" data-kid=\"2-1-2-1-3-2\" data-name=\"rules table container\" role=\"table\">\n                        <div class=\"grid h-10 grid-cols-[minmax(0,1fr)_72px_minmax(0,1fr)_28px] items-center gap-5 border-b border-white/[0.055] px-5 text-[10px] font-semibold uppercase tracking-[0.15em] text-[#918d99]\" data-kid=\"2-1-2-1-3-2-1\" data-name=\"table header row\" role=\"row\">\n                            <span data-kid=\"2-1-2-1-3-2-1-1\" data-name=\"table match header\" role=\"columnheader\">\n                                Match\n                            </span>\n                            <span aria-hidden=\"true\" data-kid=\"2-1-2-1-3-2-1-2\" data-name=\"spacer 1\">\n                            </span>\n                            <span data-kid=\"2-1-2-1-3-2-1-3\" data-name=\"table outbound header\" role=\"columnheader\">\n                                Outbound\n                            </span>\n                            <span aria-hidden=\"true\" data-kid=\"2-1-2-1-3-2-1-4\" data-name=\"spacer 2\">\n                            </span>\n                        </div>\n                        <div aria-selected=\"false\" class=\"routing-row grid h-[46px] cursor-pointer grid-cols-[minmax(0,1fr)_72px_minmax(0,1fr)_28px] items-center gap-5 px-5 text-[13px] text-[#c8c5d0] outline-hidden ring-inset ring-[#aa9bd7]/70 focus-visible:ring-2\" data-kid=\"2-1-2-1-3-2-2\" data-name=\"rule row 1\" role=\"row\" tabindex=\"0\">\n                            <span class=\"truncate\" data-kid=\"2-1-2-1-3-2-2-1\" data-name=\"match value 1\" role=\"cell\">\n                                192.168.0.0/16\n                            </span>\n                            <span class=\"flex justify-center text-[14px] text-[#77747f]\" data-kid=\"2-1-2-1-3-2-2-2\" data-name=\"rule icon container 1\" role=\"cell\">\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"2-1-2-1-3-2-2-2-1\" data-name=\"rule icon 1\">\n                                </i>\n                            </span>\n                            <span class=\"text-[#d9d5e1]\" data-kid=\"2-1-2-1-3-2-2-3\" data-name=\"outbound value 1\" role=\"cell\">\n                                Direct\n                            </span>\n                            <span class=\"routing-edit flex justify-end text-[15px] text-[#c3b7e6]\" data-kid=\"2-1-2-1-3-2-2-4\" data-name=\"rule edit container 1\">\n                                <button aria-label=\"Edit 192.168.0.0/16\" class=\"flex h-7 w-7 items-center justify-center rounded-lg outline-hidden ring-[#aa9bd7]/70 hover:bg-white/[0.06] focus-visible:ring-2\" data-kid=\"2-1-2-1-3-2-2-4-1\" data-name=\"edit button 1\" type=\"button\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-pencil\" data-kid=\"2-1-2-1-3-2-2-4-1-1\" data-name=\"edit icon 1\">\n                                    </i>\n                                </button>\n                            </span>\n                        </div>\n                        <div aria-selected=\"true\" class=\"routing-row is-selected grid h-[46px] cursor-pointer grid-cols-[minmax(0,1fr)_72px_minmax(0,1fr)_28px] items-center gap-5 px-5 text-[13px] text-[#f2f0f6] outline-hidden ring-inset ring-[#aa9bd7]/70 focus-visible:ring-2\" data-kid=\"2-1-2-1-3-2-3\" data-name=\"rule row 2\" role=\"row\" tabindex=\"0\">\n                            <span class=\"truncate font-medium\" data-kid=\"2-1-2-1-3-2-3-1\" data-name=\"match value 2\" role=\"cell\">\n                                localhost\n                            </span>\n                            <span class=\"flex justify-center text-[14px] text-[#c3b7e6]\" data-kid=\"2-1-2-1-3-2-3-2\" data-name=\"rule icon container 2\" role=\"cell\">\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"2-1-2-1-3-2-3-2-1\" data-name=\"rule icon 2\">\n                                </i>\n                            </span>\n                            <span class=\"text-[#f2f0f6]\" data-kid=\"2-1-2-1-3-2-3-3\" data-name=\"outbound value 2\" role=\"cell\">\n                                Direct\n                            </span>\n                            <span class=\"routing-edit flex justify-end text-[15px] text-[#c3b7e6]\" data-kid=\"2-1-2-1-3-2-3-4\" data-name=\"rule edit container 2\">\n                                <button aria-label=\"Edit localhost\" class=\"flex h-7 w-7 items-center justify-center rounded-lg outline-hidden ring-[#aa9bd7]/70 hover:bg-white/[0.06] focus-visible:ring-2\" data-kid=\"2-1-2-1-3-2-3-4-1\" data-name=\"edit button 2\" type=\"button\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-pencil\" data-kid=\"2-1-2-1-3-2-3-4-1-1\" data-name=\"edit icon 2\">\n                                    </i>\n                                </button>\n                            </span>\n                        </div>\n                        <div aria-selected=\"false\" class=\"routing-row grid h-[46px] cursor-pointer grid-cols-[minmax(0,1fr)_72px_minmax(0,1fr)_28px] items-center gap-5 px-5 text-[13px] text-[#c8c5d0] outline-hidden ring-inset ring-[#aa9bd7]/70 focus-visible:ring-2\" data-kid=\"2-1-2-1-3-2-4\" data-name=\"rule row 3\" role=\"row\" tabindex=\"0\">\n                            <span class=\"truncate\" data-kid=\"2-1-2-1-3-2-4-1\" data-name=\"match value 3\" role=\"cell\">\n                                example.com\n                            </span>\n                            <span class=\"flex justify-center text-[14px] text-[#77747f]\" data-kid=\"2-1-2-1-3-2-4-2\" data-name=\"rule icon container 3\" role=\"cell\">\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"2-1-2-1-3-2-4-2-1\" data-name=\"rule icon 3\">\n                                </i>\n                            </span>\n                            <span class=\"text-[#d9d5e1]\" data-kid=\"2-1-2-1-3-2-4-3\" data-name=\"outbound value 3\" role=\"cell\">\n                                Proxy\n                            </span>\n                            <span class=\"routing-edit flex justify-end text-[15px] text-[#c3b7e6]\" data-kid=\"2-1-2-1-3-2-4-4\" data-name=\"rule edit container 3\">\n                                <button aria-label=\"Edit example.com\" class=\"flex h-7 w-7 items-center justify-center rounded-lg outline-hidden ring-[#aa9bd7]/70 hover:bg-white/[0.06] focus-visible:ring-2\" data-kid=\"2-1-2-1-3-2-4-4-1\" data-name=\"edit button 3\" type=\"button\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-pencil\" data-kid=\"2-1-2-1-3-2-4-4-1-1\" data-name=\"edit icon 3\">\n                                    </i>\n                                </button>\n                            </span>\n                        </div>\n                        <div aria-selected=\"false\" class=\"routing-row grid h-[46px] cursor-pointer grid-cols-[minmax(0,1fr)_72px_minmax(0,1fr)_28px] items-center gap-5 px-5 text-[13px] text-[#c8c5d0] outline-hidden ring-inset ring-[#aa9bd7]/70 focus-visible:ring-2\" data-kid=\"2-1-2-1-3-2-5\" data-name=\"rule row 4\" role=\"row\" tabindex=\"0\">\n                            <span class=\"truncate\" data-kid=\"2-1-2-1-3-2-5-1\" data-name=\"match value 4\" role=\"cell\">\n                                ads.example.net\n                            </span>\n                            <span class=\"flex justify-center text-[14px] text-[#77747f]\" data-kid=\"2-1-2-1-3-2-5-2\" data-name=\"rule icon container 4\" role=\"cell\">\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"2-1-2-1-3-2-5-2-1\" data-name=\"rule icon 4\">\n                                </i>\n                            </span>\n                            <span class=\"text-[#d9d5e1]\" data-kid=\"2-1-2-1-3-2-5-3\" data-name=\"outbound value 4\" role=\"cell\">\n                                Block\n                            </span>\n                            <span class=\"routing-edit flex justify-end text-[15px] text-[#c3b7e6]\" data-kid=\"2-1-2-1-3-2-5-4\" data-name=\"rule edit container 4\">\n                                <button aria-label=\"Edit ads.example.net\" class=\"flex h-7 w-7 items-center justify-center rounded-lg outline-hidden ring-[#aa9bd7]/70 hover:bg-white/[0.06] focus-visible:ring-2\" data-kid=\"2-1-2-1-3-2-5-4-1\" data-name=\"edit button 4\" type=\"button\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-pencil\" data-kid=\"2-1-2-1-3-2-5-4-1-1\" data-name=\"edit icon 4\">\n                                    </i>\n                                </button>\n                            </span>\n                        </div>\n                    </div>\n                    <p class=\"mt-3 text-[11px] text-[#6f6c75]\" data-kid=\"2-1-2-1-3-3\" data-name=\"rules explanation\">\n                        Rules are evaluated from top to bottom.\n                    </p>\n                </section>\n            </div>\n        </main>\n    </div>\n</div>\n<script>\n    document.querySelectorAll('[data-toggle]').forEach(function (toggle) {\n    toggle.addEventListener('click', function () {\n      var isOn = toggle.getAttribute('aria-checked') === 'true';\n      var nextState = !isOn;\n      toggle.setAttribute('aria-checked', String(nextState));\n      var track = toggle.querySelector('[data-toggle-track]');\n      var thumb = toggle.querySelector('[data-toggle-thumb]');\n      var status = toggle.parentElement.querySelector('[data-toggle-status]');\n      track.classList.toggle('is-on', nextState);\n      thumb.classList.toggle('is-on', nextState);\n      status.classList.toggle('is-on', nextState);\n      status.textContent = nextState ? 'On' : 'Off';\n    });\n  });\n\n  document.querySelectorAll('.routing-row').forEach(function (row) {\n    function selectRow() {\n      document.querySelectorAll('.routing-row').forEach(function (candidate) {\n        candidate.classList.remove('is-selected');\n        candidate.setAttribute('aria-selected', 'false');\n      });\n      row.classList.add('is-selected');\n      row.setAttribute('aria-selected', 'true');\n    }\n    row.addEventListener('click', function (event) {\n      if (!event.target.closest('button')) selectRow();\n    });\n    row.addEventListener('keydown', function (event) {\n      if (event.key === 'Enter' || event.key === ' ') {\n        event.preventDefault();\n        selectRow();\n      }\n    });\n  });\n</script>\n",
