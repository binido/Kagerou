\" data-kid=\"1-2-1-2-2-2-3-7-2-7-2-2-1\">\n                                                </i>\n                                                <span data-kid=\"1-2-1-2-2-2-3-7-2-7-2-2-2\">\n                                                    TCP connection\n                                                </span>\n                                            </button>\n                                            <button class=\"menu-item\" data-kid=\"1-2-1-2-2-2-3-7-2-7-2-3\" data-test-method=\"url\" role=\"menuitem\" type=\"button\">\n                                                <i aria-hidden=\"true\" class=\"icon ti ti-world-check\" data-kid=\"1-2-1-2-2-2-3-7-2-7-2-3-1\">\n                                                </i>\n                                                <span data-kid=\"1-2-1-2-2-2-3-7-2-7-2-3-2\">\n                                                    URL check\n                                                </span>\n                                            </button>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <section aria-labelledby=\"imported-heading\" class=\"group-card mt-4\" data-disclosure=\"imported\" data-kid=\"1-2-1-3\" data-open=\"false\">\n                <div class=\"group-header flex items-center justify-between gap-5 px-5\" data-kid=\"1-2-1-3-1\">\n                    <button aria-controls=\"imported-summary\" aria-expanded=\"false\" class=\"disclosure-trigger flex min-w-0 flex-1 items-center gap-3 rounded-[8px] py-2 text-left\" data-disclosure-trigger=\"\" data-kid=\"1-2-1-3-1-1\" type=\"button\">\n                        <span class=\"flex h-6 w-6 shrink-0 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-2-1-3-1-1-1\">\n                            <i aria-hidden=\"true\" class=\"icon disclosure-chevron ti ti-chevron-down\" data-kid=\"1-2-1-3-1-1-1-1\">\n                            </i>\n                        </span>\n                        <span class=\"min-w-0\" data-kid=\"1-2-1-3-1-1-2\">\n                            <span class=\"block truncate font-['Inter Tight'] text-[17px] font-semibold tracking-[-0.015em] text-[var(--primary)]\" data-kid=\"1-2-1-3-1-1-2-1\" id=\"imported-heading\">\n                                Imported from Sources\n                            </span>\n                            <span class=\"mt-1 block text-[12px] text-[var(--muted)]\" data-kid=\"1-2-1-3-1-1-2-2\">\n                                5 profiles\n                            </span>\n                        </span>\n                    </button>\n                    <span class=\"managed-badge\" data-kid=\"1-2-1-3-1-2\">\n                        <i aria-hidden=\"true\" class=\"icon ti ti-lock\" data-kid=\"1-2-1-3-1-2-1\">\n                        </i>\n                        Managed on Sources\n                    </span>\n                </div>\n                <div aria-hidden=\"true\" class=\"source-summary\" data-kid=\"1-2-1-3-2\" hidden=\"\" id=\"imported-summary\" role=\"region\">\n                    <span data-kid=\"1-2-1-3-2-1\">\n                        <strong data-kid=\"1-2-1-3-2-1-1\">\n                            Source-managed profiles stay grouped here.\n                        </strong>\n                        Edit the source to refresh or remove them.\n                    </span>\n                    <span class=\"font-['IBM Plex Mono'] text-[10px] text-[var(--muted)]\" data-kid=\"1-2-1-3-2-2\">\n                        2 source groups\n                    </span>\n                </div>\n            </section>\n            <p aria-live=\"polite\" class=\"mt-4 min-h-[17px] text-[11px] text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"1-2-1-4\" data-name=\"feedback messages container\" data-reason=\"text content updated by script on user actions\" id=\"profiles-feedback\">\n            </p>\n        </div>\n    </main>\n    <div aria-hidden=\"true\" aria-labelledby=\"add-profile-title\" aria-modal=\"true\" class=\"dialog-backdrop\" data-dialog=\"add\" data-kid=\"1-3\" hidden=\"\" id=\"add-profile-dialog\" role=\"dialog\">\n        <div class=\"dialog\" data-kid=\"1-3-1\">\n            <div class=\"flex items-start justify-between gap-5\" data-kid=\"1-3-1-1\">\n                <div data-kid=\"1-3-1-1-1\">\n                    <h2 data-kid=\"1-3-1-1-1-1\" id=\"add-profile-title\">\n                        Add profile\n                    </h2>\n                    <p class=\"mt-2 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-3-1-1-1-2\">\n                        Create a local connection profile that you can order and select from Profiles.\n                    </p>\n                </div>\n                <button aria-label=\"Close Add profile dialog\" class=\"dialog-close\" data-close-dialog=\"\" data-kid=\"1-3-1-1-2\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"icon ti ti-x\" data-kid=\"1-3-1-1-2-1\">\n                    </i>\n                </button>\n            </div>\n            <form class=\"mt-6\" data-add-form=\"\" data-kid=\"1-3-1-2\">\n                <label class=\"dialog-label\" data-kid=\"1-3-1-2-1\" for=\"new-profile-name\">\n                    Profile name\n                </label>\n                <input autocomplete=\"off\" class=\"dialog-input\" data-kid=\"1-3-1-2-2\" id=\"new-profile-name\" name=\"profile-name\" placeholder=\"e.g. Home · Seattle\" type=\"text\"/>\n                <label class=\"dialog-label mt-5\" data-kid=\"1-3-1-2-3\" for=\"new-profile-key\">\n                    Profile key or config\n                </label>\n                <textarea class=\"dialog-textarea\" data-kid=\"1-3-1-2-4\" id=\"new-profile-key\" name=\"profile-key\" placeholder=\"vless://… or sing-box JSON\"></textarea>\n                <p class=\"dialog-helper\" data-kid=\"1-3-1-2-5\">\n                    Paste a single key or a complete config. It stays local until you choose to add it to a source.\n                </p>\n                <p aria-live=\"polite\" class=\"dialog-error\" data-add-error=\"\" data-dynamic=\"true\" data-kid=\"1-3-1-2-6\" data-name=\"add profile error message\" data-reason=\"text content dynamically set by script on validation failure\">\n                </p>\n                <div class=\"mt-5 flex items-center justify-end gap-2\" data-kid=\"1-3-1-2-7\">\n                    <button class=\"action-button secondary\" data-close-dialog=\"\" data-kid=\"1-3-1-2-7-1\" type=\"button\">\n                        Cancel\n                    </button>\n                    <button class=\"action-button primary\" data-kid=\"1-3-1-2-7-2\" type=\"submit\">\n                        Add profile\n                    </button>\n                </div>\n            </form>\n        </div>\n    </div>\n    <div aria-hidden=\"true\" aria-labelledby=\"delete-profile-title\" aria-modal=\"true\" class=\"dialog-backdrop\" data-dialog=\"delete\" data-kid=\"1-4\" hidden=\"\" id=\"delete-profile-dialog\" role=\"dialog\">\n        <div class=\"dialog max-w-[440px]\" data-kid=\"1-4-1\">\n            <div class=\"flex items-start justify-between gap-5\" data-kid=\"1-4-1-1\">\n                <div data-kid=\"1-4-1-1-1\">\n                    <h2 data-kid=\"1-4-1-1-1-1\" id=\"delete-profile-title\">\n                        Delete profile?\n                    </h2>\n                    <p class=\"mt-2 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-4-1-1-1-2\">\n                        This removes the local profile from your connection list.\n                    </p>\n                </div>\n                <button aria-label=\"Close delete profile dialog\" class=\"dialog-close\" data-close-dialog=\"\" data-kid=\"1-4-1-1-2\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"icon ti ti-x\" data-kid=\"1-4-1-1-2-1\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"danger-copy\" data-kid=\"1-4-1-2\">\n                You are about to delete\n                <strong class=\"text-[var(--primary)]\" data-delete-name=\"\" data-dynamic=\"true\" data-kid=\"1-4-1-2-1\" data-name=\"delete profile confirmation name\" data-reason=\"text content dynamically set by script to show target profile name\">\n                    Seattle 03\n                </strong>\n                . Imported profiles remain managed by their source.\n            </div>\n            <div class=\"mt-6 flex items-center justify-end gap-2\" data-kid=\"1-4-1-3\">\n                <button class=\"action-button secondary\" data-close-dialog=\"\" data-kid=\"1-4-1-3-1\" type=\"button\">\n                    Cancel\n                </button>\n                <button class=\"action-button primary !bg-[var(--bad)] !text-[var(--primary)] hover:!bg-[#DF858B]\" data-confirm-delete=\"\" data-kid=\"1-4-1-3-2\" type=\"button\">\n                    Delete profile\n                </button>\n            </div>\n        </div>\n    </div>\n</div>\n<script>\n    (() => {\n    const root = document.getElementById('managed-profiles');\n    const rowsContainer = document.getElementById('my-profile-rows');\n    const addDialog = document.getElementById('add-profile-dialog');\n    const deleteDialog = document.getElementById('delete-profile-dialog');\n    const addButton = root.querySelector('[data-open-add]');\n    const runMenu = root.querySelector('[data-run-menu]');\n    const feedback = document.getElementById('profiles-feedback');\n    let lastDialogTrigger = null;\n    let pendingDelete = null;\n    let draggedRow = null;\n\n    const getRows = () => Array.from(rowsContainer.querySelectorAll('[data-profile-row]'));\n\n    const setFeedback = (message, tone = 'muted') => {\n      feedback.textContent = message;\n      feedback.style.color = tone === 'good' ? 'var(--good)' : tone === 'bad' ? 'var(--bad)' : 'var(--muted)';\n    };\n\n    const updateOrder = () => {\n      const rows = getRows();\n      rows.forEach((row, index) => {\n        const order = row.querySelector('[data-order]');\n        const handle = row.querySelector('[data-drag-handle]');\n        if (order) order.textContent = String(index + 1);\n        if (handle) handle.setAttribute('aria-label', `Drag ${row.dataset.name} to reorder`);\n      });\n      const count = rows.length;\n      root.querySelectorAll('[data-profile-count]').forEach((node) => {\n        node.textContent = `${count} ${count === 1 ? 'profile' : 'profiles'}`;\n      });\n    };\n\n    const updateSelection = (selectedRow) => {\n      getRows().forEach((row) => {\n        const selected = row === selectedRow;\n        row.dataset.selected = String(selected);\n        const button = row.querySelector('[data-select-profile]');\n        button.setAttribute('aria-pressed', String(selected));\n        button.innerHTML = selected\n          ? '<i aria-hidden=\"true\" class=\"icon ti ti-check !h-3 !w-3 !basis-3\"></i><span>Selected</span>'\n          : '<span>Use</span>';\n      });\n      setFeedback(`${selectedRow.dataset.name} is ready for the next connection.`, 'good');\n    };\n\n    const setResult = (row, method, value, tone) => {\n      const result = row.querySelector(`[data-test-result=\"${method}\"]`);\n      if (!result) return;\n      result.textContent = value;\n      result.classList.remove('good', 'warn', 'bad', 'muted');\n      result.classList.add(tone);\n    };\n\n    const finalTone = (value) => {\n      const text = String(value).toLowerCase();\n      if (text.includes('timeout') || text.includes('failed') || text.includes('error') || text.includes('not reachable')) return 'bad';\n      if (text.includes('testing') || text.includes('running')) return 'warn';\n      if (text.includes('not tested')) return 'muted';\n      return 'good';\n    };\n\n    const runRowTest = (row, method) => {\n      const label = method === 'tcp' ? 'TCP' : 'URL';\n      setResult(row, method, 'Running…', 'warn');\n      setFeedback(`${label} test running for ${row.dataset.name}…`);\n      window.setTimeout(() => {\n        const value = row.dataset[method === 'tcp' ? 'tcpFinal' : 'urlFinal'] || 'Not tested';\n        setResult(row, method, value, finalTone(value));\n        setFeedback(`${label} test finished for ${row.dataset.name}: ${value}.`, finalTone(value) === 'bad' ? 'bad' : 'good');\n      }, 720);\n    };\n\n    const runAllTests = (method) => {\n      const label = method === 'tcp' ? 'TCP' : 'URL';\n      getRows().forEach((row) => setResult(row, method, 'Running…', 'warn'));\n      setFeedback(`${label} test running for all visible profiles…`);\n      window.setTimeout(() => {\n        getRows().forEach((row) => {\n          const value = row.dataset[method === 'tcp' ? 'tcpFinal' : 'urlFinal'] || 'Not tested';\n          setResult(row, method, value, finalTone(value));\n        });\n        setFeedback(`${label} test finished for ${getRows().length} visible profiles.`, 'good');\n      }, 820);\n    };\n\n    const closeMenus = () => {\n      root.querySelectorAll('[data-row-menu], [data-test-submenu]').forEach((menu) => menu.dataset.open = 'false');\n      root.querySelectorAll('[data-row-menu-toggle], [data-test-menu-toggle]').forEach((button) => button.setAttribute('aria-expanded', 'false'));\n      runMenu.dataset.open = 'false';\n      const runToggle = root.querySelector('[data-run-menu-toggle]');\n      if (runToggle) runToggle.setAttribute('aria-expanded', 'false');\n    };\n\n    const closeDialog = (dialog) => {\n      dialog.hidden = true;\n      dialog.setAttribute('aria-hidden', 'true');\n      const trigger = lastDialogTrigger;\n      lastDialogTrigger = null;\n      if (trigger && typeof trigger.focus === 'function') trigger.focus();\n    };\n\n    const openDialog = (dialog, trigger) => {\n      closeMenus();\n      lastDialogTrigger = trigger;\n      dialog.hidden = false;\n      dialog.setAttribute('aria-hidden', 'false');\n      const focusTarget = dialog.querySelector('input, textarea, button');\n      if (focusTarget) window.requestAnimationFrame(() => focusTarget.focus());\n    };\n\n    const setEditing = (row, editing) => {\n      row.dataset.editing = String(editing);\n      if (editing) {\n        const input = row.querySelector('[data-rename-input]');\n        input.value = row.dataset.name;\n        window.requestAnimationFrame(() => input.focus());\n      }\n    };\n\n    const saveRename = (row) => {\n      const input = row.querySelector('[data-rename-input]');\n      const value = input.value.trim();\n      if (!value) {\n        input.setAttribute('aria-invalid', 'true');\n        input.focus();\n        setFeedback('Profile name cannot be empty.', 'bad');\n        return;\n      }\n      row.dataset.name = value;\n      row.querySelector('[data-profile-name]').textContent = value;\n      row.querySelector('[data-rename-input]').setAttribute('aria-label', `Rename ${value}`);\n      setEditing(row, false);\n      setFeedback(`Profile renamed to ${value}.`, 'good');\n    };\n\n    const moveRow = (row, direction) => {\n      const rows = getRows();\n      const index = rows.indexOf(row);\n      const target = direction === 'up' ? rows[index - 1] : rows[index + 1];\n      if (!target) {\n        setFeedback(direction === 'up' ? 'This profile is already first.' : 'This profile is already last.');\n        return;\n      }\n      if (direction === 'up') rowsContainer.insertBefore(row, target);\n      else rowsContainer.insertBefore(target, row);\n      updateOrder();\n      setFeedback(`${row.dataset.name} moved ${direction}.`, 'good');\n    };\n\n    const openDelete = (row, trigger) => {\n      pendingDelete = row;\n      deleteDialog.querySelector('[data-delete-name]').textContent = row.dataset.name;\n      openDialog(deleteDialog, trigger);\n    };\n\n    const createRow = (name, key) => {\n      const row = document.createElement('div');\n      row.className = 'profile-row profile-grid relative grid items-center gap-3';\n      row.dataset.editing = 'false';\n      row.dataset.name = name;\n      row.dataset.profileRow = '';\n      row.dataset.selected = 'false';\n      row.dataset.tcpFinal = key.toLowerCase().includes('trojan') ? '74 ms' : 'Not tested';\n      row.dataset.urlFinal = 'Not tested';\n      row.setAttribute('role', 'row');\n      row.innerHTML = `\n        <div class=\"order-cell\" role=\"cell\"><span data-order></span><button aria-label=\"Drag ${name} to reorder\" class=\"drag-handle\" data-drag-handle draggable=\"true\" type=\"button\"><i aria-hidden=\"true\" class=\"icon ti ti-grip-vertical\"></i></button></div>\n        <div class=\"identity-cell\" role=\"cell\"><div class=\"identity-line\"><span class=\"profile-name-display\" data-profile-name>${name}</span><span class=\"origin-badge local\">Local</span><span class=\"inline-editor\"><input aria-label=\"Rename ${name}\" data-rename-input type=\"text\" value=\"${name.replace(/\"/g, '&quot;')}\" /><button aria-label=\"Save profile name\" class=\"inline-action\" data-rename-save type=\"button\"><i aria-hidden=\"true\" class=\"icon ti ti-check\"></i></button><button aria-label=\"Cancel rename\" class=\"inline-action\" data-rename-cancel type=\"button\"><i aria-hidden=\"true\" class=\"icon ti ti-x\"></i></button></span></div><span class=\"origin-meta\">Local profile</span></div>\n        <div role=\"cell\"><span class=\"protocol-badge\">VLESS</span></div>\n        <div role=\"cell\"><span class=\"result muted\" data-test-result=\"tcp\">Not tested</span></div>\n        <div role=\"cell\"><span class=\"result muted\" data-test-result=\"url\">Not tested</span></div>\n        <div class=\"flex justify-start\" role=\"cell\"><button aria-pressed=\"false\" class=\"selection-control\" data-select-profile type=\"button\"><span>Use</span></button></div>\n        <div class=\"more-cell\" role=\"cell\"><button aria-expanded=\"false\" aria-haspopup=\"menu\" aria-label=\"More actions for ${name}\" class=\"row-more\" data-row-menu-toggle type=\"button\"><i aria-hidden=\"true\" class=\"icon ti ti-dots\"></i></button><div aria-label=\"Actions for ${name}\" class=\"context-menu row-menu\" data-open=\"false\" data-row-menu role=\"menu\"><button class=\"menu-item\" data-menu-action=\"rename\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"icon ti ti-pencil\"></i><span>Rename profile</span></button><button class=\"menu-item\" data-menu-action=\"move-up\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"icon ti ti-arrow-up\"></i><span>Move up</span></button><button class=\"menu-item\" data-menu-action=\"move-down\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"icon ti ti-arrow-down\"></i><span>Move down</span></button><div class=\"menu-divider\"></div><button class=\"menu-item danger\" data-menu-action=\"delete\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"icon ti ti-trash\"></i><span>Delete profile</span></button><div class=\"menu-divider\"></div><div class=\"submenu-anchor\"><button aria-expanded=\"false\" class=\"menu-item\" data-test-menu-toggle role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"icon ti ti-activity\"></i><span>Test</span><i aria-hidden=\"true\" class=\"icon ti ti-chevron-right ml-auto !h-3 !w-3 !basis-3 text-[var(--muted)]\"></i></button><div aria-label=\"Test ${name}\" class=\"context-menu test-submenu\" data-open=\"false\" data-test-submenu role=\"menu\"><div class=\"menu-kicker\">${name}</div><button class=\"menu-item\" data-test-method=\"tcp\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"icon ti ti-plug\"></i><span>TCP connection</span></button><button class=\"menu-item\" data-test-method=\"url\" role=\"menuitem\" type=\"button\"><i aria-hidden=\"true\" class=\"icon ti ti-world-check\"></i><span>URL check</span></button></div></div></div></div>`;\n      return row;\n    };\n\n    root.addEventListener('click', (event) => {\n      const button = event.target.closest('button');\n      if (!button || !root.contains(button)) return;\n      const row = button.closest('[data-profile-row]');\n\n      if (button.matches('[data-collapse-sidebar]')) {\n        const collapsed = root.classList.toggle('is-collapsed');\n        button.setAttribute('aria-expanded', String(!collapsed));\n        button.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');\n        return;\n      }\n\n      if (button.matches('[data-open-add]')) {\n        openDialog(addDialog, button);\n        return;\n      }\n\n      if (button.matches('[data-close-dialog]')) {\n        const dialog = button.closest('[data-dialog]');\n        if (dialog) closeDialog(dialog);\n        return;\n      }\n\n      if (button.matches('[data-run-menu-toggle]')) {\n        const open = runMenu.dataset.open !== 'true';\n        closeMenus();\n        runMenu.dataset.open = String(open);\n        button.setAttribute('aria-expanded', String(open));\n        return;\n      }\n\n      if (button.matches('[data-run-method]')) {\n        runAllTests(button.dataset.runMethod);\n        closeMenus();\n        return;\n      }\n\n      if (button.matches('[data-row-menu-toggle]')) {\n        const menu = row.querySelector('[data-row-menu]');\n        const open = menu.dataset.open !== 'true';\n        closeMenus();\n        menu.dataset.open = String(open);\n        button.setAttribute('aria-expanded', String(open));\n        if (open && row === getRows()[0]) {\n          const submenu = menu.querySelector('[data-test-submenu]');\n          const testToggle = menu.querySelector('[data-test-menu-toggle]');\n          submenu.dataset.open = 'true';\n          testToggle.setAttribute('aria-expanded', 'true');\n        }\n        return;\n      }\n\n      if (button.matches('[data-test-menu-toggle]')) {\n        const submenu = button.parentElement.querySelector('[data-test-submenu]');\n        const open = submenu.dataset.open !== 'true';\n        submenu.dataset.open = String(open);\n        button.setAttribute('aria-expanded', String(open));\n        return;\n      }\n\n      if (button.matches('[data-test-method]') && row) {\n        runRowTest(row, button.dataset.testMethod);\n        closeMenus();\n        return;\n      }\n\n      if (button.matches('[data-select-profile]') && row) {\n        updateSelection(row);\n        return;\n      }\n\n      if (button.matches('[data-menu-action]') && row) {\n        const action = button.dataset.menuAction;\n        if (action === 'rename') {\n          closeMenus();\n          setEditing(row, true);\n        }\n        if (action === 'move-up' || action === 'move-down') {\n          moveRow(row, action === 'move-up' ? 'up' : 'down');\n          closeMenus();\n        }\n        if (action === 'delete') openDelete(row, button);\n        return;\n      }\n\n      if (button.matches('[data-rename-save]') && row) {\n        saveRename(row);\n        return;\n      }\n\n      if (button.matches('[data-rename-cancel]') && row) {\n        setEditing(row, false);\n        setFeedback('Rename cancelled.');\n        return;\n      }\n\n      if (button.matches('[data-confirm-delete]')) {\n        if (!pendingDelete) return;\n        const deletedName = pendingDelete.dataset.name;\n        const wasSelected = pendingDelete.dataset.selected === 'true';\n        pendingDelete.remove();\n        pendingDelete = null;\n        updateOrder();\n        if (wasSelected) {\n          const first = getRows()[0];\n          if (first) updateSelection(first);\n        }\n        closeDialog(deleteDialog);\n        setFeedback(`${deletedName} deleted from local profiles.`, 'good');\n      }\n    });\n\n    root.querySelectorAll('[data-disclosure-trigger]').forEach((trigger) => {\n      trigger.addEventListener('click', () => {\n        const card = trigger.closest('[data-disclosure]');\n        const open = card.dataset.open !== 'true';\n        card.dataset.open = String(open);\n        trigger.setAttribute('aria-expanded', String(open));\n        const panel = document.getElementById(trigger.getAttribute('aria-controls'));\n        if (panel) {\n          panel.hidden = !open;\n          panel.setAttribute('aria-hidden', String(!open));\n        }\n      });\n    });\n\n    rowsContainer.addEventListener('dragstart', (event) => {\n      const handle = event.target.closest('[data-drag-handle]');\n      if (!handle) return;\n      draggedRow = handle.closest('[data-profile-row]');\n      draggedRow.classList.add('is-dragging');\n      event.dataTransfer.effectAllowed = 'move';\n    });\n\n    rowsContainer.addEventListener('dragover', (event) => {\n      if (!draggedRow) return;\n      const target = event.target.closest('[data-profile-row]');\n      if (!target || target === draggedRow) return;\n      event.preventDefault();\n      const rect = target.getBoundingClientRect();\n      const after = event.clientY > rect.top + rect.height / 2;\n      rowsContainer.insertBefore(draggedRow, after ? target.nextSibling : target);\n      updateOrder();\n    });\n\n    rowsContainer.addEventListener('dragend', () => {\n      if (draggedRow) draggedRow.classList.remove('is-dragging');\n      draggedRow = null;\n      setFeedback('Profile order updated.', 'good');\n    });\n\n    root.querySelector('[data-add-form]').addEventListener('submit', (event) => {\n      event.preventDefault();\n      const nameInput = document.getElementById('new-profile-name');\n      const keyInput = document.getElementById('new-profile-key');\n      const error = addDialog.querySelector('[data-add-error]');\n      const name = nameInput.value.trim();\n      const key = keyInput.value.trim();\n      error.textContent = '';\n      if (!name || !key) {\n        error.textContent = !name ? 'Enter a profile name.' : 'Paste a profile key or config.';\n        (name ? keyInput : nameInput).focus();\n        return;\n      }\n      const row = createRow(name, key);\n      rowsContainer.appendChild(row);\n      updateOrder();\n      nameInput.value = '';\n      keyInput.value = '';\n      closeDialog(addDialog);\n      setFeedback(`${name} added to My profiles.`, 'good');\n    });\n\n    [addDialog, deleteDialog].forEach((dialog) => {\n      dialog.addEventListener('click', (event) => {\n        if (event.target === dialog) closeDialog(dialog);\n      });\n    });\n\n    document.addEventListener('click', (event) => {\n      if (!event.target.closest('#managed-profiles .more-cell') && !event.target.closest('#managed-profiles [data-run-menu-toggle]') && !event.target.closest('#managed-profiles [data-run-menu]')) closeMenus();\n    });\n\n    document.addEventListener('keydown', (event) => {\n      if (event.key !== 'Escape') return;\n      if (!addDialog.hidden) closeDialog(addDialog);\n      else if (!deleteDialog.hidden) closeDialog(deleteDialog);\n      else closeMenus();\n    });\n\n    updateOrder();\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-09-03T06:19:26.744966+00:00",
      "modified": "2026-09-03T06:21:17.278573+00:00",
      "id": "var_3ecbf34427b1"
    }
  },
  "comments": [],
  "nextCommentNumber": 1
}