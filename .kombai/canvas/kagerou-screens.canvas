bel=\"\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2-1-3-4-1-1\" data-name=\"select server profile label\" data-reason=\"text content updated between 'Select' and 'Selected' by script\">\n                                            Select\n                                        </span>\n                                    </button>\n                                </span>\n                            </div>\n                            <div class=\"profile-grid profile-row grid min-h-[58px] items-center px-5\" data-kid=\"1-2-1-2-2-2-1-4\" data-profile-row=\"\" data-selected=\"false\" role=\"row\" tabindex=\"0\">\n                                <span class=\"server-name text-[13px] text-[var(--body-copy)]\" data-kid=\"1-2-1-2-2-2-1-4-1\" role=\"cell\">\n                                    London 01\n                                </span>\n                                <span data-kid=\"1-2-1-2-2-2-1-4-2\" role=\"cell\">\n                                    <span class=\"inline-flex rounded-[6px] bg-[var(--raised)] px-2 py-1 text-[11px] leading-4 text-[var(--body-copy)]\" data-kid=\"1-2-1-2-2-2-1-4-2-1\">\n                                        Shadowsocks\n                                    </span>\n                                </span>\n                                <span class=\"flex items-center gap-2 text-[12px] tabular-nums text-[var(--body-copy)]\" data-kid=\"1-2-1-2-2-2-1-4-3\" role=\"cell\">\n                                    <span aria-hidden=\"true\" class=\"status-dot bg-[var(--good)]\" data-kid=\"1-2-1-2-2-2-1-4-3-1\" data-name=\"server status dot indicator\">\n                                    </span>\n                                    81 ms\n                                </span>\n                                <span class=\"flex justify-end\" data-kid=\"1-2-1-2-2-2-1-4-4\" role=\"cell\">\n                                    <button aria-pressed=\"false\" class=\"select-action inline-flex min-w-[82px] items-center justify-center rounded-[7px] px-3 py-1.5 text-[11px] font-medium transition-colors duration-150\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2-1-4-4-1\" data-name=\"select server profile button\" data-reason=\"aria-pressed and content updated by selection script\" data-select=\"\" type=\"button\">\n                                        <span data-action-label=\"\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2-1-4-4-1-1\" data-name=\"select server profile label\" data-reason=\"text content updated between 'Select' and 'Selected' by script\">\n                                            Select\n                                        </span>\n                                    </button>\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n            </div>\n        </div>\n    </main>\n</div>\n<script>\n    (() => {\n    const root = document.getElementById('profiles-app');\n    const collapse = document.getElementById('collapse-sidebar');\n\n    collapse.addEventListener('click', () => {\n      const collapsed = root.classList.toggle('is-collapsed');\n      collapse.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');\n    });\n\n    root.querySelectorAll('[data-disclosure]').forEach((disclosure) => {\n      const trigger = disclosure.querySelector('[data-disclosure-trigger]');\n      const panel = disclosure.querySelector('.disclosure-panel');\n      const chevron = disclosure.querySelector('.disclosure-chevron');\n      trigger.addEventListener('click', () => {\n        const open = disclosure.dataset.open !== 'true';\n        disclosure.dataset.open = String(open);\n        trigger.setAttribute('aria-expanded', String(open));\n        panel.setAttribute('aria-hidden', String(!open));\n        if (open) {\n          panel.removeAttribute('inert');\n        } else {\n          panel.setAttribute('inert', '');\n        }\n        chevron.classList.toggle('ti-chevron-down', open);\n        chevron.classList.toggle('ti-chevron-right', !open);\n      });\n    });\n\n    const setSelection = (row, selected) => {\n      row.dataset.selected = String(selected);\n      const button = row.querySelector('[data-select]');\n      const label = row.querySelector('[data-action-label]');\n      button.setAttribute('aria-pressed', String(selected));\n      label.textContent = selected ? 'Selected' : 'Select';\n      const oldIcon = button.querySelector('.selection-check');\n      if (selected && !oldIcon) {\n        const iconWrap = document.createElement('span');\n        iconWrap.className = 'selection-check flex h-4 w-4 items-center justify-center text-[14px]';\n        iconWrap.innerHTML = '<i class=\"ti ti-check\" aria-hidden=\"true\"></i>';\n        button.insertBefore(iconWrap, label);\n      }\n      if (!selected && oldIcon) oldIcon.remove();\n      button.classList.toggle('font-semibold', selected);\n      button.classList.toggle('font-medium', !selected);\n    };\n\n    root.querySelectorAll('[data-select]').forEach((button) => {\n      button.addEventListener('click', (event) => {\n        event.stopPropagation();\n        const row = button.closest('[data-profile-row]');\n        if (!row || row.dataset.selected === 'true') return;\n        root.querySelectorAll('[data-profile-row]').forEach((candidate) => setSelection(candidate, candidate === row));\n      });\n    });\n\n    root.querySelectorAll('[data-profile-row]').forEach((row) => {\n      row.addEventListener('click', (event) => {\n        if (!event.target.closest('button') && row.dataset.selected !== 'true') {\n          root.querySelectorAll('[data-profile-row]').forEach((candidate) => setSelection(candidate, candidate === row));\n        }\n      });\n      row.addEventListener('keydown', (event) => {\n        if ((event.key === 'Enter' || event.key === ' ') && row.dataset.selected !== 'true') {\n          event.preventDefault();\n          root.querySelectorAll('[data-profile-row]').forEach((candidate) => setSelection(candidate, candidate === row));\n        }\n      });\n    });\n  })();\n</script>\n",
