                       </span>\n                    </div>\n                    <div class=\"log-row grid grid-cols-[186px_54px_minmax(0,1fr)] items-baseline gap-x-4 text-[13px] leading-[1.55]\" data-dynamic=\"true\" data-kid=\"1-2-3-1-1-30\" data-name=\"log row container\" data-reason=\"visibility toggled by search filter\">\n                        <span class=\"whitespace-nowrap text-[var(--quiet)]\" data-kid=\"1-2-3-1-1-30-1\">\n                            2026-09-02 19:17:32.107\n                        </span>\n                        <span class=\"font-medium text-[#aaa2bd]\" data-kid=\"1-2-3-1-1-30-2\">\n                            INFO\n                        </span>\n                        <span class=\"log-message min-w-0 break-words text-[var(--body)]\" data-dynamic=\"true\" data-kid=\"1-2-3-1-1-30-3\" data-name=\"log message text\" data-reason=\"innerHTML replaced to highlight search matches\">\n                            session counters updated: ↓ 184.2 MB · ↑ 12.8 MB\n                        </span>\n                    </div>\n                </div>\n                <div aria-live=\"polite\" class=\"flex h-full min-h-[240px] items-center justify-center text-center\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2\" data-name=\"no-results message container\" data-reason=\"visibility toggled by search filter\" hidden=\"\" id=\"no-results\">\n                    <div data-kid=\"1-2-3-1-2-1\">\n                        <i class=\"ti ti-search-off text-[24px] text-[var(--quiet)]\" data-kid=\"1-2-3-1-2-1-1\">\n                        </i>\n                        <p class=\"mt-3 text-[13px] text-[var(--body)]\" data-kid=\"1-2-3-1-2-1-2\">\n                            No logs match this search.\n                        </p>\n                        <p class=\"mt-1 text-[12px] text-[var(--muted)]\" data-kid=\"1-2-3-1-2-1-3\">\n                            Try a different keyword or clear the search.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <footer class=\"mt-3 flex h-8 shrink-0 items-center border-t border-white/[0.06] pt-2 text-[12px] text-[var(--muted)]\" data-kid=\"1-2-3-2\">\n                <span class=\"flex items-center gap-2\" data-kid=\"1-2-3-2-1\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[var(--good)]\" data-kid=\"1-2-3-2-1-1\">\n                    </span>\n                    Connected • live output\n                </span>\n                <span class=\"ml-auto\" data-kid=\"1-2-3-2-2\">\n                    Scroll to inspect earlier events\n                </span>\n            </footer>\n        </section>\n    </main>\n</div>\n<script>\n    (() => {\n    const input = document.getElementById('log-search');\n    const clear = document.getElementById('clear-search');\n    const list = document.getElementById('log-list');\n    const empty = document.getElementById('no-results');\n    const count = document.getElementById('entry-count');\n    if (!input || !clear || !list || !empty || !count) return;\n\n    const rows = Array.from(list.querySelectorAll('.log-row'));\n    rows.forEach((row) => {\n      const message = row.querySelector('.log-message');\n      row.dataset.plainMessage = message.textContent;\n      row.dataset.initialMessage = message.innerHTML;\n    });\n\n    const escapeHtml = (value) => value.replace(/[&<>'\"]/g, (character) => ({\n      '&': '&amp;', '<': '&lt;', '>': '&gt;', \"'\": '&#39;', '\"': '&quot;'\n    }[character]));\n\n    const render = (rawQuery) => {\n      const query = rawQuery.trim().toLowerCase();\n      let visible = 0;\n      rows.forEach((row) => {\n        const message = row.querySelector('.log-message');\n        const plain = row.dataset.plainMessage;\n        const matches = !query || plain.toLowerCase().includes(query);\n        row.style.display = matches ? 'grid' : 'none';\n        if (matches) visible += 1;\n        if (!query) {\n          message.innerHTML = row.dataset.initialMessage;\n        } else if (matches) {\n          const expression = new RegExp(query.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&'), 'ig');\n          message.innerHTML = escapeHtml(plain).replace(expression, (match) => '<mark class=\"log-match\">' + match + '</mark>');\n        }\n      });\n      empty.hidden = visible !== 0;\n      count.textContent = query ? visible + (visible === 1 ? ' matching entry' : ' matching entries') : rows.length + ' entries';\n    };\n\n    input.addEventListener('input', () => render(input.value));\n    input.addEventListener('keydown', (event) => {\n      if (event.key === 'Escape') {\n        input.value = '';\n        render('');\n      }\n    });\n    clear.addEventListener('click', () => {\n      input.value = '';\n      render('');\n      input.focus();\n    });\n    render('');\n  })();\n</script>\n",
