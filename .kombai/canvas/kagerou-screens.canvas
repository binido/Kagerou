xt-[var(--muted)]\" data-kid=\"1-2-1-2-2-2-4\">\n                            <i aria-hidden=\"true\" class=\"ti ti-lock text-[var(--lavender)]\" data-kid=\"1-2-1-2-2-2-4-1\">\n                            </i>\n                            Subscription profiles stay with this source. Rename or refresh the source to update them.\n                        </div>\n                    </div>\n                </section>\n                <section class=\"group-card overflow-visible rounded-[10px] border border-[var(--hairline)] bg-[var(--surface)]\" data-group-card=\"\" data-kid=\"1-2-1-2-3\" data-name=\"travel keys group card\" data-open=\"false\">\n                    <div class=\"group-header flex min-h-[74px] items-center justify-between gap-5 border-b border-[var(--hairline)] px-5\" data-kid=\"1-2-1-2-3-1\">\n                        <button aria-expanded=\"false\" class=\"group-trigger flex min-w-0 flex-1 items-center gap-3 rounded-[8px] py-2 text-left\" data-group-trigger=\"\" data-kid=\"1-2-1-2-3-1-1\" type=\"button\">\n                            <span class=\"flex size-6 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-2-1-2-3-1-1-1\">\n                                <i aria-hidden=\"true\" class=\"group-chevron ti ti-chevron-down\" data-kid=\"1-2-1-2-3-1-1-1-1\">\n                                </i>\n                            </span>\n                            <span class=\"min-w-0\" data-kid=\"1-2-1-2-3-1-1-2\">\n                                <span class=\"block truncate font-['Inter_Tight'] text-[17px] font-semibold\" data-kid=\"1-2-1-2-3-1-1-2-1\">\n                                    Travel keys\n                                </span>\n                                <span class=\"mt-1 block text-[12px] text-[var(--muted)]\" data-kid=\"1-2-1-2-3-1-1-2-2\">\n                                    1 profile · local group\n                                </span>\n                            </span>\n                        </button>\n                        <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-2-1-2-3-1-2\">\n                            <span class=\"flex items-center gap-2 font-['IBM_Plex_Mono'] text-[10px] uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-2-3-1-2-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-folder\" data-kid=\"1-2-1-2-3-1-2-1-1\">\n                                </i>\n                                Custom group\n                            </span>\n                            <button aria-label=\"More actions for Travel keys\" class=\"icon-button flex size-9 items-center justify-center rounded-[8px] text-[17px] text-[var(--muted)]\" data-kid=\"1-2-1-2-3-1-2-2\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-dots\" data-kid=\"1-2-1-2-3-1-2-2-1\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"group-panel\" data-kid=\"1-2-1-2-3-2\">\n                    </div>\n                </section>\n                <section class=\"group-card overflow-visible rounded-[10px] border border-[var(--hairline)] bg-[var(--surface)]\" data-group-card=\"\" data-kid=\"1-2-1-2-4\" data-name=\"work europe group card\" data-open=\"false\">\n                    <div class=\"group-header flex min-h-[74px] items-center justify-between gap-5 border-b border-[var(--hairline)] px-5\" data-kid=\"1-2-1-2-4-1\">\n                        <button aria-expanded=\"false\" class=\"group-trigger flex min-w-0 flex-1 items-center gap-3 rounded-[8px] py-2 text-left\" data-group-trigger=\"\" data-kid=\"1-2-1-2-4-1-1\" type=\"button\">\n                            <span class=\"flex size-6 items-center justify-center text-[18px] text-[var(--muted)]\" data-kid=\"1-2-1-2-4-1-1-1\">\n                                <i aria-hidden=\"true\" class=\"group-chevron ti ti-chevron-down\" data-kid=\"1-2-1-2-4-1-1-1-1\">\n                                </i>\n                            </span>\n                            <span class=\"min-w-0\" data-kid=\"1-2-1-2-4-1-1-2\">\n                                <span class=\"block truncate font-['Inter_Tight'] text-[17px] font-semibold\" data-kid=\"1-2-1-2-4-1-1-2-1\">\n                                    Work / Europe\n                                </span>\n                                <span class=\"mt-1 block text-[12px] text-[var(--muted)]\" data-kid=\"1-2-1-2-4-1-1-2-2\">\n                                    3 profiles\n                                </span>\n                            </span>\n                        </button>\n                        <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-2-1-2-4-1-2\">\n                            <span class=\"inline-flex items-center gap-1.5 rounded-[7px] border border-[rgba(112,182,142,.22)] px-2.5 py-2 font-['IBM_Plex_Mono'] text-[10px] text-[var(--good)]\" data-kid=\"1-2-1-2-4-1-2-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-lock\" data-kid=\"1-2-1-2-4-1-2-1-1\">\n                                </i>\n                                Managed on Sources\n                            </span>\n                            <button aria-label=\"More actions for Work / Europe\" class=\"icon-button flex size-9 items-center justify-center rounded-[8px] text-[17px] text-[var(--muted)]\" data-kid=\"1-2-1-2-4-1-2-2\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-dots\" data-kid=\"1-2-1-2-4-1-2-2-1\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"group-panel\" data-kid=\"1-2-1-2-4-2\">\n                    </div>\n                </section>\n            </div>\n            <p aria-live=\"polite\" class=\"mt-4 min-h-[17px] text-[11px] text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"1-2-1-3\" data-name=\"status feedback message\" data-reason=\"live status text injected by script\">\n            </p>\n        </div>\n    </main>\n</div>\n<script>\n    (() => { const root=document.getElementById('profiles-primary'); if(!root)return; root.querySelectorAll('[data-group-trigger]').forEach((trigger)=>trigger.addEventListener('click',()=>{const card=trigger.closest('[data-group-card]');const open=card.dataset.open!=='true';card.dataset.open=String(open);trigger.setAttribute('aria-expanded',String(open));})); const collapse=root.querySelector('[data-collapse-sidebar]'); collapse?.addEventListener('click',()=>{const collapsed=root.classList.toggle('is-collapsed');collapse.setAttribute('aria-expanded',String(!collapsed));collapse.setAttribute('aria-label',collapsed?'Expand sidebar':'Collapse sidebar');});})();\n</script>\n",
